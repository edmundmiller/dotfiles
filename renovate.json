{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/)flake\\.nix$/"]
  },
  "timezone": "America/Chicago",
  "schedule": ["* 4-8 * * 1"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 4-8 * * 1"],
    "automerge": false
  },
  "postUpgradeTasks": {
    "commands": ["nix run --accept-flake-config .#renovate-update-nix-hashes"],
    "fileFilters": [
      "packages/**/*.nix",
      "packages/*.nix",
      "overlays/herdr/default.nix",
      "overlays/herdr/package-harness.json",
      "flake.nix",
      "flake.lock"
    ],
    "executionMode": "branch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update repo-local Nix packages in packages/ that fetch GitHub tags/releases via fetchFromGitHub.",
      "managerFilePatterns": ["/(^|/)packages/.*\\.nix$/"],
      "matchStrings": [
        "version\\s*=\\s*\"(?<currentValue>[^\"]+)\";[\\s\\S]*?src\\s*=\\s*fetchFromGitHub\\s*\\{[\\s\\S]*?owner\\s*=\\s*\"(?<owner>[^\"]+)\";[\\s\\S]*?repo\\s*=\\s*\"(?<repo>[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{owner}}}/{{{repo}}}",
      "depNameTemplate": "{{{owner}}}/{{{repo}}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Keep the patched Herdr overlay on the latest upstream GitHub release tag.",
      "managerFilePatterns": ["/(^|/)overlays/herdr/default\\.nix$/"],
      "matchStrings": [
        "owner\\s*=\\s*\"(?<owner>ogulcancelik)\";[\\s\\S]*?repo\\s*=\\s*\"(?<repo>herdr)\";[\\s\\S]*?rev\\s*=\\s*\"(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{owner}}}/{{{repo}}}",
      "depNameTemplate": "herdr",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Keep Herdr's fresh-source package harness aligned with its overlay.",
      "managerFilePatterns": ["/(^|/)overlays/herdr/package-harness\\.json$/"],
      "matchStrings": ["\"ref\"\\s*:\\s*\"(?<currentValue>v[^\"]+)\""],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "ogulcancelik/herdr",
      "depNameTemplate": "herdr",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Keep Hunk's flake input release tag current.",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "hunk\\s*=\\s*\\{[\\s\\S]*?url\\s*=\\s*\"github:modem-dev/hunk/(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "modem-dev/hunk",
      "depNameTemplate": "hunk",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Keep Hunk's fresh-source package harness aligned with its flake input.",
      "managerFilePatterns": ["/(^|/)overlays/hunk/package-harness\\.json$/"],
      "matchStrings": ["\"ref\"\\s*:\\s*\"(?<currentValue>v[^\"]+)\""],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "modem-dev/hunk",
      "depNameTemplate": "hunk",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Skip Gemfile and Poetry files; they are not the intended update surface.",
      "matchManagers": ["bundler", "poetry"],
      "enabled": false
    },
    {
      "description": "The Actions PAT cannot ls-remote these private flake inputs. Bump them with hey upgrade when needed.",
      "matchManagers": ["nix"],
      "matchPackageNames": [
        "agents-workspace",
        "tnote",
        "https://github.com/edmundmiller/agents-workspace",
        "https://github.com/edmundmiller/tnote"
      ],
      "enabled": false
    },
    {
      "description": "Unversioned flake pins update through Monday lockFileMaintenance instead of per-input digest PRs.",
      "matchManagers": ["nix"],
      "matchDatasources": ["git-refs"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Group versioned Nix flake inputs sharing flake.lock. Lock maintenance stays on its own Monday branch.",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs",
      "labels": ["dependencies", "nix"]
    },
    {
      "description": "Keep non-major JavaScript runtime and development updates together per manifest/lockfile owner.",
      "matchManagers": ["npm", "bun"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "{{packageFileDir}} dependencies",
      "groupSlug": "{{packageFileDir}} dependencies",
      "labels": ["dependencies", "javascript"]
    },
    {
      "description": "Pi packages share the root Bun workspace lockfile, including packages with legacy npm locks.",
      "matchManagers": ["npm", "bun"],
      "matchFileNames": ["packages/pi-packages/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "Pi workspace dependencies",
      "groupSlug": "pi-workspace-dependencies"
    },
    {
      "description": "Group non-major GitHub Actions and pin/digest refreshes.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "labels": ["dependencies", "github_actions"]
    },
    {
      "description": "Group only repo-local Nix package patches so hash refresh stays small enough to finish.",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "repo-local Nix package patches",
      "groupSlug": "repo-local-nix-package-patches",
      "labels": ["dependencies", "nix", "packages"]
    },
    {
      "description": "Keep major updates on the Dependency Dashboard until explicitly approved.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Keep Herdr patch validation and repair separate from candidate admission.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["herdr"],
      "groupName": "Herdr",
      "groupSlug": "herdr",
      "labels": ["dependencies", "nix", "packages", "flue-review"],
      "automerge": false
    },
    {
      "description": "Keep Hunk patch validation and repair separate from candidate admission.",
      "matchManagers": ["nix", "custom.regex"],
      "matchDepNames": ["hunk"],
      "groupName": "Hunk",
      "groupSlug": "hunk",
      "labels": ["dependencies", "nix", "packages", "flue-review"],
      "automerge": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "prCreation": "immediate",
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "automerge": false,
  "platformAutomerge": false,
  "pruneStaleBranches": false,
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 4
}
