index 0000000..81f01fd
--- /dev/null
+++ b/test/reviewBox.test.ts
@@ -0,0 +1,93 @@
+import { describe, expect, test } from "bun:test"
+import { Effect, Layer, Schema } from "effect"
+import type { PullRequestItem } from "../src/domain.js"
+import { CommandRunner, type CommandResult, type RunOptions } from "../src/services/CommandRunner.js"
+import { ReviewBox } from "../src/services/ReviewBox.js"
+
+const pullRequest: PullRequestItem = {
+	repository: "owner/repo",
+	author: "kit",
+	headRefOid: "abc123",
+	headRefName: "feature/review-box",
+	number: 42,
+	title: "Review UX",
+	body: "",
+	labels: [],
+	additions: 1,
+	deletions: 1,
+	changedFiles: 2,
+	state: "open",
+	reviewStatus: "review",
+	checkStatus: "passing",
+	checkSummary: "1/1",
+	checks: [],
+	autoMergeEnabled: false,
+	detailLoaded: true,
+	createdAt: new Date("2026-01-01T00:00:00Z"),
+	closedAt: null,
+	url: "https://github.com/owner/repo/pull/42",
+}
+
+interface RecordedCall {
+	readonly command: string
+	readonly args: readonly string[]
+	readonly options?: RunOptions
+}
+
+const fakeCommandRunner = (result: CommandResult, calls: RecordedCall[]) =>
+	Layer.succeed(
+		CommandRunner,
+		CommandRunner.of({
+			run: (command, args, options) => {
+				calls.push({ command, args: [...args], ...(options ? { options } : {}) })
+				return Effect.succeed(result)
+			},
+			runSchema: <S extends Schema.Top>() => Effect.die("unused") as Effect.Effect<S["Type"], never, S["DecodingServices"]>,
+		}),
+	)
+
+const runWith = <A>(effect: Effect.Effect<A, unknown, ReviewBox>, layer: Layer.Layer<ReviewBox>) => Effect.runPromise(effect.pipe(Effect.provide(layer)) as Effect.Effect<A>)
+
+describe("ReviewBox", () => {
+	test("passes the selected PR contract on stdin and returns bridge status", async () => {
+		const calls: RecordedCall[] = []
+		const response = {
+			status: "created",
+			workspaceId: "w42",
+			worktreePath: "/repo/.pi/worktrees/pr-42-feature-review-box",
+			headRefOid: "abc123",
+		}
+		const layer = ReviewBox.layerNoDeps.pipe(Layer.provide(fakeCommandRunner({ stdout: JSON.stringify(response), stderr: "", exitCode: 0 }, calls)))
+
+		const result = await runWith(
+			ReviewBox.use((service) => service.promote("/bin/review-box", pullRequest)),
+			layer,
+		)
+
+		expect(result).toEqual(response)
+		expect(calls).toHaveLength(1)
+		expect(calls[0]!.command).toBe("/bin/review-box")
+		expect(calls[0]!.args).toEqual([])
+		expect(JSON.parse(calls[0]!.options?.stdin ?? "")).toEqual({
+			repository: "owner/repo",
+			number: 42,
+			headRefOid: "abc123",
+			headRefName: "feature/review-box",
+			title: "Review UX",
+			url: "https://github.com/owner/repo/pull/42",
+		})
+	})
+
+	test.each(["", "not json", '{"status":"unknown"}'])("rejects invalid success output: %s", async (stdout) => {
+		const layer = ReviewBox.layerNoDeps.pipe(Layer.provide(fakeCommandRunner({ stdout, stderr: "", exitCode: 0 }, [])))
+
+		await expect(
+			runWith(
+				ReviewBox.use((service) => service.promote("/bin/review-box", pullRequest)),
+				layer,
+			),
+		).rejects.toMatchObject({
+			detail: "invalid review-box output",
+		})
+	})
+})
