@@ -0,0 +1,77 @@
+import { Context, Effect, Layer, Schema } from "effect"
+import type { PullRequestItem } from "../domain.js"
+import { CommandRunner, type CommandError } from "./CommandRunner.js"
+
+export interface ReviewBoxResult {
+	readonly status: "created" | "resumed" | "restored" | "refreshed"
+	readonly workspaceId: string
+	readonly worktreePath: string
+	readonly headRefOid: string
+}
+
+const reviewBoxStatuses: Record<ReviewBoxResult["status"], true> = {
+	created: true,
+	resumed: true,
+	restored: true,
+	refreshed: true,
+}
+
+export class ReviewBoxOutputError extends Schema.TaggedErrorClass<ReviewBoxOutputError>()("ReviewBoxOutputError", {
+	detail: Schema.String,
+	cause: Schema.Defect,
+}) {}
+
+const parseResult = (stdout: string): Effect.Effect<ReviewBoxResult, ReviewBoxOutputError> =>
+	Effect.try({
+		try: () => {
+			const value = JSON.parse(stdout) as unknown
+			if (
+				typeof value !== "object" ||
+				value === null ||
+				!("status" in value) ||
+				typeof value.status !== "string" ||
+				!(value.status in reviewBoxStatuses) ||
+				!("workspaceId" in value) ||
+				typeof value.workspaceId !== "string" ||
+				!("worktreePath" in value) ||
+				typeof value.worktreePath !== "string" ||
+				!("headRefOid" in value) ||
+				typeof value.headRefOid !== "string"
+			) {
+				throw new Error("unexpected response shape")
+			}
+			return value as ReviewBoxResult
+		},
+		catch: (cause) => new ReviewBoxOutputError({ detail: "invalid review-box output", cause }),
+	})
+
+export class ReviewBox extends Context.Service<
+	ReviewBox,
+	{
+		readonly promote: (commandPath: string, pullRequest: PullRequestItem) => Effect.Effect<ReviewBoxResult, CommandError | ReviewBoxOutputError>
+	}
+>()("ghui/ReviewBox") {
+	static readonly layerNoDeps = Layer.effect(
+		ReviewBox,
+		Effect.gen(function* () {
+			const command = yield* CommandRunner
+
+			const promote = Effect.fn("ReviewBox.promote")(function* (commandPath: string, pullRequest: PullRequestItem) {
+				const input = {
+					repository: pullRequest.repository,
+					number: pullRequest.number,
+					headRefOid: pullRequest.headRefOid,
+					headRefName: pullRequest.headRefName,
+					title: pullRequest.title,
+					url: pullRequest.url,
+				}
+				const result = yield* command.run(commandPath, [], { stdin: JSON.stringify(input) })
+				return yield* parseResult(result.stdout)
+			})
+
+			return ReviewBox.of({ promote })
+		}),
+	)
+
+	static readonly layer = ReviewBox.layerNoDeps.pipe(Layer.provide(CommandRunner.layer))
+}
