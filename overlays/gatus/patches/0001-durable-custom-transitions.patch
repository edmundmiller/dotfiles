diff --git a/watchdog/durable_alerting.go b/watchdog/durable_alerting.go
new file mode 100644
index 0000000..626ec7e
--- /dev/null
+++ b/watchdog/durable_alerting.go
@@ -0,0 +1,111 @@
+package watchdog
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/TwiN/gatus/v5/alerting"
+	"github.com/TwiN/gatus/v5/alerting/alert"
+	"github.com/TwiN/gatus/v5/config/endpoint"
+	"github.com/TwiN/gatus/v5/storage/store"
+	"github.com/TwiN/logr"
+)
+
+// This opt-in path is for state-only custom payloads and idempotent receivers.
+// It deliberately does not replay result details, reminders or other providers.
+const durableQueueLimit = 1000
+
+type durableAlertStore interface {
+	LoadAlertDeliveryState(endpointKey, checksum string) ([]byte, error)
+	SaveAlertDeliveryState(endpointKey, checksum string, state []byte) error
+}
+
+type durableAlertState struct {
+	Failures  int
+	Successes int
+	Triggered bool
+	Pending   []bool // false = trigger, true = recovery, in observed order
+}
+
+func handleDurableAlert(ep *endpoint.Endpoint, a *alert.Alert, result *endpoint.Result, cfg *alerting.Config) error {
+	db, ok := store.Get().(durableAlertStore)
+	if !ok {
+		return errors.New("durable-delivery requires SQLite storage")
+	}
+	data, err := db.LoadAlertDeliveryState(ep.Key(), a.Checksum())
+	if err != nil {
+		return fmt.Errorf("load durable alert outbox: %w", err)
+	}
+	state := durableAlertState{}
+	if len(data) > 0 {
+		if err := json.Unmarshal(data, &state); err != nil {
+			return fmt.Errorf("decode durable alert outbox: %w", err)
+		}
+	}
+	save := func() error {
+		data, err := json.Marshal(state)
+		if err != nil {
+			return err
+		}
+		return db.SaveAlertDeliveryState(ep.Key(), a.Checksum(), data)
+	}
+	sendHead := func() error {
+		if len(state.Pending) == 0 {
+			return nil
+		}
+		provider := cfg.GetAlertingProviderByAlertType(a.Type)
+		if provider == nil {
+			return errors.New("durable alert provider is not configured")
+		}
+		if err := provider.Send(ep, a, result, state.Pending[0]); err != nil {
+			// Keep the head, including rejected recoveries, regardless of the next probe.
+			logr.Errorf("[watchdog.durableAlert] Receiver rejected pending transition for endpoint=%s route=%s", ep.Key(), a.GetDescription())
+			return nil
+		}
+		state.Pending = state.Pending[1:]
+		return save() // Never deliver a later transition before this cursor is durable.
+	}
+	// At most one delivery attempt per route per probe. Try old work first so a
+	// previously full queue can drain when the receiver becomes available again.
+	hadPending := len(state.Pending) > 0
+	if hadPending {
+		if err := sendHead(); err != nil {
+			return err
+		}
+	}
+	transition := false
+	resolved := false
+	if result.Success {
+		state.Failures = 0
+		if state.Successes < a.SuccessThreshold {
+			state.Successes++
+		}
+		if state.Triggered && state.Successes >= a.SuccessThreshold {
+			transition, resolved = true, true
+			state.Triggered = false
+		}
+	} else {
+		state.Successes = 0
+		if state.Failures < a.FailureThreshold {
+			state.Failures++
+		}
+		if !state.Triggered && state.Failures >= a.FailureThreshold {
+			transition = true
+			state.Triggered = true
+		}
+	}
+	if transition {
+		if len(state.Pending) >= durableQueueLimit {
+			return errors.New("durable alert outbox full; preserve database and reconcile receiver before restarting")
+		}
+		state.Pending = append(state.Pending, resolved)
+	}
+	if err := save(); err != nil { // Commit detected transitions before any attempt to send them.
+		return fmt.Errorf("persist durable alert outbox: %w", err)
+	}
+	if !hadPending {
+		return sendHead()
+	}
+	return nil
+}
