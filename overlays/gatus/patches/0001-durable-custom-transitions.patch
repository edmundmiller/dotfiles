diff --git a/storage/store/sql/alert_delivery.go b/storage/store/sql/alert_delivery.go
new file mode 100644
index 0000000..5a4a68d
--- /dev/null
+++ b/storage/store/sql/alert_delivery.go
@@ -0,0 +1,40 @@
+package sql
+
+import (
+	"database/sql"
+	"errors"
+)
+
+// LoadAlertDeliveryState keeps producer outboxes separate from upstream's
+// triggered-alert cleanup: a pending recovery must survive endpoint recovery.
+func (s *Store) LoadAlertDeliveryState(endpointKey, checksum string) ([]byte, error) {
+	if s.driver != "sqlite" {
+		return nil, errors.New("durable-delivery requires SQLite storage")
+	}
+	// NORMAL can lose the most recent committed cursor on power loss. Only
+	// opt-in users pay for FULL synchronization; ordinary Gatus is unchanged.
+	if _, err := s.db.Exec("PRAGMA synchronous=FULL"); err != nil {
+		return nil, err
+	}
+	if _, err := s.db.Exec(`CREATE TABLE IF NOT EXISTS alert_delivery_state (
+		endpoint_key TEXT NOT NULL,
+		alert_checksum TEXT NOT NULL,
+		state TEXT NOT NULL,
+		PRIMARY KEY (endpoint_key, alert_checksum)
+	)`); err != nil {
+		return nil, err
+	}
+	var state string
+	err := s.db.QueryRow(`SELECT state FROM alert_delivery_state WHERE endpoint_key = ? AND alert_checksum = ?`, endpointKey, checksum).Scan(&state)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	return []byte(state), err
+}
+
+// SaveAlertDeliveryState atomically commits detector state and the FIFO cursor.
+func (s *Store) SaveAlertDeliveryState(endpointKey, checksum string, state []byte) error {
+	_, err := s.db.Exec(`INSERT INTO alert_delivery_state (endpoint_key, alert_checksum, state) VALUES (?, ?, ?)
+		ON CONFLICT(endpoint_key, alert_checksum) DO UPDATE SET state = excluded.state`, endpointKey, checksum, string(state))
+	return err
+}
