diff --git a/packages/ai/test/google-ai-plan-oauth.test.ts b/packages/ai/test/google-ai-plan-oauth.test.ts
new file mode 100644
index 000000000..f4fca1590
--- /dev/null
+++ b/packages/ai/test/google-ai-plan-oauth.test.ts
@@ -0,0 +1,151 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createGoogleAiPlanOAuth } from "../src/auth/oauth/google-ai-plan.ts";
+import type { OAuthCredential } from "../src/auth/types.ts";
+
+const signal = new AbortController().signal;
+const googleAiPlanOAuth = createGoogleAiPlanOAuth({ clientId: "app-client", clientSecret: "app-secret" });
+
+async function credential(): Promise<OAuthCredential> {
+	const { privateKey } = await crypto.subtle.generateKey({ name: "ECDSA", namedCurve: "P-256" }, true, ["sign"]);
+	const { kty, crv, x, y, d } = await crypto.subtle.exportKey("jwk", privateKey);
+	return { type: "oauth", access: "old", refresh: "refresh-token", expires: 0, dpopKey: { kty, crv, x, y, d } };
+}
+
+/** The claims of the DPoP proof sent with a token request. */
+function proofClaims(init: RequestInit | undefined): { jti: string; nonce?: string; iat: number } {
+	const proof = (init?.headers as Record<string, string>).DPoP;
+	return JSON.parse(Buffer.from(proof.split(".")[1], "base64url").toString("utf8"));
+}
+
+function tokenError(error: string, headers: Record<string, string>): Response {
+	return new Response(JSON.stringify({ error }), { status: 400, headers });
+}
+
+const TOKENS = JSON.stringify({ access_token: "new", expires_in: 3599 });
+
+/** Run `login` with the user pasting a URL built from the sign-in link's `state`. */
+async function loginWithPastedUrl(buildUrl: (redirectUri: string, state: string) => string) {
+	let authUrl = "";
+	return googleAiPlanOAuth.login({
+		signal,
+		notify: (event) => {
+			if (event.type === "auth_url") authUrl = event.url;
+		},
+		prompt: async () => {
+			const params = new URL(authUrl).searchParams;
+			return buildUrl(params.get("redirect_uri")!, params.get("state")!);
+		},
+	});
+}
+
+describe("Google AI Ultra plan sign-in with a pasted URL", () => {
+	afterEach(() => {
+		vi.unstubAllGlobals();
+	});
+
+	it("rejects a URL without the sign-in's state, before exchanging the code", async () => {
+		const fetchMock = vi.fn();
+		vi.stubGlobal("fetch", fetchMock);
+
+		await expect(loginWithPastedUrl((redirectUri) => `${redirectUri}?code=4%2F0Aabc`)).rejects.toThrow(
+			"Sign-in state mismatch",
+		);
+		await expect(
+			loginWithPastedUrl((redirectUri) => `${redirectUri}?code=4%2F0Aabc&state=someone-else`),
+		).rejects.toThrow("Sign-in state mismatch");
+		expect(fetchMock).not.toHaveBeenCalled();
+	});
+
+	it("exchanges the decoded code from a matching URL with the app's client", async () => {
+		let sent = new URLSearchParams();
+		vi.stubGlobal("fetch", async (_url: unknown, init?: RequestInit) => {
+			sent = new URLSearchParams(String(init?.body));
+			return tokenError("invalid_grant", {});
+		});
+
+		await expect(
+			loginWithPastedUrl((redirectUri, state) => `${redirectUri}?state=${state}&code=4%2F0Aabc`),
+		).rejects.toThrow("Google sign-in failed: 400 invalid_grant");
+		expect(sent.get("code")).toBe("4/0Aabc");
+		expect(sent.get("client_id")).toBe("app-client");
+		expect(sent.get("client_secret")).toBe("app-secret");
+	});
+});
+
+describe("Google AI Ultra plan token refresh", () => {
+	afterEach(() => {
+		vi.unstubAllGlobals();
+	});
+
+	it("retries once with Google's time when the local clock is ahead", async () => {
+		const serverDate = "Wed, 25 Nov 2026 12:00:00 GMT";
+		const proofs: ReturnType<typeof proofClaims>[] = [];
+		const responses = [
+			tokenError("invalid_dpop_proof", { date: serverDate }),
+			new Response(TOKENS, { headers: { "dpop-nonce": "n1" } }),
+		];
+		vi.stubGlobal("fetch", async (_url: unknown, init?: RequestInit) => {
+			proofs.push(proofClaims(init));
+			return responses.shift()!;
+		});
+
+		const next = await googleAiPlanOAuth.refresh(await credential(), signal);
+
+		expect(proofs).toHaveLength(2);
+		expect(proofs[1].iat).toBe(Date.parse(serverDate) / 1000);
+		expect(proofs[1].jti).not.toBe(proofs[0].jti);
+		expect(next.access).toBe("new");
+		expect(next.dpopNonce).toBe("n1");
+	});
+
+	it("handles a nonce rejection and a clock rejection in one refresh", async () => {
+		const serverDate = "Wed, 25 Nov 2026 12:00:00 GMT";
+		const proofs: ReturnType<typeof proofClaims>[] = [];
+		const responses = [
+			tokenError("use_dpop_nonce", { "dpop-nonce": "n1", date: serverDate }),
+			tokenError("invalid_dpop_proof", { date: serverDate }),
+			new Response(TOKENS),
+		];
+		vi.stubGlobal("fetch", async (_url: unknown, init?: RequestInit) => {
+			proofs.push(proofClaims(init));
+			return responses.shift()!;
+		});
+
+		const next = await googleAiPlanOAuth.refresh(await credential(), signal);
+
+		expect(proofs.map((p) => p.nonce)).toEqual([undefined, "n1", "n1"]);
+		expect(proofs[2].iat).toBe(Date.parse(serverDate) / 1000);
+		expect(next.access).toBe("new");
+	});
+
+	it("keeps the nonce that worked when the successful response sends none", async () => {
+		const responses = [tokenError("use_dpop_nonce", { "dpop-nonce": "n2" }), new Response(TOKENS)];
+		vi.stubGlobal("fetch", async () => responses.shift()!);
+
+		const next = await googleAiPlanOAuth.refresh({ ...(await credential()), dpopNonce: "n1" }, signal);
+
+		expect(next.dpopNonce).toBe("n2");
+	});
+
+	it.each(["invalid_grant", "unauthorized_client"])("asks to sign in again on %s", async (error) => {
+		vi.stubGlobal("fetch", async () => tokenError(error, {}));
+
+		await expect(googleAiPlanOAuth.refresh(await credential(), signal)).rejects.toThrow(
+			"Run /login to sign in again.",
+		);
+	});
+
+	it("gives up after one clock retry", async () => {
+		const serverDate = "Wed, 25 Nov 2026 12:00:00 GMT";
+		let calls = 0;
+		vi.stubGlobal("fetch", async () => {
+			calls++;
+			return tokenError("invalid_dpop_proof", { date: serverDate });
+		});
+
+		await expect(googleAiPlanOAuth.refresh(await credential(), signal)).rejects.toThrow(
+			"Google token refresh failed: 400 invalid_dpop_proof",
+		);
+		expect(calls).toBe(2);
+	});
+});
diff --git a/packages/ai/test/google-interactions-errors.test.ts b/packages/ai/test/google-interactions-errors.test.ts
new file mode 100644
index 000000000..5d0d84a4b
--- /dev/null
+++ b/packages/ai/test/google-interactions-errors.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it } from "vitest";
+import { stream } from "../src/api/google-interactions.ts";
+import { classifyGoogleInteractionsError } from "../src/api/google-interactions-errors.ts";
+import { GOOGLE_AI_PLAN_MODELS } from "../src/providers/google-ai-plan.models.ts";
+import type { FetchFunction } from "../src/types.ts";
+import { isRetryableAssistantError } from "../src/utils/retry.ts";
+import { normalizeContext } from "../src/utils/transcript.ts";
+
+const DAILY_LIMIT_BODY = JSON.stringify({
+	error: {
+		code: "too_many_requests",
+		message:
+			"You've reached today's AI Ultra limit for gemini-4-hydrogen in third-party apps. Your daily limit refreshes in 5 hours, 18 minutes. Until then, you can switch to other models.",
+	},
+});
+
+function classify(status: number, body: string, headers: Record<string, string> = {}) {
+	return classifyGoogleInteractionsError({
+		status,
+		headers: new Headers(headers),
+		body,
+		modelId: "gemini-4-hydrogen",
+	});
+}
+
+const PER_DAY_QUOTA_BODY = (quotaValue: string) =>
+	JSON.stringify({
+		error: {
+			message: "Resource exhausted.",
+			details: [
+				{
+					"@type": "type.googleapis.com/google.rpc.QuotaFailure",
+					violations: [{ quotaId: "GenerateRequestsPerDayPerUserPerModel", quotaValue }],
+				},
+			],
+		},
+	});
+
+const ZERO_LIMIT_BODY = JSON.stringify({
+	error: { message: "Rate limit exceeded for model gemini-4-argon (limit: 0 tokens per day)" },
+});
+
+describe("classifyGoogleInteractionsError", () => {
+	it("does not retry a daily-limit 429 and keeps Google's text, which already says when it resets", () => {
+		expect(classify(429, DAILY_LIMIT_BODY, { "retry-after": "19104" })).toEqual({
+			message:
+				"429 You've reached today's AI Ultra limit for gemini-4-hydrogen in third-party apps. Your daily limit refreshes in 5 hours, 18 minutes. Until then, you can switch to other models. Daily limit reached for gemini-4-hydrogen: switch to another model, or use a Gemini API key.",
+			final: true,
+		});
+	});
+
+	it("adds the reset time from Retry-After to a per-day quota violation", () => {
+		expect(classify(429, PER_DAY_QUOTA_BODY("1000000"), { "retry-after": "19104" })).toEqual({
+			message:
+				"429 Resource exhausted. Daily limit reached for gemini-4-hydrogen (resets in 5h 19m): switch to another model, or use a Gemini API key.",
+			final: true,
+		});
+		expect(classify(429, PER_DAY_QUOTA_BODY("1000000"), { "retry-after": "7199" }).message).toContain(
+			"(resets in 2h 0m)",
+		);
+	});
+
+	it("reports a daily limit of zero as a model the plan does not include", () => {
+		const hint = "gemini-4-hydrogen is not available on the Google AI Ultra plan. Choose another model.";
+		expect(classify(429, PER_DAY_QUOTA_BODY("0"))).toEqual({
+			message: `429 Resource exhausted. ${hint}`,
+			final: true,
+		});
+		expect(classify(429, ZERO_LIMIT_BODY)).toEqual({
+			message: `429 Rate limit exceeded for model gemini-4-argon (limit: 0 tokens per day) ${hint}`,
+			final: true,
+		});
+	});
+
+	it("leaves a per-minute 429 to the shared retry rules", () => {
+		const error = classify(429, JSON.stringify({ error: { message: "Too many requests." } }));
+		expect(error).toEqual({ message: "429 Too many requests.", final: false });
+	});
+
+	it("reports models outside the plan", () => {
+		const body = JSON.stringify({
+			error: {
+				message: "Model gemini-4-argon is not supported for per-user quota requests.",
+				code: "invalid_request",
+			},
+		});
+		const error = classifyGoogleInteractionsError({
+			status: 400,
+			headers: new Headers(),
+			body,
+			modelId: "gemini-4-argon",
+		});
+		expect(error.message).toBe(
+			"400 Model gemini-4-argon is not supported for per-user quota requests. gemini-4-argon is not available on the Google AI Ultra plan. Choose another model.",
+		);
+	});
+
+	it("asks to sign in again on 401 bodies sent as JSON arrays", () => {
+		const body = JSON.stringify([
+			{
+				error: { code: 401, message: "Request had invalid authentication credentials.", status: "UNAUTHENTICATED" },
+			},
+		]);
+		expect(classify(401, body).message).toBe(
+			"401 Request had invalid authentication credentials. Run /login to sign in again.",
+		);
+	});
+
+	it("tells scope, disabled-service and plan errors apart", () => {
+		const errorInfo = (reason: string) =>
+			JSON.stringify([
+				{
+					error: {
+						code: 403,
+						message: "Permission denied.",
+						details: [{ "@type": "type.googleapis.com/google.rpc.ErrorInfo", reason }],
+					},
+				},
+			]);
+		expect(classify(403, errorInfo("ACCESS_TOKEN_SCOPE_INSUFFICIENT")).message).toBe(
+			"403 Permission denied. Run /login to sign in again.",
+		);
+		expect(
+			classify(403, JSON.stringify({ error: { message: "Request had insufficient authentication scopes." } }))
+				.message,
+		).toBe("403 Request had insufficient authentication scopes. Run /login to sign in again.");
+		expect(classify(403, errorInfo("SERVICE_DISABLED")).message).toBe(
+			"403 Permission denied. The Google AI Ultra plan is currently unavailable in pi.",
+		);
+		expect(classify(403, JSON.stringify({ error: { message: "Permission denied." } })).message).toBe(
+			"403 Permission denied. Your Google account does not have an eligible Google AI Ultra plan. Upgrade at https://one.google.com/ai, or use a Gemini API key.",
+		);
+	});
+
+	it("reads the message from an SSE error frame", () => {
+		const body =
+			'event: error\ndata: {"error":{"message":"Function call is missing a thought_signature.","code":"invalid_request"},"event_type":"error"}\n\n';
+		expect(classify(400, body)).toEqual({
+			message: "400 Function call is missing a thought_signature.",
+			final: false,
+		});
+	});
+});
+
+describe("google-interactions stream errors", () => {
+	const model = GOOGLE_AI_PLAN_MODELS["gemini-4-hydrogen"];
+	const context = normalizeContext({ messages: [{ role: "user", content: "hi", timestamp: 0 }] });
+
+	async function run(responses: Response[]) {
+		let calls = 0;
+		const fetch: FetchFunction = async () => responses[calls++]!;
+		const result = await stream(model, context, {
+			headers: { Authorization: "Bearer token" },
+			fetch,
+			maxRetries: 2,
+		}).result();
+		return { result, calls };
+	}
+
+	it("does not retry a daily limit, at request or agent level", async () => {
+		const { result, calls } = await run([
+			new Response(DAILY_LIMIT_BODY, { status: 429 }),
+			new Response(DAILY_LIMIT_BODY, { status: 429 }),
+		]);
+		expect(calls).toBe(1);
+		expect(result.stopReason).toBe("error");
+		expect(result.errorMessage).toContain("Daily limit reached for gemini-4-hydrogen");
+		expect(isRetryableAssistantError(result)).toBe(false);
+	});
+
+	it("does not retry a model the plan does not include, at request or agent level", async () => {
+		const { result, calls } = await run([
+			new Response(ZERO_LIMIT_BODY, { status: 429 }),
+			new Response(ZERO_LIMIT_BODY, { status: 429 }),
+		]);
+		expect(calls).toBe(1);
+		expect(result.errorMessage).toContain("is not available on the Google AI Ultra plan");
+		expect(isRetryableAssistantError(result)).toBe(false);
+	});
+
+	it("retries a per-minute 429 and then streams the answer", async () => {
+		const events = [
+			{ event_type: "step.start", index: 0, step: { type: "model_output" } },
+			{ event_type: "step.delta", index: 0, delta: { type: "text", text: "hello" } },
+			{ event_type: "step.stop", index: 0 },
+			{ event_type: "interaction.completed", interaction: { id: "i1", status: "completed" } },
+		];
+		const sse = events.map((event) => `event: ${event.event_type}\ndata: ${JSON.stringify(event)}\n\n`).join("");
+		const { result, calls } = await run([
+			new Response(JSON.stringify({ error: { message: "Too many requests." } }), {
+				status: 429,
+				headers: { "retry-after": "0" },
+			}),
+			new Response(sse, { status: 200 }),
+		]);
+		expect(calls).toBe(2);
+		expect(result.stopReason).toBe("stop");
+		expect(result.content).toEqual([{ type: "text", text: "hello" }]);
+	});
+});
diff --git a/packages/ai/test/google-interactions-replay.test.ts b/packages/ai/test/google-interactions-replay.test.ts
