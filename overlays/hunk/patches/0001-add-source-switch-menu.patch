diff --git a/src/ui/AppHost.reload.test.tsx b/src/ui/AppHost.reload.test.tsx
index 22c52d2..309f11c 100644
--- a/src/ui/AppHost.reload.test.tsx
+++ b/src/ui/AppHost.reload.test.tsx
@@ -134,4 +134,69 @@ describe("reload stale highlight cache", () => {
       rmSync(dir, { force: true, recursive: true });
     }
   });
+
+  test("F9 source menu mnemonics switch sources without stealing normal app keys", async () => {
+    const dir = mkdtempSync(join(tmpdir(), "hunk-source-switch-git-"));
+    const file = join(dir, "test.txt");
+
+    execSync("git init && git config user.email test@test && git config user.name test", {
+      cwd: dir,
+      stdio: "ignore",
+    });
+    writeFileSync(file, "base\n");
+    execSync("git add . && git commit -m init", { cwd: dir, stdio: "ignore" });
+
+    writeFileSync(file, "base\nstaged change\n");
+    execSync("git add .", { cwd: dir, stdio: "ignore" });
+    writeFileSync(file, "base\nstaged change\nunstaged change\n");
+
+    const bootstrap = await loadAppBootstrap(
+      { kind: "vcs", staged: false, options: { mode: "stack", excludeUntracked: true } },
+      { cwd: dir },
+    );
+
+    const setup = await testRender(<AppHost bootstrap={bootstrap} />, {
+      width: 140,
+      height: 20,
+    });
+
+    try {
+      await settleHighlights(setup);
+      expect(setup.captureCharFrame()).toContain("unstaged change");
+
+      await act(async () => {
+        await setup.mockInput.typeText("s");
+      });
+      await flush(setup);
+      expect(setup.captureCharFrame()).toContain("unstaged change");
+
+      await act(async () => {
+        await setup.mockInput.pressKey("F9");
+      });
+      await flush(setup);
+      expect(setup.captureCharFrame()).toContain("Staged");
+
+      await act(async () => {
+        await setup.mockInput.typeText("s");
+      });
+
+      let switched = false;
+      for (let attempt = 0; attempt < 30; attempt++) {
+        await flush(setup);
+        const frame = setup.captureCharFrame();
+        if (frame.includes("staged change") && !frame.includes("unstaged change")) {
+          switched = true;
+          break;
+        }
+        await Bun.sleep(50);
+      }
+
+      expect(switched).toBe(true);
+    } finally {
+      await act(async () => {
+        setup.renderer.destroy();
+      });
+      rmSync(dir, { force: true, recursive: true });
+    }
+  });
 });
