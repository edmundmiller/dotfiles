+import { isCommandEnabled, type AppCommand } from "./appCommands";
+import type { WhichKeyEntry } from "../components/chrome/WhichKeyDock";
+import type { ReviewSourceId, ReviewSourceItem } from "./sourceSwitch";
+
+export interface LeaderAction {
+  sequence: readonly string[];
+  label: string;
+  group: string;
+  commandId?: string;
+  sourceId?: ReviewSourceId;
+}
+
+const PREFIX_LABELS: Record<string, string> = {
+  a: "agent",
+  f: "file",
+  h: "help",
+  n: "navigate",
+  s: "source",
+  v: "view",
+};
+
+const COMMAND_LEADER_ACTIONS: readonly LeaderAction[] = [
+  {
+    sequence: ["SPC", "SPC"],
+    label: "page down",
+    group: "Navigate",
+    commandId: "hunk.review.pageDown",
+  },
+  {
+    sequence: ["SPC", "f", "Tab"],
+    label: "toggle files/filter focus",
+    group: "File",
+    commandId: "hunk.app.toggleFocusArea",
+  },
+  {
+    sequence: ["SPC", "f", "/"],
+    label: "focus filter",
+    group: "File",
+    commandId: "hunk.review.focusFilter",
+  },
+  {
+    sequence: ["SPC", "f", "e"],
+    label: "open file in editor",
+    group: "File",
+    commandId: "hunk.review.editSelectedFile",
+  },
+  {
+    sequence: ["SPC", "f", "r"],
+    label: "reload",
+    group: "File",
+    commandId: "hunk.app.refresh",
+  },
+  {
+    sequence: ["SPC", "f", "q"],
+    label: "quit",
+    group: "File",
+    commandId: "hunk.app.quit",
+  },
+  {
+    sequence: ["SPC", "h", "?"],
+    label: "controls help",
+    group: "Help",
+    commandId: "hunk.app.toggleHelp",
+  },
+  {
+    sequence: ["SPC", "h", "s"],
+    label: "open source menu",
+    group: "Source",
+    commandId: "hunk.source.openMenu",
+  },
+  {
+    sequence: ["SPC", "v", "1"],
+    label: "split view",
+    group: "View",
+    commandId: "hunk.view.layoutSplit",
+  },
+  {
+    sequence: ["SPC", "v", "2"],
+    label: "stacked view",
+    group: "View",
+    commandId: "hunk.view.layoutStack",
+  },
+  {
+    sequence: ["SPC", "v", "0"],
+    label: "auto view",
+    group: "View",
+    commandId: "hunk.view.layoutAuto",
+  },
+  {
+    sequence: ["SPC", "v", "s"],
+    label: "sidebar",
+    group: "View",
+    commandId: "hunk.view.toggleSidebar",
+  },
+  {
+    sequence: ["SPC", "v", "t"],
+    label: "theme selector",
+    group: "View",
+    commandId: "hunk.view.openThemeSelector",
+  },
+  {
+    sequence: ["SPC", "v", "a"],
+    label: "agent notes",
+    group: "View",
+    commandId: "hunk.view.toggleAgentNotes",
+  },
+  {
+    sequence: ["SPC", "a", "a"],
+    label: "agent notes",
+    group: "Agent",
+    commandId: "hunk.view.toggleAgentNotes",
+  },
+  {
+    sequence: ["SPC", "v", "l"],
+    label: "line numbers",
+    group: "View",
+    commandId: "hunk.view.toggleLineNumbers",
+  },
+  {
+    sequence: ["SPC", "v", "w"],
+    label: "line wrapping",
+    group: "View",
+    commandId: "hunk.view.toggleLineWrap",
+  },
+  {
+    sequence: ["SPC", "v", "m"],
+    label: "hunk metadata",
+    group: "View",
+    commandId: "hunk.view.toggleHunkHeaders",
+  },
+  {
+    sequence: ["SPC", "v", "M"],
+    label: "menu bar",
+    group: "View",
+    commandId: "hunk.view.toggleMenuBar",
+  },
+  {
+    sequence: ["SPC", "v", "z"],
+    label: "toggle unchanged context",
+    group: "View",
+    commandId: "hunk.review.toggleHunkGap",
+  },
+  {
+    sequence: ["SPC", "n", "["],
+    label: "previous hunk",
+    group: "Navigate",
+    commandId: "hunk.review.previousHunk",
+  },
+  {
+    sequence: ["SPC", "n", "]"],
+    label: "next hunk",
+    group: "Navigate",
+    commandId: "hunk.review.nextHunk",
+  },
+  {
+    sequence: ["SPC", "n", ","],
+    label: "previous file",
+    group: "Navigate",
+    commandId: "hunk.review.previousFile",
+  },
+  {
+    sequence: ["SPC", "n", "."],
+    label: "next file",
+    group: "Navigate",
+    commandId: "hunk.review.nextFile",
+  },
+  {
+    sequence: ["SPC", "a", "{"],
+    label: "previous comment",
+    group: "Agent",
+    commandId: "hunk.review.previousAnnotatedHunk",
+  },
+  {
+    sequence: ["SPC", "a", "}"],
+    label: "next comment",
+    group: "Agent",
+    commandId: "hunk.review.nextAnnotatedHunk",
+  },
+];
+
+function startsWith(sequence: readonly string[], prefix: readonly string[]) {
+  return prefix.every((key, index) => sequence[index] === key);
+}
+
+function commandGroup(command: AppCommand) {
+  const [owner, group] = command.id.split(".");
+  const value = owner === "hunk" ? group : owner;
+  return value ? `${value[0]?.toUpperCase()}${value.slice(1)}` : "Commands";
+}
+
+export function buildLeaderActions(
+  commands: readonly AppCommand[],
+  sourceItems: readonly ReviewSourceItem[],
+): LeaderAction[] {
+  const availableCommands = new Set(
+    commands.filter((command) => isCommandEnabled(command)).map((command) => command.id),
+  );
+  return [
+    ...COMMAND_LEADER_ACTIONS.filter(
+      (action) => action.commandId && availableCommands.has(action.commandId),
+    ),
+    ...sourceItems
+      .filter((item) => item.enabled)
+      .map((item) => ({
+        sequence: ["SPC", "s", item.hint],
+        label: item.label,
+        group: "Source",
+        sourceId: item.id,
+      })),
+  ];
+}
+
+export function leaderActionForSequence(
+  actions: readonly LeaderAction[],
+  sequence: readonly string[],
+) {
+  return actions.find(
+    (action) => action.sequence.length === sequence.length && startsWith(action.sequence, sequence),
+  );
+}
+
+export function hasLeaderPrefix(actions: readonly LeaderAction[], sequence: readonly string[]) {
+  return actions.some(
+    (action) => action.sequence.length > sequence.length && startsWith(action.sequence, sequence),
+  );
+}
+
+export function leaderEntriesForSequence(
+  actions: readonly LeaderAction[],
+  sequence: readonly string[],
+): WhichKeyEntry[] {
+  const entries: WhichKeyEntry[] = [];
+  for (const action of actions) {
+    if (action.sequence.length <= sequence.length || !startsWith(action.sequence, sequence)) {
+      continue;
+    }
+
+    const key = action.sequence[sequence.length];
+    if (!key) continue;
+    const prefix = action.sequence.length > sequence.length + 1;
+    const entry: WhichKeyEntry = {
+      key,
+      group: prefix ? "Leader" : action.group,
+      label: prefix ? (PREFIX_LABELS[key] ?? action.group.toLowerCase()) : action.label,
+      prefix,
+    };
+    if (
+      !entries.some(
+        (existing) =>
+          existing.key === entry.key &&
+          existing.group === entry.group &&
+          existing.label === entry.label &&
+          existing.prefix === entry.prefix,
+      )
+    ) {
+      entries.push(entry);
+    }
+  }
+  return entries;
+}
+
+/** Build the pinned dock from the live command table, including extension commands. */
+export function directWhichKeyEntries(commands: readonly AppCommand[]): WhichKeyEntry[] {
+  return commands.flatMap((command) =>
+    isCommandEnabled(command)
+      ? command.keyLabels.map((key) => ({
+          key,
+          label: command.title,
+          group: commandGroup(command),
+        }))
+      : [],
+  );
+}
+
+export function leaderTitle(sequence: readonly string[]) {
+  const prefix = sequence[1];
+  return prefix ? `${PREFIX_LABELS[prefix] ?? "leader"}` : "leader";
+}
