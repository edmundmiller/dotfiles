+import { describe, expect, test } from "bun:test";
+import type { AppCommand } from "./appCommands";
+import {
+  buildLeaderActions,
+  directWhichKeyEntries,
+  hasLeaderPrefix,
+  leaderActionForSequence,
+  leaderEntriesForSequence,
+} from "./leaderKeymap";
+
+function command(
+  id: string,
+  title: string,
+  keyLabels: readonly string[],
+  enabled = true,
+): AppCommand {
+  return {
+    id,
+    title,
+    keys: keyLabels,
+    keyLabels,
+    defaultKeys: keyLabels,
+    isEnabled: enabled ? undefined : () => false,
+    match: () => false,
+    run: () => {},
+  };
+}
+
+const COMMANDS = [
+  command("hunk.review.pageDown", "Scroll down one page", ["Space"]),
+  command("hunk.app.quit", "Quit", ["q"]),
+  command("hunk.source.openMenu", "Open source menu", ["F9"]),
+  command("hunk.review.focusFilter", "Focus the file filter", ["/"]),
+  command("hunk.app.toggleFocusArea", "Switch focus", ["Tab"]),
+  command("hunk.review.editSelectedFile", "Open file in editor", ["e"]),
+  command("hunk.app.refresh", "Reload", ["r"]),
+  command("hunk.app.toggleHelp", "Toggle help", ["?"]),
+  command("hunk.view.layoutSplit", "Split layout", ["1"]),
+  command("hunk.view.layoutStack", "Stack layout", ["2"]),
+  command("hunk.view.layoutAuto", "Auto layout", ["0"]),
+  command("hunk.view.toggleSidebar", "Toggle sidebar", ["s"]),
+  command("hunk.view.openThemeSelector", "Open theme selector", ["t"]),
+  command("hunk.view.toggleAgentNotes", "Toggle agent notes", ["a"]),
+  command("hunk.view.toggleLineNumbers", "Toggle line numbers", ["l"]),
+  command("hunk.view.toggleLineWrap", "Toggle line wrapping", ["w"]),
+  command("hunk.view.toggleHunkHeaders", "Toggle hunk metadata", ["m"]),
+  command("hunk.view.toggleMenuBar", "Toggle menu bar", ["M"]),
+  command("hunk.review.toggleHunkGap", "Toggle unchanged context", ["z"]),
+  command("hunk.review.previousHunk", "Previous hunk", ["["]),
+  command("hunk.review.nextHunk", "Next hunk", ["]"]),
+  command("hunk.review.previousFile", "Previous file", [","]),
+  command("hunk.review.nextFile", "Next file", ["."]),
+  command("hunk.review.previousAnnotatedHunk", "Previous comment", ["{"]),
+  command("hunk.review.nextAnnotatedHunk", "Next comment", ["}"]),
+] satisfies AppCommand[];
+
+describe("leader keymap", () => {
+  test("maps leader sequences to current commands and source choices", () => {
+    const actions = buildLeaderActions(COMMANDS, [
+      { id: "unstaged", label: "Unstaged", hint: "u", active: true, enabled: true },
+    ]);
+
+    expect(leaderActionForSequence(actions, ["SPC", "f", "q"])?.commandId).toBe("hunk.app.quit");
+    expect(leaderActionForSequence(actions, ["SPC", "s", "u"])?.sourceId).toBe("unstaged");
+    expect(hasLeaderPrefix(actions, ["SPC", "v"])).toBe(true);
+    expect(leaderEntriesForSequence(actions, ["SPC", "s"])).toEqual([
+      { key: "u", label: "Unstaged", group: "Source", prefix: false },
+    ]);
+  });
+
+  test("omits disabled commands from leader and pinned choices", () => {
+    const commands = COMMANDS.map((item) =>
+      item.id === "hunk.app.refresh" ? command(item.id, item.title, item.keyLabels, false) : item,
+    );
+    const actions = buildLeaderActions(commands, []);
+
+    expect(leaderActionForSequence(actions, ["SPC", "f", "r"])).toBeUndefined();
+    expect(directWhichKeyEntries(commands)).not.toContainEqual(
+      expect.objectContaining({ label: "Reload" }),
+    );
+  });
+});
