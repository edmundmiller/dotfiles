index 0000000..23acb79
--- /dev/null
+++ b/src/ui/hooks/useWhichKey.ts
@@ -0,0 +1,219 @@
+import type { KeyEvent } from "@opentui/core";
+import { useEffect, useMemo, useRef, useState } from "react";
+import type { WhichKeyViewState } from "../components/chrome/WhichKeyDock";
+import type { AppCommand } from "../lib/appCommands";
+import {
+  buildLeaderActions,
+  directWhichKeyEntries,
+  hasLeaderPrefix,
+  leaderActionForSequence,
+  leaderEntriesForSequence,
+  leaderTitle,
+} from "../lib/leaderKeymap";
+import { isEscapeKey } from "../lib/keyboard";
+import type { KeyOwner } from "../lib/keyRouting";
+import type { ReviewSourceId, ReviewSourceItem } from "../lib/sourceSwitch";
+import { executeAppCommand } from "../lib/appCommands";
+
+const LEADER_TIMEOUT_MS = 4000;
+const CTRL_ALT_K = "\u001b\u000b";
+const HIDDEN_WHICH_KEY: WhichKeyViewState = {
+  entries: [],
+  pinned: false,
+  sequence: [],
+  title: "Which-key",
+  visible: false,
+};
+
+function isPlainSpaceKey(key: KeyEvent) {
+  return (
+    (key.name === "space" || key.sequence === " ") &&
+    !key.ctrl &&
+    !key.meta &&
+    !key.option &&
+    !key.shift
+  );
+}
+
+function isWhichKeyToggle(key: KeyEvent) {
+  const name = key.name?.toLowerCase();
+  const sequence = key.sequence?.toLowerCase();
+  return (
+    key.sequence === CTRL_ALT_K ||
+    key.raw === CTRL_ALT_K ||
+    ((name === "k" || sequence === "k") && key.ctrl && key.option && !key.meta)
+  );
+}
+
+function keyTokens(key: KeyEvent) {
+  const tokens = new Set<string>();
+  if (isPlainSpaceKey(key)) tokens.add("SPC");
+  if (key.name === "tab") tokens.add("Tab");
+  if (key.sequence) tokens.add(key.sequence);
+  if (key.name) tokens.add(key.name);
+  return [...tokens];
+}
+
+/** Maintain the Space leader and the optional Ctrl-Alt-K shortcut reference dock. */
+export function useWhichKey({
+  commands,
+  reviewSourceItems,
+  switchReviewSource,
+}: {
+  commands: readonly AppCommand[];
+  reviewSourceItems: readonly ReviewSourceItem[];
+  switchReviewSource: (sourceId: ReviewSourceId) => void;
+}) {
+  const actions = useMemo(
+    () => buildLeaderActions(commands, reviewSourceItems),
+    [commands, reviewSourceItems],
+  );
+  const directEntries = useMemo(() => directWhichKeyEntries(commands), [commands]);
+  const actionsRef = useRef(actions);
+  const commandsRef = useRef(commands);
+  const directEntriesRef = useRef(directEntries);
+  const switchReviewSourceRef = useRef(switchReviewSource);
+  const leaderSequenceRef = useRef<string[] | null>(null);
+  const leaderTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const leaderExpiredRef = useRef(false);
+  const [state, setState] = useState<WhichKeyViewState>(HIDDEN_WHICH_KEY);
+  const stateRef = useRef(state);
+
+  actionsRef.current = actions;
+  commandsRef.current = commands;
+  directEntriesRef.current = directEntries;
+  switchReviewSourceRef.current = switchReviewSource;
+  stateRef.current = state;
+
+  const clearLeader = (keepPinned = true) => {
+    leaderSequenceRef.current = null;
+    leaderExpiredRef.current = false;
+    if (leaderTimeoutRef.current) {
+      clearTimeout(leaderTimeoutRef.current);
+      leaderTimeoutRef.current = null;
+    }
+
+    setState((current) =>
+      keepPinned && current.pinned
+        ? {
+            entries: directEntriesRef.current,
+            pinned: true,
+            sequence: [],
+            title: "Active keys",
+            visible: directEntriesRef.current.length > 0,
+          }
+        : { ...HIDDEN_WHICH_KEY, pinned: current.pinned },
+    );
+  };
+
+  const armLeader = (sequence: string[]) => {
+    if (leaderTimeoutRef.current) {
+      clearTimeout(leaderTimeoutRef.current);
+    }
+    leaderSequenceRef.current = sequence;
+    leaderExpiredRef.current = false;
+    const pinned = stateRef.current.pinned;
+    const entries = leaderEntriesForSequence(actionsRef.current, sequence);
+    setState({
+      entries,
+      pinned,
+      sequence,
+      title: leaderTitle(sequence),
+      visible: entries.length > 0,
+    });
+    leaderTimeoutRef.current = setTimeout(() => {
+      leaderSequenceRef.current = null;
+      leaderExpiredRef.current = true;
+      leaderTimeoutRef.current = null;
+      setState((current) =>
+        current.pinned
+          ? {
+              entries: directEntriesRef.current,
+              pinned: true,
+              sequence: [],
+              title: "Active keys",
+              visible: directEntriesRef.current.length > 0,
+            }
+          : { ...HIDDEN_WHICH_KEY, pinned: false },
+      );
+    }, LEADER_TIMEOUT_MS);
+  };
+
+  const togglePinned = () => {
+    leaderSequenceRef.current = null;
+    leaderExpiredRef.current = false;
+    if (leaderTimeoutRef.current) {
+      clearTimeout(leaderTimeoutRef.current);
+      leaderTimeoutRef.current = null;
+    }
+    setState((current) =>
+      current.pinned
+        ? HIDDEN_WHICH_KEY
+        : {
+            entries: directEntriesRef.current,
+            pinned: true,
+            sequence: [],
+            title: "Active keys",
+            visible: directEntriesRef.current.length > 0,
+          },
+    );
+  };
+
+  useEffect(
+    () => () => {
+      if (leaderTimeoutRef.current) {
+        clearTimeout(leaderTimeoutRef.current);
+      }
+    },
+    [],
+  );
+
+  const handleKey = (key: KeyEvent): KeyOwner => {
+    if (isWhichKeyToggle(key)) {
+      togglePinned();
+      return "mine";
+    }
+
+    const pendingSequence = leaderSequenceRef.current;
+    if (!pendingSequence) {
+      if (!isPlainSpaceKey(key)) {
+        return "notMine";
+      }
+      if (leaderExpiredRef.current) {
+        leaderExpiredRef.current = false;
+        executeAppCommand(commandsRef.current, "hunk.review.pageDown");
+        return "mine";
+      }
+      armLeader(["SPC"]);
+      return "mine";
+    }
+
+    if (isEscapeKey(key)) {
+      clearLeader();
+      return "mine";
+    }
+
+    for (const token of keyTokens(key)) {
+      const sequence = [...pendingSequence, token];
+      const action = leaderActionForSequence(actionsRef.current, sequence);
+      if (action) {
+        if (action.commandId) {
+          executeAppCommand(commandsRef.current, action.commandId);
+        } else if (action.sourceId) {
+          switchReviewSourceRef.current(action.sourceId);
+        }
+        clearLeader();
+        return "mine";
+      }
+      if (hasLeaderPrefix(actionsRef.current, sequence)) {
+        armLeader(sequence);
+        return "mine";
+      }
+    }
+
+    clearLeader();
+    return "notMine";
+  };
+
+  return { handleKey, state };
+}
