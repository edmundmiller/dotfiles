 describe("static diff pager", () => {
+  test("renders every file in review order without exhausting source-fetch capacity", async () => {
+    const paths = Array.from({ length: 37 }, (_, index) => `file-${36 - index}.ts`);
+    const patchText = paths
+      .map((path) =>
+        [
+          `diff --git a/${path} b/${path}`,
+          `--- a/${path}`,
+          `+++ b/${path}`,
+          "@@ -1 +1 @@",
+          "-const value = 1;",
+          "+const value = 2;",
+          "",
+        ].join("\n"),
+      )
+      .join("");
+    const { changeset } = await loadAppBootstrap({
+      kind: "patch",
+      file: "-",
+      text: patchText,
+      options: {},
+    });
+    const overloaded: string[] = [];
+    let active = 0;
+    for (const [index, file] of changeset.files.entries()) {
+      expect(file.metadata.isPartial).toBe(true);
+      file.sourceFetcher = {
+        async getFullText(side) {
+          if (active >= 32) {
+            overloaded.push(file.path);
+            throw new Error("Source backend exhausted");
+          }
+          active++;
+          try {
+            await new Promise((resolve) => setTimeout(resolve, index % 3 === 0 ? 10 : 1));
+            return `const value = ${side === "old" ? 1 : 2};\n`;
+          } finally {
+            active--;
+          }
+        },
+      };
+    }
+    const output = await renderStaticDiff(changeset, {}, { color: false });
+    expect(overloaded).toEqual([]);
+    expect(
+      output
+        .split("\n")
+        .filter((line) => line.startsWith("file-"))
+        .map((line) => line.split(" ")[0]),
+    ).toEqual(paths);
+    expect(output.match(/const value = 2;/g)).toHaveLength(paths.length);
+  });
+
