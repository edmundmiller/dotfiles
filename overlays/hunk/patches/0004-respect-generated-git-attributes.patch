+    writeFileSync(join(repo, "src.txt"), "tracked original\n");
+    git(repo, "add", ".");
+    git(repo, "commit", "-m", "base");
+    git(repo, "mv", "src.txt", "generated.json");
+    writeFileSync(join(repo, "src.txt"), "ordinary replacement\n");
+    const result = await gitOperations["working-tree-diff"]!.load(
+      { kind: "vcs", range: "HEAD", staged: false, options: {} },
+      { cwd: repo },
+    );
+    expect(result.patchText).not.toContain("generated.json");
+    expect(result.untrackedPaths).toEqual(["src.txt"]);
+  });
+
