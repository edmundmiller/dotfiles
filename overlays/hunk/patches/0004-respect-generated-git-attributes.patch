new file mode 100644
index 00000000..9545e1e2
--- /dev/null
+++ b/packages/hunk-git/src/generated.ts
@@ -0,0 +1,228 @@
+import { runGitTextAsync, type GitBackedInput, type GitDiffEndpoints } from "./commands";
+import { HunkExtensionUserError } from "hunkdiff/extension";
+
+/** Add literal, repository-root exclusions without changing caller pathspecs. */
+function excludeGeneratedPaths(args: string[], paths: ReadonlySet<string>) {
+  if (paths.size === 0) return args;
+  return [
+    ...args,
+    ...(args.includes("--") ? [] : ["--"]),
+    ...[...paths].map((path) => `:(top,literal,exclude)${path}`),
+  ];
+}
+
+/** Spell a Git header path in either supported core.quotePath mode. */
+function quoteGitPath(path: string, quoteHighBytes: boolean) {
+  let quoted = "";
+  let needsQuotes = false;
+  const escapes: Record<number, string> = {
+    7: "\\a",
+    8: "\\b",
+    9: "\\t",
+    10: "\\n",
+    11: "\\v",
+    12: "\\f",
+    13: "\\r",
+    34: '\\"',
+    92: "\\\\",
+  };
+  for (const byte of Buffer.from(path)) {
+    const escape = escapes[byte];
+    if (escape || byte < 32 || byte === 127 || (quoteHighBytes && byte >= 128)) {
+      needsQuotes = true;
+      quoted += escape ?? `\\${byte.toString(8).padStart(3, "0")}`;
+    } else {
+      quoted += String.fromCharCode(byte);
+    }
+  }
+  const text = Buffer.from(quoted, "latin1").toString("utf8");
+  return needsQuotes ? `"${text}"` : text;
+}
+
+/** Let Git resolve attributes in the same snapshots and paths as the review. */
+export async function generatedPaths(
+  input: GitBackedInput,
+  patchArgs: string[],
+  resolveEndpoints: () => Promise<GitDiffEndpoints | null>,
+  untrackedPaths: string[],
+  context: {
+    cwd: string;
+    repoRoot: string;
+    gitExecutable: string;
+    signal?: AbortSignal;
+    preventOptionalLocks?: boolean;
+  },
+  warn: (message: string) => void,
+) {
+  const visible = {
+    paths: new Set<string>(),
+    untrackedPaths: new Set<string>(),
+    loadPatch: (args: string[]) => runGitTextAsync({ input, args, ...context }),
+  };
+  if (input.options.includeGenerated) return visible;
+  try {
+    const endpoints = await resolveEndpoints();
+    if (!endpoints) throw new Error("the review has no single old/new attribute context");
+    const separator = patchArgs.indexOf("--");
+    const boundary = separator < 0 ? patchArgs.length : separator;
+    const args = [
+      ...patchArgs.slice(0, boundary).filter((arg) => arg !== "-p"),
+      "--name-status",
+      "--no-color",
+      "--no-relative",
+      "-z",
+      ...patchArgs.slice(boundary),
+    ];
+    const status = await runGitTextAsync({ input, args, ...context });
+    const tokens = status.split("\0");
+    if (tokens.pop() !== "") throw new Error("incomplete Git name-status response");
+    const entries: {
+      path: string;
+      previousPath?: string;
+      deleted: boolean;
+      code: string;
+      untracked?: boolean;
+    }[] = [];
+    for (let i = 0; i < tokens.length; ) {
+      const code = tokens[i++]!;
+      const first = tokens[i++];
+      if (!/^[ACDMRTUXB][0-9]*$/.test(code) || first === undefined) {
+        throw new Error("unexpected Git name-status response");
+      }
+      const renamed = code.startsWith("R") || code.startsWith("C");
+      const path = renamed ? tokens[i++] : first;
+      if (path === undefined) throw new Error("incomplete Git rename response");
+      entries.push({
+        path,
+        previousPath: renamed ? first : undefined,
+        deleted: code === "D",
+        code,
+      });
+    }
+    const trackedEntries = [...entries];
+    entries.push(
+      ...untrackedPaths.map((path) => ({ path, deleted: false, code: "?", untracked: true })),
+    );
+    const hidden = new Set<string>();
+    const hiddenUntracked = new Set<string>();
+    for (const deleted of [false, true]) {
+      const selected = entries.filter((entry) => entry.deleted === deleted);
+      if (selected.length === 0) continue;
+      const endpoint = deleted ? endpoints.old : endpoints.new;
+      if (endpoint.kind === "none") continue;
+      const source =
+        endpoint.kind === "git-ref"
+          ? [`--source=${endpoint.ref}`]
+          : endpoint.kind === "index"
+            ? ["--cached"]
+            : [];
+      // Bound argv size, including repositories with long or unusual path names.
+      for (let start = 0; start < selected.length; start += 64) {
+        const batch = selected.slice(start, start + 64);
+        const output = await runGitTextAsync({
+          input,
+          args: [
+            "check-attr",
+            "-z",
+            ...source,
+            "linguist-generated",
+            "--",
+            ...batch.map((e) => e.path),
+          ],
+          ...context,
+          cwd: context.repoRoot,
+        });
+        const attributes = output.split("\0");
+        if (attributes.pop() !== "" || attributes.length !== batch.length * 3) {
+          throw new Error("incomplete Git check-attr response");
+        }
+        for (let i = 0; i < batch.length; i++) {
+          const entry = batch[i]!;
+          const [path, attribute, value] = attributes.slice(i * 3, i * 3 + 3);
+          if (path !== entry.path || attribute !== "linguist-generated") {
+            throw new Error("unexpected Git check-attr response");
+          }
+          if (value === "set" || value === "true") {
+            if (entry.untracked) {
+              hiddenUntracked.add(entry.path);
+            } else {
+              hidden.add(entry.path);
+              // Only tracked rename exclusions include the old side. A new
+              // untracked replacement at that name has its own attributes.
+              if (entry.code.startsWith("R") && entry.previousPath) hidden.add(entry.previousPath);
+            }
+          }
+        }
+      }
+    }
+    const failOpen = (detail: string) => {
+      hidden.clear();
+      hiddenUntracked.clear();
+      warn(`Hunk: generated-file filtering failed; keeping files visible. ${detail}`);
+    };
+    return {
+      paths: hidden,
+      untrackedPaths: hiddenUntracked,
+      loadPatch: async (args: string[]) => {
+        if (hidden.size === 0) return visible.loadPatch(args);
+        if (input.kind !== "stash-show") {
+          const excludedArgs = excludeGeneratedPaths(args, hidden);
+          // Leave room for the environment and platform argv bookkeeping.
+          if (
+            excludedArgs.reduce((bytes, arg) => bytes + Buffer.byteLength(arg) + 16, 0) > 32_000
+          ) {
+            failOpen("Generated exclusions exceed the command argument budget.");
+            return visible.loadPatch(args);
+          }
+          try {
+            return await visible.loadPatch(excludedArgs);
+          } catch (error) {
+            context.signal?.throwIfAborted();
+            failOpen("Git could not run with generated exclusions; retrying without them.");
+            return visible.loadPatch(args);
+          }
+        }
+        const patch = await visible.loadPatch([...args, "--no-relative"]);
+        // Match complete Git records by their exact header spelling, not
+        // position. A type change has two blocks; unsupported summaries must
+        // be detected before removing any blocks, even when counts coincide.
+        const headers = new Map<string, (typeof trackedEntries)[number]>();
+        for (const entry of trackedEntries) {
+          for (const quoteHighBytes of [false, true]) {
+            const old = quoteGitPath(`a/${entry.previousPath ?? entry.path}`, quoteHighBytes);
+            const next = quoteGitPath(`b/${entry.path}`, quoteHighBytes);
+            headers.set(`diff --git ${old} ${next}`, entry);
+          }
+        }
+        const blocks = patch.split(/(?=^(?:\x1b\[[0-9;]*m)*diff --git )/m).filter(Boolean);
+        const counts = new Map<(typeof trackedEntries)[number], number>();
+        const records = blocks.map((block) => {
+          const header = block.split("\n", 1)[0]!.replace(/\x1b\[[0-9;]*m/g, "");
+          const entry = headers.get(header);
+          if (entry) counts.set(entry, (counts.get(entry) ?? 0) + 1);
+          return entry;
+        });
+        if (
+          records.some((entry) => !entry) ||
+          trackedEntries.some((entry) => counts.get(entry) !== (entry.code === "T" ? 2 : 1))
+        ) {
+          failOpen("Could not match complete Git patch records.");
+          return patch;
+        }
+        return blocks.filter((_, index) => !hidden.has(records[index]!.path)).join("");
+      },
+    };
+  } catch (error) {
+    context.signal?.throwIfAborted();
+    const detail =
+      error instanceof HunkExtensionUserError
+        ? [error.message, ...error.suggestions].join(" ")
+        : error instanceof Error
+          ? error.message
+          : String(error);
+    warn(
+      `Hunk: generated-file lookup failed; keeping files visible. ${detail.replace(/[\r\n\x00-\x1f]+/g, " ").slice(0, 200)} Use --include-generated to skip attribute lookup.`,
+    );
+    return visible;
+  }
+}
