+++ b/packages/hunk-git/src/generated.ts
@@ -0,0 +1,140 @@
+import { runGitTextAsync, type GitBackedInput, type GitDiffEndpoints } from "./commands";
+import { HunkExtensionUserError } from "hunkdiff/extension";
+
+/** Add literal, repository-root exclusions without changing caller pathspecs. */
+export function excludeGeneratedPaths(args: string[], paths: ReadonlySet<string>) {
+  if (paths.size === 0) return args;
+  return [
+    ...args,
+    ...(args.includes("--") ? [] : ["--"]),
+    ...[...paths].map((path) => `:(top,literal,exclude)${path}`),
+  ];
+}
+
+/** Let Git resolve attributes in the same snapshots and paths as the review. */
+export async function generatedPaths(
+  input: GitBackedInput,
+  patchArgs: string[],
+  resolveEndpoints: () => Promise<GitDiffEndpoints | null>,
+  untrackedPaths: string[],
+  context: {
+    cwd: string;
+    repoRoot: string;
+    gitExecutable: string;
+    signal?: AbortSignal;
+    preventOptionalLocks?: boolean;
+  },
+  warn: (message: string) => void,
+): Promise<{ paths: Set<string>; filterPatch: (patch: string) => string }> {
+  const visible = { paths: new Set<string>(), filterPatch: (patch: string) => patch };
+  if (input.options.includeGenerated) return visible;
+  try {
+    const endpoints = await resolveEndpoints();
+    if (!endpoints) throw new Error("the review has no single old/new attribute context");
+    const separator = patchArgs.indexOf("--");
+    const boundary = separator < 0 ? patchArgs.length : separator;
+    const args = [
+      ...patchArgs.slice(0, boundary).filter((arg) => arg !== "-p"),
+      "--name-status",
+      "--no-color",
+      "--no-relative",
+      "-z",
+      ...patchArgs.slice(boundary),
+    ];
+    const status = await runGitTextAsync({ input, args, ...context });
+    const tokens = status.split("\0");
+    if (tokens.pop() !== "") throw new Error("incomplete Git name-status response");
+    const entries: { path: string; previousPath?: string; deleted: boolean }[] = [];
+    for (let i = 0; i < tokens.length; ) {
+      const code = tokens[i++]!;
+      const first = tokens[i++];
+      if (!/^[ACDMRTUXB][0-9]*$/.test(code) || first === undefined) {
+        throw new Error("unexpected Git name-status response");
+      }
+      const renamed = code.startsWith("R") || code.startsWith("C");
+      const path = renamed ? tokens[i++] : first;
+      if (path === undefined) throw new Error("incomplete Git rename response");
+      entries.push({
+        path,
+        previousPath: code.startsWith("R") ? first : undefined,
+        deleted: code === "D",
+      });
+    }
+    const trackedEntries = [...entries];
+    entries.push(...untrackedPaths.map((path) => ({ path, deleted: false })));
+    const hidden = new Set<string>();
+    for (const deleted of [false, true]) {
+      const selected = entries.filter((entry) => entry.deleted === deleted);
+      if (selected.length === 0) continue;
+      const endpoint = deleted ? endpoints.old : endpoints.new;
+      if (endpoint.kind === "none") continue;
+      const source =
+        endpoint.kind === "git-ref"
+          ? [`--source=${endpoint.ref}`]
+          : endpoint.kind === "index"
+            ? ["--cached"]
+            : [];
+      // Bound argv size, including repositories with long or unusual path names.
+      for (let start = 0; start < selected.length; start += 64) {
+        const batch = selected.slice(start, start + 64);
+        const output = await runGitTextAsync({
+          input,
+          args: [
+            "check-attr",
+            "-z",
+            ...source,
+            "linguist-generated",
+            "--",
+            ...batch.map((e) => e.path),
+          ],
+          ...context,
+          cwd: context.repoRoot,
+        });
+        const attributes = output.split("\0");
+        if (attributes.pop() !== "" || attributes.length !== batch.length * 3) {
+          throw new Error("incomplete Git check-attr response");
+        }
+        for (let i = 0; i < batch.length; i++) {
+          const entry = batch[i]!;
+          const [path, attribute, value] = attributes.slice(i * 3, i * 3 + 3);
+          if (path !== entry.path || attribute !== "linguist-generated") {
+            throw new Error("unexpected Git check-attr response");
+          }
+          if (value === "set" || value === "true") {
+            hidden.add(entry.path);
+            // Excluding both sides prevents a hidden rename turning into a deletion.
+            if (entry.previousPath) hidden.add(entry.previousPath);
+          }
+        }
+      }
+    }
+    return {
+      paths: hidden,
+      filterPatch: (patch) => {
+        if (hidden.size === 0) return patch;
+        // Git emits name-status and patch records in the same order. Do not
+        // decode quoted patch headers, or split a rename into separate changes.
+        const blocks = patch.split(/(?=^(?:\x1b\[[0-9;]*m)*diff --git )/m).filter(Boolean);
+        if (blocks.length !== trackedEntries.length) {
+          warn(
+            "Hunk: generated-file lookup could not match Git patch records; keeping files visible.",
+          );
+          return patch;
+        }
+        return blocks.filter((_, index) => !hidden.has(trackedEntries[index]!.path)).join("");
+      },
+    };
+  } catch (error) {
+    context.signal?.throwIfAborted();
+    const detail =
+      error instanceof HunkExtensionUserError
+        ? [error.message, ...error.suggestions].join(" ")
+        : error instanceof Error
+          ? error.message
+          : String(error);
+    warn(
+      `Hunk: generated-file lookup failed; keeping files visible. ${detail.replace(/[\r\n\x00-\x1f]+/g, " ").slice(0, 200)} Use --include-generated to skip attribute lookup.`,
+    );
+    return visible;
+  }
+}
