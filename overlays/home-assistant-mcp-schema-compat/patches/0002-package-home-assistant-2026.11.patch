index 0000000..f9e87bb
--- /dev/null
+++ b/python-modules/pygbl/default.nix
@@ -0,0 +1,50 @@
+{
+  lib,
+  buildPythonPackage,
+  fetchPypi,
+  setuptools,
+  setuptools-scm,
+  pyelftools,
+  cryptography,
+  lz4,
+  pytestCheckHook,
+  pytest-timeout,
+}:
+
+buildPythonPackage (finalAttrs: {
+  pname = "pygbl";
+  version = "1.2.0";
+  pyproject = true;
+
+  src = fetchPypi {
+    inherit (finalAttrs) pname version;
+    hash = "sha256-/T7Jr7tP/6rmAtOsJAHaN48YaOtT99wiID+T3qb107U=";
+  };
+
+  build-system = [
+    setuptools
+    setuptools-scm
+  ];
+
+  dependencies = [ pyelftools ];
+
+  optional-dependencies = {
+    crypto = [ cryptography ];
+    lz4 = [ lz4 ];
+  };
+
+  nativeCheckInputs = [
+    pytestCheckHook
+    pytest-timeout
+    cryptography
+    lz4
+  ];
+
+  pythonImportsCheck = [ "pygbl" ];
+
+  meta = {
+    description = "Parser for Silicon Labs GBL and EBL firmware images";
+    homepage = "https://github.com/zigpy/pygbl";
+    license = lib.licenses.asl20;
+  };
+})
