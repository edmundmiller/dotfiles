+def _external_systemd_executor_status():
+    """Return ``(unit, active)`` for a host-declared systemd executor.
+
+    Timer-driven deployments write ``$HERMES_HOME/cron/executor.json`` so
+    CLI health output can verify the real executor instead of assuming the
+    gateway process is the only way built-in cron jobs can fire.
+    """
+    hermes_home = Path(os.environ.get("HERMES_HOME") or (Path.home() / ".hermes"))
+    executor_path = hermes_home / "cron" / "executor.json"
+    try:
+        executor = json.loads(executor_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError, TypeError):
+        return None
+
+    if executor.get("kind") != "systemd":
+        return None
+    unit = executor.get("unit")
+    if not isinstance(unit, str) or not unit.strip():
+        return None
+    unit = unit.strip()
+
+    heartbeat_at = executor.get("heartbeat_at")
+    if heartbeat_at is not None:
+        max_age_seconds = executor.get("max_age_seconds")
+        if (
+            not isinstance(heartbeat_at, str)
+            or isinstance(max_age_seconds, bool)
+            or not isinstance(max_age_seconds, (int, float))
+            or max_age_seconds <= 0
+        ):
+            return unit, False
+        try:
+            seen_at = datetime.fromisoformat(heartbeat_at.replace("Z", "+00:00"))
+            if seen_at.tzinfo is None:
+                return unit, False
+            age_seconds = (datetime.now(timezone.utc) - seen_at).total_seconds()
+        except (OverflowError, TypeError, ValueError):
+            return unit, False
+        return unit, 0 <= age_seconds <= max_age_seconds
+
+    try:
+        result = subprocess.run(
+            ["systemctl", "is-active", "--quiet", unit],
+            check=False,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=3,
+        )
+        active = result.returncode == 0
+    except (OSError, subprocess.TimeoutExpired):
+        active = False
+    return unit, active
+
+
+def _external_cron_executor_configured() -> bool:
+    """Return whether this profile delegates cron ticks to systemd."""
+    try:
+        from hermes_cli.config import load_config
+
+        config = load_config()
+        cron = config.get("cron") if isinstance(config, dict) else None
+        if not isinstance(cron, dict):
+            return False
+        value = cron.get("gateway_ticker")
+        return type(value) is bool and value is False
+    except Exception:
+        return False
+
+
