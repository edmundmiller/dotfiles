+test "PageList chunk_ceiling_repro hyperlink explicit id" {
+    // herdr-2026-07-19-182341.ips: resizeCols → "link dupe failed with capacity check"
+    // → ReleaseSafe unreachable.
+    //
+    // PageEntry.dupe does two chunk-rounded string allocs. Old writeCell probed
+    // one alloc of uri+id. Reflow two links onto one page so the second lands
+    // with free in [wrong_probe, dupe_need) and must grow capacity first.
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    // 33-byte URI/ID each round to two 32-byte chunks (64). Summed length 66
+    // rounds to 96. Two separate allocs need 128.
+    const uri2 = "u" ** 33;
+    const id2 = "i" ** 33;
+    // string_chunk=32: bytesRequired(66)=96, bytesRequired(33)*2=128
+    const wrong_probe: usize = 96;
+    const dupe_need: usize = 128;
+    try testing.expect(wrong_probe < dupe_need);
+    const filler_len = pagepkg.string_bytes_default - wrong_probe;
+
+    var s = try init(alloc, 2, 10, 0);
+    defer s.deinit();
+
+    {
+        const page = &s.pages.first.?.data;
+        page.pauseIntegrityChecks(true);
+        for (page.size.rows..page.capacity.rows) |_| {
+            _ = try s.grow();
+        }
+        page.pauseIntegrityChecks(false);
+        try s.growRows(1);
+        try testing.expectEqual(@as(usize, 2), s.totalPages());
+    }
+
+    {
+        const page = &s.pages.first.?.data;
+        const id = try page.insertHyperlink(.{
+            .id = .{ .implicit = 0 },
+            .uri = "a" ** filler_len,
+        });
+        const rac = page.getRowAndCell(page.size.cols - 1, page.size.rows - 1);
+        rac.row.wrap = true;
+        rac.cell.* = .{
+            .content_tag = .codepoint,
+            .content = .{ .codepoint = 'A' },
+        };
+        try page.setHyperlink(rac.row, rac.cell, id);
+    }
+
+    {
+        const page = &s.pages.last.?.data;
+        const id = try page.insertHyperlink(.{
+            .id = .{ .explicit = id2 },
+            .uri = uri2,
+        });
+        const rac = page.getRowAndCell(0, 0);
+        rac.row.wrap_continuation = true;
+        rac.cell.* = .{
+            .content_tag = .codepoint,
+            .content = .{ .codepoint = 'B' },
+        };
+        try page.setHyperlink(rac.row, rac.cell, id);
+    }
+
+    try s.resize(.{ .cols = s.cols + 1, .reflow = true });
+}
+
