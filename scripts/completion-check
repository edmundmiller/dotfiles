#!/usr/bin/env bash
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1

python=${COMPLETION_CHECK_PYTHON:-}
if [ -z "$python" ]; then
  # Regression tests require Python 3.11+ (tomllib, PEP 604 unions); macOS
  # /usr/bin/python3 is 3.9, so probe for a modern interpreter on PATH.
  for candidate in python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      python="$candidate"
      break
    fi
  done
fi
python=${python:-python3}
hey=${COMPLETION_CHECK_HEY:-hey}

"$python" -m unittest discover -s tests -p 'test_*.py' >&2 || {
  printf '%s\n' 'Dotfiles regression tests failed; fix them before stopping.'
  exit 1
}

"$hey" check >&2 || {
  printf '%s\n' 'hey check failed; fix it before stopping.'
  exit 1
}
