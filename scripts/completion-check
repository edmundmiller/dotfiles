#!/usr/bin/env bash
set -uo pipefail

# Keep the checker independent of stale inherited Nix paths (mirrors bin/hey):
# the official-installer profile at /nix/var/nix/profiles/default (2.25) shadows
# the nix-darwin-managed nix in /run/current-system/sw (2.35) on PATH, and the
# older nix rejects the committed skills-catalog path input when updating the
# lock. Prefer the system-managed toolchain so regression tests that invoke
# `nix` (test_node_config, test_omp_model_routing) always use it.
export PATH="/run/current-system/sw/bin:$PATH"

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1

python=${COMPLETION_CHECK_PYTHON:-}
if [ -z "$python" ]; then
  # Regression tests require Python 3.11+ (tomllib, PEP 604 unions); macOS
  # /usr/bin/python3 is 3.9, so probe for a modern interpreter on PATH.
  # Skip Emscripten/WASI shims (e.g. ~/.local/bin/python3.13 from a WASM
  # kernel): they report 3.13 but cannot spawn subprocesses.
  for candidate in python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) and sys.platform not in {"emscripten", "wasi"} else 1)' >/dev/null 2>&1; then
      python="$candidate"
      break
    fi
  done
fi
python=${python:-python3}
hey=${COMPLETION_CHECK_HEY:-"$root/bin/hey"}

"$python" -m unittest discover -s tests -p 'test_*.py' >&2 || {
  printf '%s\n' 'Dotfiles regression tests failed; fix them before stopping.'
  exit 1
}

"$hey" check >&2 || {
  printf '%s\n' 'hey check failed; fix it before stopping.'
  exit 1
}
