+  if [[ -n ${prompt:-} ]]; then
+    command=(bash -c "printf '%s\n' \"\$1\" | exec amp" _ "$prompt")
+  else
+    command=(amp)
+  fi
+  ;;
 opencode)
   command=(opencode --auto)
   [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")
