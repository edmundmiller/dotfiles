    }
  ],
  "manualRecovery": [
    {
      "id": "onepassword-bootstrap",
      "message": "Sign in to 1Password before restoring private state on a fresh host."
    },
    {
      "id": "airpods-pairing",
      "message": "Re-pair AirPods after hardware or Bluetooth state is replaced."
    },
    {
      "id": "syncthing-pairing",
      "message": "After replacing meshify's Syncthing identity, update its device ID in modules/services/syncthing.nix and redeploy the NUC."
    },
    {
      "id": "voxtype-gpu",
      "message": "Run `sudo voxtype setup gpu --enable` after restoring on meshify, then verify that `voxtype setup gpu --status` reports GPU (Vulkan)."
    }
  ],
