<div class="layout layout--col layout--center-y layout--stretch-x gap--medium lg:gap--large portrait:gap--small">
  <span class="label label--small">{{ status_text }}</span>
  <span class="title title--large lg:title--xlarge" data-clamp="2">{{ headline_text }}</span>
  <span class="description" data-clamp="4">{{ message_text }}</span>

  {% if progress != blank %}
    <div class="progress-bar progress-bar--small md:progress-bar--base">
      <div class="content">
        <span class="label label--small">Progress</span>
        <span class="value value--xxsmall">{{ progress_value }}%</span>
      </div>
      <div class="track">
        <div class="fill" style="width: {{ progress_value }}%"></div>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ source_text }}</span>
  {% if timestamp_text != blank %}<span class="instance">{{ timestamp_text }}</span>{% endif %}
</div>
