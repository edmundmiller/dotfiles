#!/usr/bin/env bash
set -euo pipefail

output="${1:?usage: build OUTPUT /absolute/path/to/mise}"
mise="${2:?usage: build OUTPUT /absolute/path/to/mise}"
entrypoint="${3:-main.bend}"
if [[ $mise != /* ]]; then
  echo 'build: mise must be an absolute executable path' >&2
  exit 2
fi
move=/usr/bin/false
if [[ $entrypoint == macos-main.bend ]]; then
  move="${4:-$(command -v mv)}"
  if [[ $move != /* ]] || ! "$move" --version | grep -q 'GNU coreutils'; then
    echo 'build: macos tasks require an absolute GNU coreutils mv executable' >&2
    exit 2
  fi
fi
source_dir="$(dirname "$0")"
build_dir="$(mktemp -d)"
trap 'rm -rf "$build_dir"' EXIT
export BEND_NO_TELEMETRY=1

# Encode pathname bytes, not shell syntax, into a C string literal.
literal() {
  local value=$1
  LC_ALL=C
  for ((i = 0; i < ${#value}; i++)); do
    printf '\\%03o' "'${value:i:1}"
  done
}

# Bend runs on Bun and recurses deeply: snapshot-main.bend needs ~4.4 MiB of the
# default 8 MiB stack, and a busy CI runner overflowed it. Raise the soft limit.
stack_kib=$(ulimit -Hs)
if [[ $stack_kib == unlimited ]] || ((stack_kib > 65536)); then
  stack_kib=65536
fi
ulimit -s "$stack_kib"

bend "$source_dir/PROOF.bend"
bend "$source_dir/$entrypoint" -o "$build_dir/generated.c"
stack_words=4096
if [[ $entrypoint != main.bend ]]; then
  stack_words=1048576 # 8 MiB for bounded OS text inputs in the task engine.
fi
cflags=(
  "-DHEY_STACK_BASE_WORDS=$stack_words"
  "-DHEY_MISE=\"$(literal "$mise")\""
  "-DHEY_MV=\"$(literal "$move")\""
)
if [[ $entrypoint == main.bend ]]; then
  python="${HEY_BUILD_PYTHON:-$(command -v python3)}"
  freshness="${HEY_BUILD_FRESHNESS:-$(realpath "$source_dir/freshness.py")}"
  cflags+=(
    "-DHEY_PYTHON=\"$(literal "$python")\""
    "-DHEY_FRESHNESS=\"$(literal "$freshness")\""
  )
fi
clang -O2 -pthread -I"$build_dir" -I"$source_dir" \
  "${cflags[@]}" \
  "$source_dir/launcher.c" -o "$output" -lm
