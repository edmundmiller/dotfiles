+            .expect("Voxtype menu bar symbol supports point-size configuration");
+        // AppKit supplies the correct contrast for light, dark and selected menus.
+        image.setTemplate(true);
+        let mtm = MainThreadMarker::new().expect("Voxtype menu bar runs on the main thread");
+        let item = tray.ns_status_item().expect("Voxtype menu bar item exists");
+        // Keep neighboring icons still when the recording state changes.
+        item.setLength(NSSquareStatusItemLength);
+        let button = item.button(mtm).expect("Voxtype menu bar button exists");
+        button.setImage(Some(&image));
