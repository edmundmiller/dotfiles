+fn plugin_root(json: &str, plugin_id: &str) -> Option<String> {
+    let id = format!("\"{plugin_id}\"");
+    let id_offset = json.find(&id)?;
+    let object_start = json[..id_offset].rfind('{')?;
+    json_string_field(&json[object_start..], "plugin_root")
+}
