+    #[test]
+    fn author_gate_tests_inherited_dont_ask_rejects_permission_request() {
+        const CHILD_MARKER: &str = "BUZZ_ACP_PERMISSION_TEST_CHILD";
+        if std::env::var_os(CHILD_MARKER).is_some() {
+            assert!(super::rejects_permission_requests(&[]));
+            return;
+        }
+
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "acp::tests::author_gate_tests_inherited_dont_ask_rejects_permission_request",
+                "--nocapture",
+            ])
+            .env("BUZZ_ACP_PERMISSION_MODE", "dont-ask")
+            .env(CHILD_MARKER, "1")
+            .output()
+            .expect("run isolated inherited-environment permission test");
+
+        assert!(
+            output.status.success(),
+            "child test failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
