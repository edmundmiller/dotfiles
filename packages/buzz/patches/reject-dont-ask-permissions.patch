+fn rejects_permission_requests(extra_env: &[(String, String)]) -> bool {
+    let explicit = extra_env
+        .iter()
+        .rev()
+        .find_map(|(key, value)| (key == "BUZZ_ACP_PERMISSION_MODE").then_some(value.as_str()));
+    let inherited = std::env::var("BUZZ_ACP_PERMISSION_MODE").ok();
+    matches!(
+        explicit.or(inherited.as_deref()),
+        Some("dont-ask" | "dontAsk")
+    )
+}
+
+fn permission_option_id<'a>(
+    options: &'a [serde_json::Value],
+    kind: &str,
+) -> Result<Option<&'a str>, AcpError> {
+    options
+        .iter()
+        .find(|option| option.get("kind").and_then(|value| value.as_str()) == Some(kind))
+        .map(|option| {
+            option
+                .get("optionId")
+                .and_then(|value| value.as_str())
+                .ok_or_else(|| AcpError::Protocol(format!("{kind} option missing optionId")))
+        })
+        .transpose()
+}
+
+fn select_permission_option<'a>(
+    options: &'a [serde_json::Value],
+    reject_requests: bool,
+) -> Result<(&'static str, &'a str), AcpError> {
+    if reject_requests {
+        return permission_option_id(options, "reject_once")?
+            .map(|option_id| ("reject_once", option_id))
+            .ok_or_else(|| {
+                AcpError::Protocol("dont-ask permission request missing reject_once option".into())
+            });
+    }
+
+    if let Some(option_id) = permission_option_id(options, "allow_once")? {
+        return Ok(("allow_once", option_id));
+    }
+
+    permission_option_id(options, "reject_once")?
+        .map(|option_id| ("reject_once", option_id))
+        .ok_or_else(|| {
+            AcpError::Protocol(
+                "no suitable permission option found (neither allow_once nor reject_once)".into(),
+            )
+        })
+}
