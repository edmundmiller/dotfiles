     #[test]
+    fn author_gate_tests_dont_ask_rejects_permission_request() {
+        let options: Vec<serde_json::Value> = serde_json::from_str(
+            r#"[
+                {"optionId": "allow", "name": "Allow once", "kind": "allow_once"},
+                {"optionId": "deny", "name": "Reject once", "kind": "reject_once"}
+            ]"#,
+        )
+        .unwrap();
+        let extra_env = vec![(
+            "BUZZ_ACP_PERMISSION_MODE".to_string(),
+            "dont-ask".to_string(),
+        )];
+        let dont_ask_alias_env = vec![(
+            "BUZZ_ACP_PERMISSION_MODE".to_string(),
+            "dontAsk".to_string(),
+        )];
+
+        assert!(super::rejects_permission_requests(&extra_env));
+        assert!(super::rejects_permission_requests(&dont_ask_alias_env));
+        assert_eq!(
+            super::select_permission_option(&options, true).unwrap(),
+            ("reject_once", "deny")
+        );
+    }
