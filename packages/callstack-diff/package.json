{
  "name": "callstack-diff",
  "version": "0.1.0",
  "description": "Render and diff static call-stack trees for JS/TS using Oxc",
  "type": "module",
  "bin": {
    "callstack-diff": "src/cli.ts",
    "csd": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "vitest run --config vitest.evals.config.ts",
    "evals:pi": "CALLSTACK_DIFF_EVALS_ENABLED=1 vitest run --config vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=vitest-results.json",
    "lint:setup": "effect-tsgo patch --no-typescript --oxlint",
    "lint": "oxlint --type-aware --deny-warnings src tests evals vite.config.ts vitest.evals.config.ts",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix src tests evals vite.config.ts vitest.evals.config.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110",
    "oxc-parser": "0.146.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/bun": "1.3.14",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vitest-evals": "0.16.1"
  }
}
