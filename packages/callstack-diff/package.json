{
  "name": "callstack-diff",
  "version": "0.1.0",
  "description": "Render and diff static call-stack trees for JS/TS using Oxc",
  "type": "module",
  "bin": {
    "csd": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "lint:setup": "effect-tsgo patch --no-typescript --oxlint",
    "lint": "oxlint --type-aware --deny-warnings src tests",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix src tests"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "effect": "4.0.0-beta.105",
    "oxc-parser": "0.99.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.35.0",
    "@types/bun": "1.3.14",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
