+++ b/extensions/pstack/readonly.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ExtensionAPI, ExtensionToolContext, ToolDefinition } from "@earendil-works/pi-coding-agent";
+import pstack from "./index.ts";
+
+let tool: ToolDefinition;
+pstack({
+	registerCommand() {},
+	registerTool(definition: ToolDefinition) {
+		tool = definition;
+	},
+} as unknown as ExtensionAPI);
+
+for (const mode of ["tasks", "chain"] as const) {
+	for (const readonly of [true, false]) {
+		test(`${mode} rejects ignored top-level readonly=${readonly}`, async () => {
+			const result = await tool.execute(
+				"readonly-check",
+				{
+					readonly,
+					[mode]: [{ agent: "unavailable-agent", task: "Review the change", readonly: false }],
+				},
+				undefined,
+				undefined,
+				{ cwd: process.cwd(), modelRegistry: { getAvailable: () => [] } } as unknown as ExtensionToolContext,
+			);
+			assert.equal(result.isError, true);
+			assert.match(JSON.stringify(result.content), /set readonly on each task/i);
+		});
+	}
+	test(`${mode} accepts per-task readonly`, async () => {
+		const result = await tool.execute(
+			"per-task-check",
+			{ [mode]: [{ agent: "unavailable-agent", task: "Review the change", readonly: true }] },
+			undefined,
+			undefined,
+			{ cwd: process.cwd(), modelRegistry: { getAvailable: () => [] } } as unknown as ExtensionToolContext,
+		);
+		assert.match(JSON.stringify(result.content), /Unknown agent/);
+	});
+}
