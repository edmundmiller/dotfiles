+describe("personal wiki lifecycle", () => {
+  test("preserves curated indexes and legacy pages while finalizing a new page", async () => {
+    const rootDir = await mkdtemp(path.join(os.tmpdir(), "openwiki-personal-"));
+    const backend = new OpenWikiLocalShellBackend({
+      docsOnly: true,
+      outputMode: "local-wiki",
+      rootDir,
+      virtualMode: true,
+    });
+    await backend.write("/index.md", "Curated root\n");
+    await backend.write("/notes/index.md", "Curated notes\n");
+    await backend.write("/notes/legacy.md", "# Legacy\n");
+    const prepared = await prepareWikiForAuthoring({
+      backend,
+      outputMode: "local-wiki",
+    });
+    await backend.write("/new/page.md", "# New page\n\nAuthored text.\n");
+    await finalizeWikiArtifacts({
+      backend,
+      outputMode: "local-wiki",
+      prepared,
+      at: RUN_TIMESTAMP,
+    });
+    expect(await readFile(path.join(rootDir, "notes/index.md"), "utf8")).toBe(
+      "Curated notes\n",
+    );
+    expect(await readFile(path.join(rootDir, "notes/legacy.md"), "utf8")).toBe(
+      "# Legacy\n",
+    );
+    await expect(
+      readFile(path.join(rootDir, "new/index.md"), "utf8"),
+    ).rejects.toMatchObject({ code: "ENOENT" });
+    expect(await readFile(path.join(rootDir, "new/page.md"), "utf8")).toContain(
+      "Authored text.",
+    );
+  });
+
+  test("limits validation to edited pages, including metadata-only edits", async () => {
+    const rootDir = await mkdtemp(path.join(os.tmpdir(), "openwiki-personal-"));
+    const backend = new OpenWikiLocalShellBackend({
+      docsOnly: true,
+      outputMode: "local-wiki",
+      rootDir,
+      virtualMode: true,
+    });
+    const unrelated = `# Unrelated\n\n${BROKEN_MERMAID}\n`;
+    await backend.write("/other/note.md", unrelated);
+    await backend.write("/other/index.md", "Curated\n");
+    await backend.write(
+      "/edited.md",
+      "---\ntitle: Old\n---\n\n# Edited\n\n[missing](missing.md)\n",
+    );
+    const prepared = await prepareWikiForAuthoring({
+      backend,
+      outputMode: "local-wiki",
+    });
+    await backend.write(
+      "/edited.md",
+      "---\ntitle: New\n---\n\n# Edited\n\n[missing](missing.md)\n",
+    );
+    await backend.write("/other/index.md", "Agent-curated index\n");
+    await finalizeWikiArtifacts({
+      backend,
+      outputMode: "local-wiki",
+      prepared,
+      at: RUN_TIMESTAMP,
+    });
+    expect(await readFile(path.join(rootDir, "other/note.md"), "utf8")).toBe(
+      unrelated,
+    );
+    expect(await readFile(path.join(rootDir, "other/index.md"), "utf8")).toBe(
+      "Agent-curated index\n",
+    );
+    await expect(
+      readFile(path.join(rootDir, "index.md"), "utf8"),
+    ).rejects.toMatchObject({ code: "ENOENT" });
+    expect(await readFile(path.join(rootDir, "edited.md"), "utf8")).toContain(
+      "openwiki: broken internal link",
+    );
+  });
