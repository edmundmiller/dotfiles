+    });
+    await finalizeWikiArtifacts({
+      backend,
+      outputMode: "local-wiki",
+      prepared,
+      at: RUN_TIMESTAMP,
+    });
+    for (const [name, content] of Object.entries(files)) {
+      expect(await readFile(path.join(rootDir, name), "utf8")).toBe(content);
+    }
+  });
