+  ) => {
+    const { OpenWikiLocalShellBackend } =
+      await import("../../src/agent/docs-only-backend.ts");
+    const { prepareWikiForAuthoring, finalizeWikiArtifacts } =
+      await import("../../src/agent/wiki-finalizer.ts");
+    const backend = new OpenWikiLocalShellBackend({
+      docsOnly: true,
+      outputMode: "local-wiki",
+      rootDir: cwd,
+      virtualMode: true,
+    });
+    const prepared = await prepareWikiForAuthoring({
+      backend,
