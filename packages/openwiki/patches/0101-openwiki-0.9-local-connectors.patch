+    );
+    expect(execFileAsync).toHaveBeenNthCalledWith(
+      2,
+      "imsg",
+      [
+        "history",
+        "--chat-id",
+        "7",
+        "--limit",
+        "5000",
+        "--attachments",
+        "--start",
+        "2026-07-08T12:00:00.000Z",
+        "--end",
+        "2026-07-15T12:00:00.000Z",
+        "--json",
+      ],
+      { maxBuffer: 10 * 1024 * 1024 },
+    );
+    expect(execFileAsync).toHaveBeenNthCalledWith(
+      3,
+      "imsg",
+      [
+        "history",
+        "--chat-id",
+        "8",
+        "--limit",
+        "5000",
+        "--attachments",
+        "--start",
+        "2026-07-08T12:00:00.000Z",
+        "--end",
+        "2026-07-15T12:00:00.000Z",
+        "--json",
+      ],
+      { maxBuffer: 10 * 1024 * 1024 },
+    );
+    expect(execFileAsync).toHaveBeenCalledTimes(3);
+  });
+
+  test("writes deterministic allowlisted records and attachment metadata only", async () => {
+    mockImsg([chat(7, ["alice@example.com", "bob@example.com"])], {
+      7: [
+        message(12, 7, "2026-07-15T11:30:00.000Z", {
+          attachments: [
+            {
+              absolute_path: "/private/message.jpg",
+              byte_size: 42,
+              converted_path: "/private/converted.jpg",
+              filename: "~/Library/Messages/Attachments/ab/cd/message.jpg",
+              is_sticker: false,
+              mime_type: "image/jpeg",
+              missing: false,
+              transfer_name: "IMG_1.JPG",
+              uti: "public.jpeg",
+            },
+          ],
+          destination_caller_id: "secret-routing",
+          is_from_me: true,
+          reply_to_guid: "reply-guid",
+          sender: "ignored-outbound-sender",
+          thread_originator_guid: "thread-guid",
+          unknown_payload: { secret: true },
+        }),
+        message(10, 7, "2026-07-15T10:00:00.000Z", {
+          sender: "ALICE@example.com",
+        }),
+        message(11, 7, "2026-07-15T10:00:00.000Z", {
+          sender: "bob@example.com",
+        }),
+      ],
+    });
+    const connector = await loadConnector();
+    const result = await connector.ingest({
+      connectorConfig: { chatIds: [7] },
+    });
+    const messagesPath = result.rawFiles.find((file) =>
+      file.endsWith("messages.json"),
+    );
+    const payload = JSON.parse(await readFile(messagesPath!, "utf8")) as {
+      schemaVersion: number;
+      messages: { id: number }[];
+    };
