+
+async function loadConnector() {
+  const { createIMessageConnector } =
+    await import("../src/connectors/sources/imessage.ts");
+  return createIMessageConnector();
+}
+
+function ndjson(rows: unknown[]): string {
+  return rows.map((row) => JSON.stringify(row)).join("\n");
+}
+
+function chat(
+  id: number,
+  participants: string[],
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    guid: `chat-guid-${id}`,
+    id,
+    identifier: `chat-${id}`,
+    is_group: participants.length > 1,
+    participants,
+    ...overrides,
+  };
+}
+
+function message(
+  id: number,
+  chatId: number,
+  createdAt: string,
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    attachments: [],
+    chat_id: chatId,
+    created_at: createdAt,
+    guid: `message-guid-${id}`,
+    id,
+    is_from_me: false,
+    sender: "alice@example.com",
+    text: `message ${id}`,
+    ...overrides,
+  };
+}
+
+function mockImsg(
+  chats: unknown[],
+  histories: Record<number, unknown[]>,
+): void {
+  execFileAsync.mockImplementation(
+    (_file: string, args: string[], options: { maxBuffer: number }) => {
+      expect(options.maxBuffer).toBe(10 * 1024 * 1024);
+      if (args[0] === "chats")
+        return Promise.resolve({ stdout: ndjson(chats), stderr: "" });
+      const chatId = Number(args[args.indexOf("--chat-id") + 1]);
+      return Promise.resolve({
+        stdout: ndjson(histories[chatId] ?? []),
+        stderr: "",
+      });
+    },
+  );
+}
+
+async function connectorState() {
+  return JSON.parse(
+    await readFile(
+      path.join(home, ".openwiki/connectors/imessage/state.json"),
+      "utf8",
+    ),
+  ) as { latestIds?: Record<string, string>; runs?: unknown[] };
+}
+
+describe("iMessage connector", () => {
+  test("requires explicit scope and disabled config performs no subprocess work", async () => {
+    const connector = await loadConnector();
+
+    await expect(connector.ingest()).resolves.toMatchObject({
+      message:
+        "iMessage ingestion requires at least one chatIds or participants scope in ~/.openwiki/connectors/imessage/config.json.",
+      rawFiles: [],
+      status: "error",
+    });
+    expect(execFileAsync).not.toHaveBeenCalled();
+
+    await expect(
+      connector.ingest({ connectorConfig: { enabled: false, chatIds: [7] } }),
+    ).resolves.toMatchObject({ rawFiles: [], status: "skipped" });
+    expect(execFileAsync).not.toHaveBeenCalled();
+  });
+
+  test("intersects chat IDs and participant scope and uses exact bounded imsg calls", async () => {
+    mockImsg(
+      [
+        chat(7, ["Alice@Example.com", "+15550001"]),
+        chat(8, ["alice@example.com", "+15550001"]),
+        chat(9, ["alice@example.com"]),
+      ],
+      { 7: [message(11, 7, "2026-07-15T11:00:00.000Z")] },
+    );
+    const connector = await loadConnector();
+
+    const result = await connector.ingest({
+      connectorConfig: {
+        chatIds: [7, 8, 20, 7, -1],
+        maxMessagesPerChat: 6000,
+        participants: [" ALICE@example.com ", "+15550001", "alice@example.com"],
+        windowHours: 200,
+      },
+    });
+
+    expect(result).toMatchObject({ status: "success" });
+    expect(result.warnings).toEqual(["Unmatched iMessage chat IDs: 20."]);
+    expect(execFileAsync).toHaveBeenNthCalledWith(
+      1,
+      "imsg",
+      ["chats", "--limit", "10000", "--json"],
