diff --git i/src/connectors/sources/discord.ts w/src/connectors/sources/discord.ts
new file mode 100644
index 0000000..f09fa45
--- /dev/null
+++ w/src/connectors/sources/discord.ts
@@ -0,0 +1,497 @@
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import {
+  createRunId,
+  readConnectorConfig,
+  readConnectorState,
+  updateStateWithRun,
+  writeConnectorState,
+  writeRawJson,
+} from "../io.js";
+import type {
+  ConnectorDefinition,
+  ConnectorIngestOptions,
+  ConnectorIngestResult,
+  ConnectorRuntime,
+  ConnectorState,
+} from "../types.js";
+
+const execFileAsync = promisify(execFile);
+const DISCRAWL_EXECUTABLE_ENV_KEY = "OPENWIKI_DISCRAWL_EXECUTABLE";
+const MAX_BUFFER_BYTES = 10 * 1024 * 1024;
+const MAX_WINDOW_HOURS = 720;
+const SCHEDULE_GRACE_MS = 15 * 60 * 1000;
+
+export type DiscordConfig = {
+  channelIds?: string[];
+  enabled?: boolean;
+  guildIds?: string[];
+  includeDms?: boolean;
+  maxMessages?: number;
+  windowHours?: number;
+};
+
+type DiscrawlMessage = {
+  author_id: string;
+  author_name: string;
+  channel_id: string;
+  channel_name: string;
+  content: string;
+  created_at: string;
+  display_content: string;
+  guild_id: string;
+  guild_name: string;
+  has_attachments: boolean;
+  message_id: string;
+  pinned: boolean;
+  source: string;
+};
+
+type NormalizedDiscordMessage = {
+  authorId: string;
+  authorName: string;
+  channelId: string;
+  channelName: string;
+  content: string;
+  createdAt: string;
+  displayContent: string;
+  guildId: string;
+  guildName: string;
+  hasAttachments: boolean;
+  messageId: string;
+  pinned: boolean;
+  source: string;
+};
+
+const definition: ConnectorDefinition = {
+  backend: "local-cli",
+  mode: "personal",
+  description:
+    "Reads explicitly scoped Discord history from a local Discrawl archive.",
+  displayName: "Discord",
+  id: "discord",
+  requiredEnv: [],
+  supportsAgenticDiscovery: false,
+};
+
+export function createDiscordConnector(): ConnectorRuntime {
+  return { ...definition, ingest };
+}
+
+async function ingest(
+  options: ConnectorIngestOptions = {},
+): Promise<ConnectorIngestResult> {
+  const runId = createRunId();
+  const config = normalizeConfig({
+    ...(await readConnectorConfig<DiscordConfig>("discord", {
+      channelIds: [],
+      enabled: true,
+      guildIds: [],
+      includeDms: false,
+      maxMessages: 500,
+      windowHours: options.windowHours ?? 24,
+    })),
+    ...((options.connectorConfig ?? {}) as DiscordConfig),
+  });
+  const rawFiles: string[] = [];
+  const warnings: string[] = [];
+
+  if (!config.enabled) {
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "Discord connector is disabled.",
+    );
+  }
+
+  if (
+    config.guildIds.length === 0 &&
+    config.channelIds.length === 0 &&
+    !config.includeDms
+  ) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      "Discord ingestion requires at least one guildIds, channelIds, or includeDms scope in ~/.openwiki/connectors/discord/config.json.",
+    );
+  }
+
+  const state = await readConnectorState("discord");
+  const end = new Date();
+  const start = new Date(end.getTime() - config.windowHours * 60 * 60 * 1000);
+  const gapError = getCatchUpGapError(state, start, end, config.windowHours);
+  if (gapError) {
+    return result(runId, "error", rawFiles, warnings, gapError);
+  }
+  const previousRunAt = Date.parse(state.lastRunAt ?? "");
+  if (Number.isFinite(previousRunAt)) {
+    start.setTime(Math.min(start.getTime(), previousRunAt));
+  }
+  const queryHours = Math.ceil(
+    (end.getTime() - start.getTime()) / (60 * 60 * 1000),
+  );
+
+  let rows: DiscrawlMessage[];
+  try {
+    rows = deduplicateMessages(await readScopedMessages(config, queryHours));
+  } catch (error) {
+    return result(runId, "error", rawFiles, warnings, mapDiscrawlError(error));
+  }
+
+  const newRows = rows.filter(
+    (row) =>
+      compareSnowflakes(row.message_id, readCursor(state, row.channel_id)) > 0,
+  );
+  const nextCursors = getNextCursors(state, rows);
+
+  if (newRows.length === 0) {
+    const nextState = updateStateWithRun(state, {
+      at: end.toISOString(),
+      rawFiles,
+      runId,
+      status: "skipped",
+      warnings,
+    });
+    nextState.latestIds = { ...(state.latestIds ?? {}), ...nextCursors };
+    await writeConnectorState("discord", nextState);
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "No new Discord messages in the configured Discrawl scope.",
+    );
+  }
+
+  const messages = newRows.map(normalizeMessage).sort(compareMessages);
+  const messagesPath = await writeRawJson("discord", runId, "messages.json", {
+    messages,
+    schemaVersion: 1,
+  });
+  const manifestPath = await writeRawJson("discord", runId, "manifest.json", {
+    connectorId: "discord",
+    dataFiles: ["messages.json"],
+    generatedAt: end.toISOString(),
+    messageCount: messages.length,
+    schemaVersion: 1,
+    scope: {
+      channelIds: config.channelIds,
+      guildIds: config.guildIds,
+      includeDms: config.includeDms,
+    },
+    channels: summarizeChannels(messages, state, nextCursors),
+    window: {
+      end: end.toISOString(),
+      hours: queryHours,
+      start: start.toISOString(),
+    },
+  });
+  rawFiles.push(messagesPath, manifestPath);
+
+  const nextState = updateStateWithRun(state, {
+    at: end.toISOString(),
+    rawFiles,
+    runId,
+    status: "success",
+    warnings,
+  });
+  nextState.latestIds = { ...(state.latestIds ?? {}), ...nextCursors };
+  await writeConnectorState("discord", nextState);
+
+  return result(
+    runId,
+    "success",
+    rawFiles,
+    warnings,
+    `Wrote ${messages.length} Discord message(s) from Discrawl.`,
+  );
+}
+
+function normalizeConfig(config: DiscordConfig): Required<DiscordConfig> {
+  return {
+    channelIds: uniqueSnowflakes(config.channelIds),
+    enabled: config.enabled !== false,
+    guildIds: uniqueSnowflakes(config.guildIds),
+    includeDms: config.includeDms === true,
+    maxMessages: clampInteger(config.maxMessages, 1, 5000, 500),
+    windowHours: clampInteger(config.windowHours, 1, MAX_WINDOW_HOURS, 24),
+  };
+}
+
+function uniqueSnowflakes(values: unknown): string[] {
+  if (!Array.isArray(values)) return [];
+  return [
+    ...new Set(
+      values.filter(
+        (value): value is string =>
+          typeof value === "string" && /^\d{1,20}$/u.test(value),
+      ),
+    ),
+  ];
+}
+
+function clampInteger(
+  value: number | undefined,
+  minimum: number,
+  maximum: number,
+  fallback: number,
+): number {
+  if (!Number.isFinite(value)) return fallback;
+  return Math.min(maximum, Math.max(minimum, Math.trunc(value!)));
+}
+
+async function readScopedMessages(
+  config: Required<DiscordConfig>,
+  windowHours: number,
+): Promise<DiscrawlMessage[]> {
+  const scopes: string[][] = [];
+  const guildArgs =
+    config.guildIds.length > 0 ? ["--guilds", config.guildIds.join(",")] : [];
+
+  if (config.channelIds.length > 0) {
+    for (const channelId of config.channelIds) {
+      scopes.push([...guildArgs, "--channel", channelId]);
+    }
+  } else if (config.guildIds.length > 0) {
+    scopes.push(guildArgs);
+  }
+
+  if (config.includeDms) scopes.push(["--dm"]);
+
+  const rows: DiscrawlMessage[] = [];
+  for (const scope of scopes) {
+    const parsed = parseDiscrawlMessages(
+      await runDiscrawl([
+        "--json",
+        "messages",
+        ...scope,
+        "--hours",
+        String(windowHours),
+        "--limit",
+        String(config.maxMessages),
+      ]),
+    );
+    if (parsed.length === config.maxMessages) {
+      throw new Error(
+        `Discrawl reached maxMessages=${config.maxMessages}; increase the limit or narrow the Discord scope.`,
+      );
+    }
+    rows.push(...parsed);
+  }
+  return rows;
+}
+
+async function runDiscrawl(args: string[]): Promise<string> {
+  const executable = process.env[DISCRAWL_EXECUTABLE_ENV_KEY] ?? "discrawl";
+  const { stdout } = await execFileAsync(executable, args, {
+    maxBuffer: MAX_BUFFER_BYTES,
+  });
+  return String(stdout).trim();
+}
+
+function parseDiscrawlMessages(output: string): DiscrawlMessage[] {
+  const value: unknown = output.length === 0 ? null : JSON.parse(output);
+  if (value === null) return [];
+  if (!Array.isArray(value)) {
+    throw new Error("Discrawl returned an invalid JSON message array.");
+  }
+  return value.map(parseDiscrawlMessage);
+}
+
+function parseDiscrawlMessage(value: unknown): DiscrawlMessage {
+  if (!isRecord(value)) {
+    throw new Error("Discrawl returned an invalid JSON message row.");
+  }
+  const stringKeys = [
+    "author_id",
+    "author_name",
+    "channel_id",
+    "channel_name",
+    "content",
+    "created_at",
+    "display_content",
+    "guild_id",
+    "guild_name",
+    "message_id",
+    "source",
+  ] as const;
+  for (const key of stringKeys) {
+    if (typeof value[key] !== "string") {
+      throw new Error(`Discrawl message row has invalid ${key}.`);
+    }
+  }
+  if (
+    typeof value.has_attachments !== "boolean" ||
+    typeof value.pinned !== "boolean" ||
+    !/^\d{1,20}$/u.test(value.message_id as string) ||
+    !/^\d{1,20}$/u.test(value.channel_id as string)
+  ) {
+    throw new Error("Discrawl returned an invalid JSON message row.");
+  }
+  return value as DiscrawlMessage;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function normalizeMessage(row: DiscrawlMessage): NormalizedDiscordMessage {
+  return {
+    authorId: row.author_id,
+    authorName: row.author_name,
+    channelId: row.channel_id,
+    channelName: row.channel_name,
+    content: row.content,
+    createdAt: row.created_at,
+    displayContent: row.display_content,
+    guildId: row.guild_id,
+    guildName: row.guild_name,
+    hasAttachments: row.has_attachments,
+    messageId: row.message_id,
+    pinned: row.pinned,
+    source: row.source,
+  };
+}
+
+function deduplicateMessages(rows: DiscrawlMessage[]): DiscrawlMessage[] {
+  const byId = new Map<string, DiscrawlMessage>();
+  for (const row of rows) {
+    if (!byId.has(row.message_id)) byId.set(row.message_id, row);
+  }
+  return [...byId.values()];
+}
+
+function readCursor(state: ConnectorState, channelId: string): string {
+  const value = state.latestIds?.[`channel:${channelId}`];
+  return typeof value === "string" && /^\d{1,20}$/u.test(value) ? value : "0";
+}
+
+function getNextCursors(
+  state: ConnectorState,
+  rows: DiscrawlMessage[],
+): Record<string, string> {
+  const cursors: Record<string, string> = {};
+  for (const row of rows) {
+    const key = `channel:${row.channel_id}`;
+    const current = cursors[key] ?? readCursor(state, row.channel_id);
+    if (compareSnowflakes(row.message_id, current) > 0) {
+      cursors[key] = row.message_id;
+    }
+  }
+  return cursors;
+}
+
+function compareSnowflakes(left: string, right: string): number {
+  const leftValue = BigInt(left);
+  const rightValue = BigInt(right);
+  return leftValue < rightValue ? -1 : leftValue > rightValue ? 1 : 0;
+}
+
+function compareMessages(
+  left: NormalizedDiscordMessage,
+  right: NormalizedDiscordMessage,
+): number {
+  return (
+    left.createdAt.localeCompare(right.createdAt) ||
+    compareSnowflakes(left.messageId, right.messageId)
+  );
+}
+
+function summarizeChannels(
+  messages: NormalizedDiscordMessage[],
+  state: ConnectorState,
+  nextCursors: Record<string, string>,
+) {
+  const byChannel = new Map<
+    string,
+    {
+      channelId: string;
+      channelName: string;
+      guildId: string;
+      guildName: string;
+      messageCount: number;
+    }
+  >();
+  for (const message of messages) {
+    const summary = byChannel.get(message.channelId) ?? {
+      channelId: message.channelId,
+      channelName: message.channelName,
+      guildId: message.guildId,
+      guildName: message.guildName,
+      messageCount: 0,
+    };
+    summary.messageCount += 1;
+    byChannel.set(message.channelId, summary);
+  }
+  return [...byChannel.values()].map((summary) => ({
+    ...summary,
+    cursorAfter:
+      nextCursors[`channel:${summary.channelId}`] ??
+      readCursor(state, summary.channelId),
+    cursorBefore: readCursor(state, summary.channelId),
+  }));
+}
+
+function getCatchUpGapError(
+  state: ConnectorState,
+  start: Date,
+  end: Date,
+  windowHours: number,
+): string | undefined {
+  const previousRunAt = Date.parse(state.lastRunAt ?? "");
+  const scheduleGraceMs =
+    windowHours < MAX_WINDOW_HOURS ? SCHEDULE_GRACE_MS : 0;
+  if (
+    !Number.isFinite(previousRunAt) ||
+    previousRunAt >= start.getTime() - scheduleGraceMs
+  ) {
+    return undefined;
+  }
+  const requiredHours = Math.ceil(
+    (end.getTime() - previousRunAt) / (60 * 60 * 1000),
+  );
+  return requiredHours > MAX_WINDOW_HOURS
+    ? `The previous successful Discord ingest is ${requiredHours} hours old, but windowHours is capped at ${MAX_WINDOW_HOURS}. Move ~/.openwiki/connectors/discord/state.json aside only if you deliberately accept the older gap, then rerun with windowHours=${MAX_WINDOW_HOURS}.`
+    : `The previous successful Discord ingest predates windowHours=${windowHours}; increase windowHours to at least ${requiredHours} to catch up without gaps.`;
+}
+
+function mapDiscrawlError(error: unknown): string {
+  if (hasErrorCode(error, "ENOENT")) {
+    return `Discrawl is unavailable; install it or set ${DISCRAWL_EXECUTABLE_ENV_KEY} to its absolute path.`;
+  }
+  const message = error instanceof Error ? error.message : String(error);
+  if (message.includes("invalid JSON")) return message;
+  if (message.includes("maxMessages=")) return message;
+  return `Discrawl message query failed: ${message}`;
+}
+
+function hasErrorCode(error: unknown, code: string): boolean {
+  return Boolean(
+    error &&
+    typeof error === "object" &&
+    "code" in error &&
+    (error as NodeJS.ErrnoException).code === code,
+  );
+}
+
+function result(
+  runId: string,
+  status: ConnectorIngestResult["status"],
+  rawFiles: string[],
+  warnings: string[],
+  message: string,
+): ConnectorIngestResult {
+  return {
+    connectorId: "discord",
+    message,
+    rawFiles,
+    runId,
+    statePath: "~/.openwiki/connectors/discord/state.json",
+    status,
+    warnings,
+  };
+}
diff --git i/src/connectors/sources/imessage.ts w/src/connectors/sources/imessage.ts
new file mode 100644
index 0000000..e628928
--- /dev/null
+++ w/src/connectors/sources/imessage.ts
@@ -0,0 +1,597 @@
+import { execFile } from "node:child_process";
+import { basename } from "node:path";
+import { promisify } from "node:util";
+import {
+  createRunId,
+  readConnectorConfig,
+  readConnectorState,
+  updateStateWithRun,
+  writeConnectorState,
+  writeRawJson,
+} from "../io.js";
+import type {
+  ConnectorDefinition,
+  ConnectorIngestOptions,
+  ConnectorIngestResult,
+  ConnectorRuntime,
+  ConnectorState,
+} from "../types.js";
+
+const execFileAsync = promisify(execFile);
+const MAX_BUFFER_BYTES = 10 * 1024 * 1024;
+const MAX_WINDOW_HOURS = 168;
+const SCHEDULE_GRACE_MS = 15 * 60 * 1000;
+
+export type IMessageConfig = {
+  enabled?: boolean;
+  chatIds?: number[];
+  participants?: string[];
+  windowHours?: number;
+  maxMessagesPerChat?: number;
+};
+
+type IMessageChat = {
+  guid: string;
+  id: number;
+  identifier: string;
+  isGroup: boolean;
+  participants: string[];
+};
+
+type IMessageRow = {
+  attachments?: unknown[];
+  chat_id: number;
+  created_at: string;
+  guid: string;
+  id: number;
+  is_from_me?: boolean;
+  reply_to_guid?: string;
+  sender?: string;
+  text: string;
+  thread_originator_guid?: string;
+};
+
+type NormalizedMessage = {
+  attachments: NormalizedAttachment[];
+  createdAt: string;
+  guid: string;
+  id: number;
+  isFromMe: boolean;
+  recipients: string[];
+  replyToGuid?: string;
+  sender: string;
+  text: string;
+  thread: IMessageChat;
+  threadOriginatorGuid?: string;
+};
+
+type NormalizedAttachment = {
+  byteSize?: number;
+  filename?: string;
+  isSticker?: boolean;
+  mimeType?: string;
+  missing?: boolean;
+  transferName?: string;
+  uti?: string;
+};
+
+const definition: ConnectorDefinition = {
+  backend: "local-cli",
+  mode: "personal",
+  description:
+    "Reads explicitly scoped local Messages conversations through imsg.",
+  displayName: "iMessage",
+  id: "imessage",
+  requiredEnv: [],
+  supportsAgenticDiscovery: false,
+};
+
+export function createIMessageConnector(): ConnectorRuntime {
+  return { ...definition, ingest };
+}
+
+async function ingest(
+  options: ConnectorIngestOptions = {},
+): Promise<ConnectorIngestResult> {
+  const runId = createRunId();
+  const config = normalizeConfig({
+    ...(await readConnectorConfig<IMessageConfig>("imessage", {
+      enabled: true,
+      chatIds: [],
+      participants: [],
+      windowHours: options.windowHours ?? 24,
+      maxMessagesPerChat: 500,
+    })),
+    ...((options.connectorConfig ?? {}) as IMessageConfig),
+  });
+  const rawFiles: string[] = [];
+  const warnings: string[] = [];
+
+  if (!config.enabled) {
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "iMessage connector is disabled.",
+    );
+  }
+
+  if (config.chatIds.length === 0 && config.participants.length === 0) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      "iMessage ingestion requires at least one chatIds or participants scope in ~/.openwiki/connectors/imessage/config.json.",
+    );
+  }
+
+  const state = await readConnectorState("imessage");
+  const end = new Date();
+  const start = new Date(end.getTime() - config.windowHours * 60 * 60 * 1000);
+  const previousRunAt = Date.parse(state.lastRunAt ?? "");
+  const scheduleGraceMs =
+    config.windowHours < MAX_WINDOW_HOURS ? SCHEDULE_GRACE_MS : 0;
+  if (
+    Number.isFinite(previousRunAt) &&
+    previousRunAt < start.getTime() - scheduleGraceMs
+  ) {
+    const requiredHours = Math.ceil(
+      (end.getTime() - previousRunAt) / (60 * 60 * 1000),
+    );
+    const message =
+      requiredHours > MAX_WINDOW_HOURS
+        ? `The previous successful iMessage ingest is ${requiredHours} hours old, but windowHours is capped at ${MAX_WINDOW_HOURS}. To recover the most recent ${MAX_WINDOW_HOURS} hours and deliberately accept the older gap, set windowHours=${MAX_WINDOW_HOURS}, move ~/.openwiki/connectors/imessage/state.json aside, and rerun.`
+        : `The previous successful iMessage ingest predates windowHours=${config.windowHours}; increase windowHours to at least ${requiredHours} to catch up without gaps.`;
+    return result(runId, "error", rawFiles, warnings, message);
+  }
+  if (Number.isFinite(previousRunAt)) {
+    start.setTime(Math.min(start.getTime(), previousRunAt));
+  }
+  let chats: IMessageChat[];
+
+  try {
+    chats = parseChats(await runImsg(["chats", "--limit", "10000", "--json"]));
+  } catch (error) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      mapImsgError(error, "chats"),
+    );
+  }
+
+  const selectedChats = chats.filter(
+    (chat) =>
+      (config.chatIds.length === 0 || config.chatIds.includes(chat.id)) &&
+      (config.participants.length === 0 ||
+        includesAllParticipants(chat.participants, config.participants)),
+  );
+
+  if (config.chatIds.length > 0) {
+    const matchedIds = new Set(selectedChats.map((chat) => chat.id));
+    const unmatchedIds = config.chatIds.filter((id) => !matchedIds.has(id));
+    if (unmatchedIds.length > 0 && selectedChats.length > 0) {
+      warnings.push(`Unmatched iMessage chat IDs: ${unmatchedIds.join(", ")}.`);
+    }
+  }
+
+  if (selectedChats.length === 0) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      "No iMessage chat matched the configured chatIds/participants scope.",
+    );
+  }
+
+  const rowsByChat = new Map<number, IMessageRow[]>();
+  for (const chat of selectedChats) {
+    let rows: IMessageRow[];
+    try {
+      rows = parseMessages(
+        await runImsg([
+          "history",
+          "--chat-id",
+          String(chat.id),
+          "--limit",
+          String(config.maxMessagesPerChat),
+          "--attachments",
+          "--start",
+          start.toISOString(),
+          "--end",
+          end.toISOString(),
+          "--json",
+        ]),
+      );
+    } catch (error) {
+      return result(
+        runId,
+        "error",
+        rawFiles,
+        warnings,
+        mapImsgError(error, "history", chat.id),
+      );
+    }
+
+    const cursor = readCursor(state, chat.id);
+    if (
+      rows.length === config.maxMessagesPerChat &&
+      rows.some((row) => row.id > cursor)
+    ) {
+      return result(
+        runId,
+        "error",
+        rawFiles,
+        warnings,
+        `iMessage history reached maxMessagesPerChat=${config.maxMessagesPerChat} for chat ${chat.id}; increase the limit or narrow the time window.`,
+      );
+    }
+    rowsByChat.set(
+      chat.id,
+      rows.filter((row) => row.id > cursor),
+    );
+  }
+
+  const messages = deduplicateAndSort(selectedChats, rowsByChat);
+  if (messages.length === 0) {
+    const nextState = updateStateWithRun(state, {
+      at: end.toISOString(),
+      rawFiles,
+      runId,
+      status: "skipped",
+      warnings,
+    });
+    await writeConnectorState("imessage", nextState);
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "No new iMessage messages in the configured scope.",
+    );
+  }
+
+  const nextCursors = getNextCursors(state, selectedChats, rowsByChat);
+  const messagesPath = await writeRawJson("imessage", runId, "messages.json", {
+    schemaVersion: 1,
+    messages,
+  });
+  const manifestPath = await writeRawJson("imessage", runId, "manifest.json", {
+    schemaVersion: 1,
+    connectorId: "imessage",
+    generatedAt: end.toISOString(),
+    window: {
+      start: start.toISOString(),
+      end: end.toISOString(),
+      hours: config.windowHours,
+    },
+    scope: {
+      chatIds: config.chatIds,
+      participants: config.participants,
+    },
+    threads: selectedChats.map((chat) => ({
+      id: chat.id,
+      identifier: chat.identifier,
+      guid: chat.guid,
+      messageCount: messages.filter((message) => message.thread.id === chat.id)
+        .length,
+      cursorBefore: state.latestIds?.[`chat:${chat.id}`] ?? null,
+      cursorAfter:
+        nextCursors[`chat:${chat.id}`] ??
+        state.latestIds?.[`chat:${chat.id}`] ??
+        null,
+    })),
+    messageCount: messages.length,
+    dataFiles: ["messages.json"],
+  });
+  rawFiles.push(messagesPath, manifestPath);
+
+  const nextState = updateStateWithRun(state, {
+    at: end.toISOString(),
+    rawFiles,
+    runId,
+    status: "success",
+    warnings,
+  });
+  nextState.latestIds = { ...(state.latestIds ?? {}), ...nextCursors };
+  await writeConnectorState("imessage", nextState);
+
+  return result(
+    runId,
+    "success",
+    rawFiles,
+    warnings,
+    `Wrote ${messages.length} iMessage message(s).`,
+  );
+}
+
+function normalizeConfig(config: IMessageConfig): Required<IMessageConfig> {
+  return {
+    enabled: config.enabled !== false,
+    chatIds: uniquePositiveIntegers(config.chatIds),
+    participants: uniqueHandles(config.participants),
+    windowHours: clampInteger(config.windowHours, 1, MAX_WINDOW_HOURS, 24),
+    maxMessagesPerChat: clampInteger(config.maxMessagesPerChat, 1, 5000, 500),
+  };
+}
+
+function uniquePositiveIntegers(values: unknown): number[] {
+  if (!Array.isArray(values)) return [];
+  return [
+    ...new Set(
+      values.filter(
+        (value): value is number => Number.isInteger(value) && value > 0,
+      ),
+    ),
+  ];
+}
+
+function uniqueHandles(values: unknown): string[] {
+  if (!Array.isArray(values)) return [];
+  const handles = new Map<string, string>();
+  for (const value of values) {
+    if (typeof value !== "string" || value.trim().length === 0) continue;
+    const trimmed = value.trim();
+    const key = trimmed.toLocaleLowerCase("en-US");
+    if (!handles.has(key)) handles.set(key, trimmed);
+  }
+  return [...handles.values()];
+}
+
+function clampInteger(
+  value: number | undefined,
+  minimum: number,
+  maximum: number,
+  fallback: number,
+): number {
+  if (!Number.isFinite(value)) return fallback;
+  return Math.min(maximum, Math.max(minimum, Math.trunc(value!)));
+}
+
+async function runImsg(args: string[]): Promise<string> {
+  const { stdout } = await execFileAsync("imsg", args, {
+    maxBuffer: MAX_BUFFER_BYTES,
+  });
+  return String(stdout).trim();
+}
+
+function parseChats(output: string): IMessageChat[] {
+  return parseNdjson(output).flatMap((row) => {
+    const id = row.id;
+    if (typeof id !== "number" || !Number.isFinite(id)) return [];
+    return [
+      {
+        guid: typeof row.guid === "string" ? row.guid : "",
+        id,
+        identifier: typeof row.identifier === "string" ? row.identifier : "",
+        isGroup: row.is_group === true,
+        participants: uniqueHandles(row.participants),
+      },
+    ];
+  });
+}
+
+function parseMessages(output: string): IMessageRow[] {
+  return parseNdjson(output).map((row) => {
+    if (
+      typeof row.id !== "number" ||
+      !Number.isFinite(row.id) ||
+      typeof row.chat_id !== "number" ||
+      !Number.isFinite(row.chat_id) ||
+      typeof row.guid !== "string" ||
+      typeof row.created_at !== "string" ||
+      typeof row.text !== "string"
+    ) {
+      throw new Error("Invalid iMessage history row.");
+    }
+    return row as IMessageRow;
+  });
+}
+
+function parseNdjson(output: string): Record<string, unknown>[] {
+  if (!output) return [];
+  return output.split(/\r?\n/u).map((line) => {
+    const value: unknown = JSON.parse(line);
+    if (!value || typeof value !== "object" || Array.isArray(value)) {
+      throw new Error("Invalid iMessage NDJSON row.");
+    }
+    return value as Record<string, unknown>;
+  });
+}
+
+function includesAllParticipants(
+  chatParticipants: string[],
+  configuredParticipants: string[],
+): boolean {
+  const participants = new Set(
+    chatParticipants.map((value) => value.toLocaleLowerCase("en-US")),
+  );
+  return configuredParticipants.every((value) =>
+    participants.has(value.toLocaleLowerCase("en-US")),
+  );
+}
+
+function readCursor(state: ConnectorState, chatId: number): number {
+  const value = Number(state.latestIds?.[`chat:${chatId}`] ?? 0);
+  return Number.isSafeInteger(value) && value > 0 ? value : 0;
+}
+
+function deduplicateAndSort(
+  chats: IMessageChat[],
+  rowsByChat: Map<number, IMessageRow[]>,
+): NormalizedMessage[] {
+  const chatsById = new Map(chats.map((chat) => [chat.id, chat]));
+  const messages = new Map<string, NormalizedMessage>();
+  for (const rows of rowsByChat.values()) {
+    for (const row of rows) {
+      if (!messages.has(row.guid)) {
+        const chat = chatsById.get(row.chat_id);
+        if (!chat)
+          throw new Error(`Missing selected iMessage chat ${row.chat_id}.`);
+        messages.set(row.guid, normalizeMessage(row, chat));
+      }
+    }
+  }
+  return [...messages.values()].sort(
+    (left, right) =>
+      left.createdAt.localeCompare(right.createdAt) ||
+      left.thread.id - right.thread.id ||
+      left.id - right.id,
+  );
+}
+
+function normalizeMessage(
+  row: IMessageRow,
+  thread: IMessageChat,
+): NormalizedMessage {
+  const isFromMe = row.is_from_me === true;
+  const sender = isFromMe
+    ? "me"
+    : typeof row.sender === "string"
+      ? row.sender
+      : "";
+  const senderKey = sender.toLocaleLowerCase("en-US");
+  const recipients = isFromMe
+    ? thread.participants
+    : uniqueHandles([
+        "me",
+        ...thread.participants.filter(
+          (value) => value.toLocaleLowerCase("en-US") !== senderKey,
+        ),
+      ]);
+  return {
+    attachments: normalizeAttachments(row.attachments),
+    createdAt: row.created_at,
+    guid: row.guid,
+    id: row.id,
+    isFromMe,
+    recipients,
+    ...(typeof row.reply_to_guid === "string"
+      ? { replyToGuid: row.reply_to_guid }
+      : {}),
+    sender,
+    text: row.text,
+    thread,
+    ...(typeof row.thread_originator_guid === "string"
+      ? { threadOriginatorGuid: row.thread_originator_guid }
+      : {}),
+  };
+}
+
+function normalizeAttachments(values: unknown): NormalizedAttachment[] {
+  if (!Array.isArray(values)) return [];
+  return values.flatMap((value) => {
+    if (!value || typeof value !== "object" || Array.isArray(value)) return [];
+    const row = value as Record<string, unknown>;
+    const filename = stringValue(row.filename);
+    return [
+      withoutUndefined({
+        filename: filename ? basename(filename) : undefined,
+        transferName: stringValue(row.transfer_name),
+        uti: stringValue(row.uti),
+        mimeType: stringValue(row.mime_type),
+        byteSize: numberValue(row.byte_size),
+        isSticker: booleanValue(row.is_sticker),
+        missing: booleanValue(row.missing),
+      }),
+    ];
+  });
+}
+
+function withoutUndefined<T extends object>(value: T): T {
+  return Object.fromEntries(
+    Object.entries(value).filter(([, item]) => item !== undefined),
+  ) as T;
+}
+
+function stringValue(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function numberValue(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value)
+    ? value
+    : undefined;
+}
+
+function booleanValue(value: unknown): boolean | undefined {
+  return typeof value === "boolean" ? value : undefined;
+}
+
+function getNextCursors(
+  state: ConnectorState,
+  chats: IMessageChat[],
+  rowsByChat: Map<number, IMessageRow[]>,
+): Record<string, string> {
+  const cursors: Record<string, string> = {};
+  for (const chat of chats) {
+    const rows = rowsByChat.get(chat.id) ?? [];
+    const highest = rows.reduce((maximum, row) => Math.max(maximum, row.id), 0);
+    if (highest > readCursor(state, chat.id)) {
+      cursors[`chat:${chat.id}`] = String(highest);
+    }
+  }
+  return cursors;
+}
+
+function mapImsgError(
+  error: unknown,
+  operation: "chats" | "history",
+  chatId?: number,
+): string {
+  if (hasErrorCode(error, "ENOENT")) {
+    return "imsg is unavailable; install it and ensure it is on PATH.";
+  }
+  const stderr = getErrorStderr(error).toLocaleLowerCase("en-US");
+  if (
+    stderr.includes("unable to open database file") ||
+    stderr.includes("authorization denied")
+  ) {
+    return "imsg cannot read ~/Library/Messages/chat.db; grant Full Disk Access to the terminal or parent agent, then retry.";
+  }
+  if (operation === "chats" && !stderr) {
+    return "imsg chats failed without diagnostics; if running under launchd, grant Full Disk Access to the resolved dedicated launcher (run realpath on the first ProgramArguments executable), then retry.";
+  }
+  return operation === "chats"
+    ? "imsg chats failed."
+    : `imsg history failed for chat ${chatId}.`;
+}
+
+function hasErrorCode(error: unknown, code: string): boolean {
+  return Boolean(
+    error &&
+    typeof error === "object" &&
+    "code" in error &&
+    (error as NodeJS.ErrnoException).code === code,
+  );
+}
+
+function getErrorStderr(error: unknown): string {
+  if (!error || typeof error !== "object" || !("stderr" in error)) return "";
+  const stderr = (error as { stderr?: unknown }).stderr;
+  return typeof stderr === "string" || Buffer.isBuffer(stderr)
+    ? String(stderr)
+    : "";
+}
+
+function result(
+  runId: string,
+  status: ConnectorIngestResult["status"],
+  rawFiles: string[],
+  warnings: string[],
+  message: string,
+): ConnectorIngestResult {
+  return {
+    connectorId: "imessage",
+    message,
+    rawFiles,
+    runId,
+    statePath: "~/.openwiki/connectors/imessage/state.json",
+    status,
+    warnings,
+  };
+}
diff --git i/src/connectors/sources/links.ts w/src/connectors/sources/links.ts
new file mode 100644
index 0000000..2b07963
--- /dev/null
+++ w/src/connectors/sources/links.ts
@@ -0,0 +1,261 @@
+import { createHash } from "node:crypto";
+import {
+  createRunId,
+  readConnectorConfig,
+  readConnectorState,
+  updateStateWithRun,
+  writeConnectorState,
+  writeRawJson,
+} from "../io.js";
+import type {
+  ConnectorDefinition,
+  ConnectorIngestOptions,
+  ConnectorIngestResult,
+  ConnectorRuntime,
+} from "../types.js";
+
+type LinksConfig = {
+  links?: unknown[];
+};
+
+type LinkRecord = {
+  canonicalUrl: string;
+  capturedAt: string;
+  context?: string;
+  originalUrl: string;
+  source?: string;
+  sourceId: string;
+  title?: string;
+};
+
+const definition: ConnectorDefinition = {
+  backend: "local-file",
+  mode: "personal",
+  description:
+    "Reads a local queue of captured URLs and writes manifests for new or changed links.",
+  displayName: "Links",
+  id: "links",
+  requiredEnv: [],
+  supportsAgenticDiscovery: false,
+};
+
+const TRACKING_PARAMETER_NAMES = new Set([
+  "dclid",
+  "fbclid",
+  "gclid",
+  "mc_cid",
+  "mc_eid",
+  "msclkid",
+]);
+const SENSITIVE_PARAMETER_NAMES = new Set([
+  "access_token",
+  "api_key",
+  "apikey",
+  "auth",
+  "credential",
+  "key",
+  "password",
+  "secret",
+  "sig",
+  "signature",
+  "token",
+]);
+
+export function createLinksConnector(): ConnectorRuntime {
+  return {
+    ...definition,
+    ingest,
+  };
+}
+
+async function ingest(
+  options: ConnectorIngestOptions = {},
+): Promise<ConnectorIngestResult> {
+  const runId = createRunId();
+  const config = await readConnectorConfig<LinksConfig>("links", { links: [] });
+  const state = await readConnectorState("links");
+  const warnings: string[] = [];
+  const fileLinks = Array.isArray(config.links) ? config.links : [];
+  if (config.links !== undefined && !Array.isArray(config.links)) {
+    warnings.push("Ignored links config: links must be an array.");
+  }
+  const configuredLinks = [
+    ...getConfiguredLinks(options.connectorConfig),
+    ...fileLinks,
+  ];
+  const records = normalizeLinks(configuredLinks, warnings);
+  const fingerprints = Object.fromEntries(
+    records.map((record) => [record.sourceId, fingerprint(record)]),
+  );
+  const changedRecords = records.filter(
+    (record) =>
+      state.latestIds?.[record.sourceId] !== fingerprints[record.sourceId],
+  );
+  const rawFiles: string[] = [];
+
+  if (changedRecords.length > 0) {
+    rawFiles.push(
+      await writeRawJson("links", runId, "links.json", {
+        capturedAt: new Date().toISOString(),
+        links: changedRecords,
+      }),
+    );
+  }
+
+  const status = changedRecords.length > 0 ? "success" : "skipped";
+  const nextState = updateStateWithRun(state, {
+    at: new Date().toISOString(),
+    rawFiles,
+    runId,
+    status,
+    warnings,
+  });
+  nextState.latestIds = {
+    ...(state.latestIds ?? {}),
+    ...fingerprints,
+  };
+  await writeConnectorState("links", nextState);
+
+  return {
+    connectorId: "links",
+    message:
+      changedRecords.length > 0
+        ? `Wrote ${changedRecords.length} new or changed link(s).`
+        : configuredLinks.length === 0
+          ? "No links configured in ~/.openwiki/connectors/links/config.json."
+          : "No new or changed links.",
+    rawFiles,
+    runId,
+    statePath: "~/.openwiki/connectors/links/state.json",
+    status,
+    warnings,
+  };
+}
+
+function getConfiguredLinks(
+  connectorConfig: Record<string, unknown> | undefined,
+): unknown[] {
+  return Array.isArray(connectorConfig?.links) ? connectorConfig.links : [];
+}
+
+function normalizeLinks(values: unknown[], warnings: string[]): LinkRecord[] {
+  const records = new Map<string, LinkRecord>();
+
+  for (const [index, value] of values.entries()) {
+    const normalized = normalizeLink(value, index, warnings);
+    if (!normalized) {
+      continue;
+    }
+
+    const existing = records.get(normalized.canonicalUrl);
+    if (
+      !existing ||
+      Date.parse(normalized.capturedAt) >= Date.parse(existing.capturedAt)
+    ) {
+      records.set(normalized.canonicalUrl, normalized);
+    }
+  }
+
+  return [...records.values()].sort((left, right) =>
+    left.sourceId.localeCompare(right.sourceId),
+  );
+}
+
+function normalizeLink(
+  value: unknown,
+  index: number,
+  warnings: string[],
+): LinkRecord | null {
+  if (!isObject(value)) {
+    warnings.push(`Skipped link ${index + 1}: entry must be an object.`);
+    return null;
+  }
+
+  const originalUrl = getRequiredString(value.url);
+  const capturedAt = getRequiredString(value.capturedAt);
+  if (!originalUrl) {
+    warnings.push(`Skipped link ${index + 1}: url is required.`);
+    return null;
+  }
+  if (!capturedAt || !Number.isFinite(Date.parse(capturedAt))) {
+    warnings.push(
+      `Skipped link ${index + 1}: capture timestamp must be a valid date.`,
+    );
+    return null;
+  }
+
+  const canonicalUrl = canonicalizeUrl(originalUrl);
+  if (!canonicalUrl) {
+    warnings.push(
+      `Skipped link ${index + 1}: URL must use HTTP(S) without embedded credentials.`,
+    );
+    return null;
+  }
+
+  return {
+    canonicalUrl,
+    capturedAt,
+    ...getOptionalStringProperty(value, "context"),
+    originalUrl,
+    ...getOptionalStringProperty(value, "source"),
+    sourceId: `link-${sha256(canonicalUrl)}`,
+    ...getOptionalStringProperty(value, "title"),
+  };
+}
+
+function canonicalizeUrl(value: string): string | null {
+  try {
+    const url = new URL(value);
+    if (
+      (url.protocol !== "http:" && url.protocol !== "https:") ||
+      url.username.length > 0 ||
+      url.password.length > 0 ||
+      [...url.searchParams.keys()].some((name) =>
+        SENSITIVE_PARAMETER_NAMES.has(name.toLowerCase()),
+      )
+    ) {
+      return null;
+    }
+
+    url.hash = "";
+    for (const name of [...url.searchParams.keys()]) {
+      const normalizedName = name.toLowerCase();
+      if (
+        normalizedName.startsWith("utm_") ||
+        TRACKING_PARAMETER_NAMES.has(normalizedName)
+      ) {
+        url.searchParams.delete(name);
+      }
+    }
+    url.searchParams.sort();
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+function fingerprint(record: LinkRecord): string {
+  return sha256(JSON.stringify(record));
+}
+
+function sha256(value: string): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+function getRequiredString(value: unknown): string | null {
+  return typeof value === "string" && value.trim().length > 0
+    ? value.trim()
+    : null;
+}
+
+function getOptionalStringProperty<K extends "context" | "source" | "title">(
+  value: Record<string, unknown>,
+  key: K,
+): Partial<Record<K, string>> {
+  const normalized = getRequiredString(value[key]);
+  return normalized ? ({ [key]: normalized } as Record<K, string>) : {};
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
diff --git i/src/connectors/sources/rss.ts w/src/connectors/sources/rss.ts
new file mode 100644
index 0000000..5ad7a77
--- /dev/null
+++ w/src/connectors/sources/rss.ts
@@ -0,0 +1,657 @@
+import { createHash } from "node:crypto";
+import type { ReadableStream, ReadableStreamReadResult } from "node:stream/web";
+import { XMLParser } from "fast-xml-parser";
+import {
+  createRunId,
+  readConnectorConfig,
+  readConnectorState,
+  updateStateWithRun,
+  writeConnectorState,
+  writeRawJson,
+} from "../io.js";
+import type {
+  ConnectorDefinition,
+  ConnectorIngestOptions,
+  ConnectorIngestResult,
+  ConnectorRuntime,
+  ConnectorState,
+} from "../types.js";
+
+export type RssConfig = {
+  enabled?: boolean;
+  feedUrl?: string;
+  maxBytes?: number;
+  maxItems?: number;
+  timeoutMs?: number;
+};
+
+type RssEntryCursor = {
+  contentHash: string;
+  lastSeenAt: string;
+};
+
+type RssInstanceState = {
+  entries: Record<string, RssEntryCursor>;
+  etag?: string;
+  feedUrl: string;
+  lastModified?: string;
+  lastPublishedAt?: string;
+  lastSuccessAt: string;
+};
+
+type RssConnectorState = ConnectorState & {
+  rss?: {
+    instances: Record<string, RssInstanceState>;
+  };
+};
+
+type ParsedFeed = {
+  author: string | null;
+  entries: ParsedEntry[];
+  format: "atom" | "rss";
+  title: string | null;
+};
+
+type ParsedEntry = {
+  author: string | null;
+  content: string | null;
+  entryGuid: string | null;
+  entryUrl: string | null;
+  identity: string;
+  publishedAt: string | null;
+  title: string | null;
+};
+
+type EmittedEntry = ParsedEntry & {
+  capturedAt: string;
+  changeType: "changed" | "new";
+  feedUrl: string;
+  provenance: {
+    connectorId: "rss";
+    feedUrl: string;
+    sourceInstanceId: string;
+  };
+};
+
+const DEFAULT_MAX_BYTES = 2 * 1024 * 1024;
+const DEFAULT_MAX_ITEMS = 100;
+const DEFAULT_TIMEOUT_MS = 15_000;
+const MAX_MAX_BYTES = 10 * 1024 * 1024;
+const MAX_MAX_ITEMS = 500;
+const MAX_TIMEOUT_MS = 30_000;
+const MAX_STATE_ENTRIES = 5_000;
+const MIN_MAX_BYTES = 128;
+const MIN_TIMEOUT_MS = 100;
+const SECRET_QUERY_KEY =
+  /(?:^|[-_])(?:api[-_]?key|access[-_]?token|auth|authorization|credential|password|secret|signature|sig)(?:$|[-_])/iu;
+
+const definition: ConnectorDefinition = {
+  backend: "direct-api",
+  mode: "personal",
+  description:
+    "Fetches configured RSS and Atom subscriptions with conditional HTTP and entry cursors.",
+  displayName: "RSS / Atom",
+  id: "rss",
+  requiredEnv: [],
+  supportsAgenticDiscovery: false,
+};
+
+export function createRssConnector(): ConnectorRuntime {
+  return { ...definition, ingest };
+}
+
+export function normalizeRssFeedUrl(value: unknown): string {
+  if (typeof value !== "string" || value.trim().length === 0) {
+    throw new Error("Enter an RSS or Atom feed URL.");
+  }
+
+  let url: URL;
+  try {
+    url = new URL(value.trim());
+  } catch {
+    throw new Error("Enter a valid RSS or Atom feed URL.");
+  }
+
+  if (url.protocol !== "https:" && url.protocol !== "http:") {
+    throw new Error("RSS/Atom feed URLs must use HTTP or HTTPS.");
+  }
+  if (
+    url.username.length > 0 ||
+    url.password.length > 0 ||
+    [...url.searchParams.keys()].some((key) => SECRET_QUERY_KEY.test(key))
+  ) {
+    throw new Error(
+      "RSS/Atom feed URLs must not contain credentials or secret query parameters.",
+    );
+  }
+
+  url.hash = "";
+  return url.toString();
+}
+
+async function ingest(
+  options: ConnectorIngestOptions = {},
+): Promise<ConnectorIngestResult> {
+  const capturedAt = new Date().toISOString();
+  const runId = createRunId();
+  const rawFiles: string[] = [];
+  const warnings: string[] = [];
+  const instanceId = normalizeInstanceId(options.instanceId);
+  const baseConfig = await readConnectorConfig<RssConfig>("rss", {
+    enabled: true,
+    maxBytes: DEFAULT_MAX_BYTES,
+    maxItems: DEFAULT_MAX_ITEMS,
+    timeoutMs: DEFAULT_TIMEOUT_MS,
+  });
+  const config = normalizeConfig({
+    ...baseConfig,
+    ...((options.connectorConfig ?? {}) as RssConfig),
+    ...(options.limit === undefined ? {} : { maxItems: options.limit }),
+  });
+
+  if (!config.enabled) {
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "RSS/Atom connector is disabled.",
+    );
+  }
+
+  let feedUrl: string;
+  try {
+    feedUrl = normalizeRssFeedUrl(config.feedUrl);
+  } catch (error) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      getSafeConfigurationError(error),
+    );
+  }
+
+  const state = (await readConnectorState("rss")) as RssConnectorState;
+  const instances = state.rss?.instances ?? {};
+  const previous = instances[instanceId];
+  const cursor = previous?.feedUrl === feedUrl ? previous : undefined;
+  const headers = new Headers({
+    accept:
+      "application/atom+xml, application/rss+xml, application/xml, text/xml;q=0.9",
+    "user-agent": "OpenWiki RSS connector/1",
+  });
+  if (cursor?.etag) headers.set("if-none-match", cursor.etag);
+  if (cursor?.lastModified) {
+    headers.set("if-modified-since", cursor.lastModified);
+  }
+
+  let response: Response;
+  try {
+    response = await fetch(feedUrl, {
+      headers,
+      redirect: "follow",
+      signal: AbortSignal.timeout(config.timeoutMs),
+    });
+  } catch {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      `RSS/Atom fetch failed within timeoutMs=${config.timeoutMs}.`,
+    );
+  }
+
+  if (response.status === 304) {
+    await saveState(state, instances, instanceId, cursor, {
+      at: capturedAt,
+      rawFiles,
+      runId,
+      status: "skipped",
+      warnings,
+    });
+    return result(
+      runId,
+      "skipped",
+      rawFiles,
+      warnings,
+      "RSS/Atom feed was not modified.",
+    );
+  }
+
+  if (!response.ok) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      `RSS/Atom fetch failed with HTTP ${response.status}.`,
+    );
+  }
+
+  let xml: string;
+  try {
+    xml = await readBoundedBody(response, config.maxBytes);
+  } catch (error) {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      error instanceof FeedSizeError
+        ? `RSS/Atom feed exceeded maxBytes=${config.maxBytes}.`
+        : "RSS/Atom feed body could not be read.",
+    );
+  }
+
+  let feed: ParsedFeed;
+  try {
+    feed = parseFeed(xml, feedUrl, config.maxItems);
+  } catch {
+    return result(
+      runId,
+      "error",
+      rawFiles,
+      warnings,
+      "RSS/Atom feed could not be parsed.",
+    );
+  }
+
+  const previousEntries = cursor?.entries ?? {};
+  const nextEntries = { ...previousEntries };
+  const emittedEntries: EmittedEntry[] = [];
+  let changedEntries = 0;
+  let newEntries = 0;
+
+  for (const entry of feed.entries) {
+    const contentHash = hashEntry(entry);
+    const previousEntry = previousEntries[entry.identity];
+    const changeType = previousEntry
+      ? previousEntry.contentHash === contentHash
+        ? null
+        : "changed"
+      : "new";
+    nextEntries[entry.identity] = { contentHash, lastSeenAt: capturedAt };
+    if (changeType === null) continue;
+    if (changeType === "new") newEntries += 1;
+    else changedEntries += 1;
+    emittedEntries.push({
+      ...entry,
+      capturedAt,
+      changeType,
+      feedUrl,
+      provenance: {
+        connectorId: "rss",
+        feedUrl,
+        sourceInstanceId: instanceId,
+      },
+    });
+  }
+
+  const etag = response.headers.get("etag") ?? undefined;
+  const lastModified = response.headers.get("last-modified") ?? undefined;
+  const lastPublishedAt = getLatestPublishedAt(feed.entries);
+  const nextInstanceState: RssInstanceState = {
+    entries: trimEntryState(nextEntries),
+    ...(etag ? { etag } : {}),
+    feedUrl,
+    ...(lastModified ? { lastModified } : {}),
+    ...(lastPublishedAt ? { lastPublishedAt } : {}),
+    lastSuccessAt: capturedAt,
+  };
+
+  if (emittedEntries.length > 0) {
+    rawFiles.push(
+      await writeRawJson("rss", runId, `entries-${instanceId}.json`, {
+        capturedAt,
+        connectorId: "rss",
+        entries: emittedEntries,
+        feedUrl,
+        schemaVersion: 1,
+        sourceInstanceId: instanceId,
+      }),
+    );
+    rawFiles.push(
+      await writeRawJson("rss", runId, `manifest-${instanceId}.json`, {
+        capturedAt,
+        changedEntries,
+        connectorId: "rss",
+        emittedEntries: emittedEntries.length,
+        ...(etag ? { etag } : {}),
+        feedAuthor: feed.author,
+        feedFormat: feed.format,
+        feedTitle: feed.title,
+        feedUrl,
+        ...(lastModified ? { lastModified } : {}),
+        newEntries,
+        provenance: {
+          connectorId: "rss",
+          feedUrl,
+          sourceInstanceId: instanceId,
+        },
+        schemaVersion: 1,
+        sourceInstanceId: instanceId,
+      }),
+    );
+  }
+
+  const status = rawFiles.length > 0 ? "success" : "skipped";
+  await saveState(state, instances, instanceId, nextInstanceState, {
+    at: capturedAt,
+    rawFiles,
+    runId,
+    status,
+    warnings,
+  });
+
+  return result(
+    runId,
+    status,
+    rawFiles,
+    warnings,
+    emittedEntries.length > 0
+      ? `Captured ${emittedEntries.length} new or changed RSS/Atom entr${
+          emittedEntries.length === 1 ? "y" : "ies"
+        }.`
+      : "No new or changed RSS/Atom entries.",
+  );
+}
+
+function normalizeConfig(
+  config: RssConfig,
+): Required<
+  Pick<RssConfig, "enabled" | "maxBytes" | "maxItems" | "timeoutMs">
+> &
+  Pick<RssConfig, "feedUrl"> {
+  return {
+    enabled: config.enabled !== false,
+    feedUrl: config.feedUrl,
+    maxBytes: boundedInteger(
+      config.maxBytes,
+      DEFAULT_MAX_BYTES,
+      MIN_MAX_BYTES,
+      MAX_MAX_BYTES,
+    ),
+    maxItems: boundedInteger(
+      config.maxItems,
+      DEFAULT_MAX_ITEMS,
+      1,
+      MAX_MAX_ITEMS,
+    ),
+    timeoutMs: boundedInteger(
+      config.timeoutMs,
+      DEFAULT_TIMEOUT_MS,
+      MIN_TIMEOUT_MS,
+      MAX_TIMEOUT_MS,
+    ),
+  };
+}
+
+function boundedInteger(
+  value: number | undefined,
+  fallback: number,
+  minimum: number,
+  maximum: number,
+): number {
+  if (typeof value !== "number" || !Number.isFinite(value)) return fallback;
+  return Math.max(minimum, Math.min(maximum, Math.trunc(value)));
+}
+
+function normalizeInstanceId(value: string | undefined): string {
+  if (value === undefined) return "rss-1";
+  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$/u.test(value)) {
+    throw new Error("Invalid RSS/Atom source instance ID.");
+  }
+  return value;
+}
+
+class FeedSizeError extends Error {}
+
+async function readBoundedBody(
+  response: Response,
+  maxBytes: number,
+): Promise<string> {
+  const declaredLength = Number(response.headers.get("content-length"));
+  if (Number.isFinite(declaredLength) && declaredLength > maxBytes) {
+    throw new FeedSizeError();
+  }
+  if (!response.body) return "";
+
+  // Node's fetch body is the same Web stream but DOM and node:stream/web
+  // declarations are not structurally linked in every supported TS version.
+  const body = response.body as unknown as ReadableStream<Uint8Array>;
+  const reader = body.getReader();
+  const chunks: Uint8Array[] = [];
+  let totalBytes = 0;
+  while (true) {
+    const readResult: ReadableStreamReadResult<Uint8Array> =
+      await reader.read();
+    if (readResult.done) break;
+    const chunk = readResult.value;
+    totalBytes += chunk.byteLength;
+    if (totalBytes > maxBytes) {
+      await reader.cancel();
+      throw new FeedSizeError();
+    }
+    chunks.push(chunk);
+  }
+
+  const bytes = new Uint8Array(totalBytes);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+}
+
+function parseFeed(xml: string, feedUrl: string, maxItems: number): ParsedFeed {
+  const parser = new XMLParser({
+    attributeNamePrefix: "@_",
+    cdataPropName: "#cdata",
+    ignoreAttributes: false,
+    parseAttributeValue: false,
+    parseTagValue: false,
+    processEntities: false,
+    removeNSPrefix: true,
+    trimValues: true,
+  });
+  const document = parser.parse(xml) as Record<string, unknown>;
+  const atom = asRecord(document.feed);
+  const rssRoot = asRecord(document.rss);
+  const rssChannel = asRecord(rssRoot?.channel);
+  const rdf = asRecord(document.RDF);
+  const format = atom ? "atom" : "rss";
+  const feedNode = atom ?? rssChannel ?? rdf;
+  if (!feedNode) throw new Error("Missing feed root.");
+  const rawEntries = asArray(
+    format === "atom" ? feedNode.entry : (rssChannel?.item ?? rdf?.item),
+  ).slice(0, maxItems);
+
+  return {
+    author: extractAuthor(feedNode.author ?? feedNode.creator),
+    entries: rawEntries.map((rawEntry) =>
+      parseEntry(rawEntry, format, feedUrl),
+    ),
+    format,
+    title: extractText(feedNode.title),
+  };
+}
+
+function parseEntry(
+  value: unknown,
+  format: ParsedFeed["format"],
+  feedUrl: string,
+): ParsedEntry {
+  const entry = asRecord(value);
+  if (!entry) throw new Error("Invalid feed entry.");
+  const entryGuid = extractText(entry.guid ?? entry.id);
+  const entryUrl = extractEntryUrl(entry.link, format, feedUrl);
+  const title = extractText(entry.title);
+  const author = extractAuthor(entry.author ?? entry.creator);
+  const publishedAt = normalizeTimestamp(
+    extractText(
+      entry.published ?? entry.pubDate ?? entry.updated ?? entry.date,
+    ),
+  );
+  const content = extractText(
+    entry.content ?? entry.encoded ?? entry.description ?? entry.summary,
+  );
+  const identity = entryGuid
+    ? `guid:${entryGuid}`
+    : entryUrl
+      ? `url:${entryUrl}`
+      : `content:${hashValue({ author, content, publishedAt, title })}`;
+
+  return {
+    author,
+    content,
+    entryGuid,
+    entryUrl,
+    identity,
+    publishedAt,
+    title,
+  };
+}
+
+function extractEntryUrl(
+  value: unknown,
+  format: ParsedFeed["format"],
+  feedUrl: string,
+): string | null {
+  if (format === "rss") return resolveUrl(extractText(value), feedUrl);
+  const links = asArray(value);
+  const selected =
+    links.find((link) => {
+      const record = asRecord(link);
+      return record?.["@_rel"] === "alternate";
+    }) ?? links.find((link) => asRecord(link)?.["@_rel"] === undefined);
+  const record = asRecord(selected);
+  return resolveUrl(
+    extractText(record?.["@_href"] ?? record?.href ?? selected),
+    feedUrl,
+  );
+}
+
+function resolveUrl(value: string | null, feedUrl: string): string | null {
+  if (!value) return null;
+  try {
+    return new URL(value, feedUrl).toString();
+  } catch {
+    return value;
+  }
+}
+
+function extractAuthor(value: unknown): string | null {
+  const first = asArray(value)[0];
+  const record = asRecord(first);
+  return extractText(record?.name ?? first);
+}
+
+function extractText(value: unknown): string | null {
+  if (typeof value === "string" || typeof value === "number") {
+    const text = String(value).trim();
+    return text.length > 0 ? text : null;
+  }
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      const text = extractText(item);
+      if (text) return text;
+    }
+    return null;
+  }
+  const record = asRecord(value);
+  if (!record) return null;
+  return extractText(record["#text"] ?? record["#cdata"]);
+}
+
+function normalizeTimestamp(value: string | null): string | null {
+  if (!value) return null;
+  const milliseconds = Date.parse(value);
+  return Number.isFinite(milliseconds)
+    ? new Date(milliseconds).toISOString()
+    : value;
+}
+
+function hashEntry(entry: ParsedEntry): string {
+  return hashValue(entry);
+}
+
+function hashValue(value: unknown): string {
+  return createHash("sha256").update(JSON.stringify(value)).digest("hex");
+}
+
+function getLatestPublishedAt(entries: ParsedEntry[]): string | undefined {
+  return entries
+    .map((entry) => entry.publishedAt)
+    .filter((value): value is string => Boolean(value))
+    .sort()
+    .at(-1);
+}
+
+function trimEntryState(
+  entries: Record<string, RssEntryCursor>,
+): Record<string, RssEntryCursor> {
+  return Object.fromEntries(
+    Object.entries(entries)
+      .sort(
+        ([leftId, left], [rightId, right]) =>
+          right.lastSeenAt.localeCompare(left.lastSeenAt) ||
+          leftId.localeCompare(rightId),
+      )
+      .slice(0, MAX_STATE_ENTRIES),
+  );
+}
+
+async function saveState(
+  state: RssConnectorState,
+  instances: Record<string, RssInstanceState>,
+  instanceId: string,
+  instance: RssInstanceState | undefined,
+  run: NonNullable<ConnectorState["runs"]>[number],
+): Promise<void> {
+  const nextInstances = instance
+    ? { ...instances, [instanceId]: instance }
+    : instances;
+  await writeConnectorState("rss", {
+    ...updateStateWithRun(state, run),
+    rss: { instances: nextInstances },
+  } as RssConnectorState);
+}
+
+function result(
+  runId: string,
+  status: ConnectorIngestResult["status"],
+  rawFiles: string[],
+  warnings: string[],
+  message: string,
+): ConnectorIngestResult {
+  return {
+    connectorId: "rss",
+    message,
+    rawFiles,
+    runId,
+    statePath: "~/.openwiki/connectors/rss/state.json",
+    status,
+    warnings,
+  };
+}
+
+function getSafeConfigurationError(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  return message.startsWith("RSS/Atom") || message.startsWith("Enter an")
+    ? message
+    : "RSS/Atom feed configuration is invalid.";
+}
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function asArray(value: unknown): unknown[] {
+  if (value === undefined || value === null) return [];
+  return Array.isArray(value) ? value : [value];
+}
