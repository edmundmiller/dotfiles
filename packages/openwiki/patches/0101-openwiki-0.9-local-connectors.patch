+async function ensurePrivateConnectorHome(
+  connectorId: ConnectorId,
+): Promise<void> {
+  await ensureConnectorHome(connectorId);
+  if (!["discord", "imessage", "links", "rss"].includes(connectorId)) return;
+  const connectorDir = getConnectorDir(connectorId);
+  await Promise.all([
+    chmod(connectorDir, 0o700),
+    chmod(getConnectorRawDir(connectorId), 0o700),
+    chmod(getConnectorLogsDir(connectorId), 0o700),
+  ]);
+  const ignorePath = path.join(connectorDir, ".gitignore");
+  let existing = "";
+  try {
+    existing = await readFile(ignorePath, "utf8");
+  } catch (error) {
+    if (!isFileNotFoundError(error)) throw error;
+  }
+  if (!existing.split(/\r?\n/u).includes("*")) {
+    await writeFile(
+      ignorePath,
+      `${existing}${existing && !existing.endsWith("\n") ? "\n" : ""}*\n!.gitignore\n`,
+      { mode: 0o600 },
+    );
+  }
+  await chmod(ignorePath, 0o600);
+}
