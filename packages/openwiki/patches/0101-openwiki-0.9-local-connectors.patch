+import { describe, expect, test } from "vitest";
+import {
+  CONNECTOR_IDS,
+  createConnectorRegistry,
+  isConnectorId,
+} from "../../src/connectors/registry.js";
+import { createOpenWikiConnectorTools } from "../../src/connectors/tools.js";
+
+describe("local connector registration", () => {
+  test("registers all four connectors and exposes them in general tool schemas", () => {
+    const registry = createConnectorRegistry();
+    const tools = createOpenWikiConnectorTools();
+    const names = [
+      "openwiki_ingest_connector",
+      "openwiki_list_raw_items",
+      "openwiki_read_raw_item",
+    ];
+    for (const id of ["imessage", "links", "discord", "rss"] as const) {
+      expect(isConnectorId(id)).toBe(true);
+      expect(CONNECTOR_IDS).toContain(id);
+      expect(registry[id]).toMatchObject({ id, mode: "personal" });
+      for (const name of names) {
+        const tool = tools.find((item) => item.name === name);
+        expect(tool).toBeDefined();
+        const schema = tool?.schema;
+        expect(JSON.stringify(schema)).toContain(`"${id}"`);
+      }
+    }
+  });
+});
