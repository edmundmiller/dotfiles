diff --git a/scripts/patch-deepagents-path-guard.mjs b/scripts/patch-deepagents-path-guard.mjs
new file mode 100644
index 0000000..feb5efa
--- /dev/null
+++ b/scripts/patch-deepagents-path-guard.mjs
@@ -0,0 +1,16 @@
+import { readFile, writeFile } from "node:fs/promises";
+
+const files = [
+  "node_modules/deepagents/dist/src-CokGewqt.js",
+  "node_modules/deepagents/dist/src-CmBhLWZw.cjs",
+];
+const before = 'vpath.includes("..")';
+const after = 'vpath.split("/").includes("..")';
+
+for (const file of files) {
+  const source = await readFile(file, "utf8");
+  if (source.split(before).length !== 2) {
+    throw new Error(`Expected one DeepAgents path guard in ${file}`);
+  }
+  await writeFile(file, source.replace(before, after));
+}
