+    __: unknown,
+    ___: unknown,
+    run: () => Promise<unknown>,
+  ) => run(),
+}));
+import { runOpenWikiIngestion } from "../../src/ingestion/ingestion.ts";
+import { getConnectorRawDir } from "../../src/config/openwiki-home.ts";
+
+const exec = promisify(execFile);
+let repo: string;
+let wiki: string;
+async function git(...args: string[]) {
+  return (await exec("git", args, { cwd: repo })).stdout;
+}
+beforeEach(async () => {
+  repo = await mkdtemp(path.join(os.tmpdir(), "openwiki-scheduled-"));
+  wiki = path.join(repo, "wiki");
+  process.env.OPENWIKI_TEST_WIKI = wiki;
+  await git("init", "-q");
+  await git("config", "user.name", "Test");
+  await git("config", "user.email", "test@example.invalid");
+  await mkdir(wiki);
+  await writeFile(path.join(wiki, "page.md"), "before\n");
+  await git("add", ".");
+  await git("commit", "-qm", "initial");
+  pull.mockResolvedValue({
+    status: "success",
+    rawFiles: [path.join(getConnectorRawDir("git-repo"), "raw.json")],
+    message: "pulled",
+    runId: "pull-1",
+  });
+  agent.mockImplementation(
+    async (_command: string, cwd: string, options: OpenWikiRunOptions) => {
+      const backend = new OpenWikiLocalShellBackend({
+        outputMode: "local-wiki",
+        rootDir: cwd,
+        virtualMode: true,
+      });
+      await backend.write("/page.md", "after\n");
+      options.onWikiMutations?.(backend.getWikiMutations());
+      return { command: "update", model: "test" };
+    },
+  );
+});
+afterEach(async () => {
+  delete process.env.OPENWIKI_TEST_WIKI;
+  vi.clearAllMocks();
+  await rm(repo, { recursive: true, force: true });
+});
+test("scheduled ingestion commits backend-recorded changes with source trailers", async () => {
+  const events: string[] = [];
+  const result = await runOpenWikiIngestion(undefined, {
+    target: "all",
+    scheduledOnly: true,
+    onEvent: (event) => {
+      if (event.type === "text") events.push(event.text);
+    },
+  });
+  expect(result.results[0]?.status, events.join("")).toBe("agent-updated");
+  expect(await git("show", "HEAD:wiki/page.md")).toBe("after\n");
+  expect(await git("log", "-1", "--format=%B")).toContain(
+    "OpenWiki-Source-Instance: source-1",
+  );
+});
+test("scheduled ingestion rejects a dirty wiki before pulling", async () => {
+  await writeFile(path.join(wiki, "page.md"), "user work\n");
+  const head = await git("rev-parse", "HEAD");
+  const result = await runOpenWikiIngestion(undefined, {
+    target: "all",
+    scheduledOnly: true,
+  });
+  expect(result.results[0]?.status).toBe("error");
+  expect(pull).not.toHaveBeenCalled();
+  expect(agent).not.toHaveBeenCalled();
+  expect(await git("rev-parse", "HEAD")).toBe(head);
+});
