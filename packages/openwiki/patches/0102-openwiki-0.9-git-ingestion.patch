+        { id: "source-1", connectorId: "git-repo", connectedAt: "2026-01-01" },
+      ],
+      ingestionSchedule: {
+        expression: "0 2 * * *",
+        description: "daily",
+        updatedAt: "2026-01-01",
+      },
+    }),
+  ),
+}));
+vi.mock("../../src/connectors/registry.ts", () => ({
+  isConnectorId: (value: string) => value === "git-repo",
+  createConnectorRegistry: () => ({
+    "git-repo": {
+      id: "git-repo",
+      displayName: "Repo",
+      supportsAgenticDiscovery: false,
+      ingest: pull,
+    },
+  }),
+}));
+vi.mock("../../src/agent/index.ts", () => ({
+  createOpenWikiThreadId: () => "test",
+  runOpenWikiAgent: agent,
+}));
+vi.mock("../../src/telemetry/index.ts", () => ({
+  withRunTelemetry: (
