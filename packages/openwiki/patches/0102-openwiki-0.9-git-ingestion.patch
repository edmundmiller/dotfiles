diff --git c/src/ingestion/git-wiki-mutation.ts i/src/ingestion/git-wiki-mutation.ts
new file mode 100644
index 0000000..1b4f25f
--- /dev/null
+++ i/src/ingestion/git-wiki-mutation.ts
@@ -0,0 +1,368 @@
+import { spawn } from "node:child_process";
+import { createHash, randomUUID } from "node:crypto";
+import { lstat, readFile, realpath, rm } from "node:fs/promises";
+import path from "node:path";
+import type { ConnectorId } from "../connectors/types.js";
+import type { OpenWikiMutation, OpenWikiRunEvent } from "../agent/types.js";
+
+export type GitWikiSnapshot = {
+  dirtyPaths: Set<string>;
+  headOid: string;
+  repoRoot: string;
+  wikiPathspec: string;
+};
+
+export async function snapshotGitWiki(
+  cwd: string,
+): Promise<GitWikiSnapshot | null> {
+  let repoRoot: string;
+  try {
+    repoRoot = (await runGit(cwd, ["rev-parse", "--show-toplevel"])).trim();
+  } catch (error) {
+    if (isNotGitRepositoryError(error)) return null;
+    throw error;
+  }
+
+  repoRoot = await realpath(repoRoot);
+  const resolvedCwd = await realpath(cwd);
+  const wikiPathspec = path.relative(repoRoot, resolvedCwd) || ".";
+  if (
+    path.isAbsolute(wikiPathspec) ||
+    wikiPathspec === ".." ||
+    wikiPathspec.startsWith(`..${path.sep}`)
+  ) {
+    throw new Error(`OpenWiki directory is outside Git worktree: ${cwd}`);
+  }
+
+  const [dirtyPaths, headOid] = await Promise.all([
+    listGitDirtyPaths(repoRoot, wikiPathspec),
+    runGit(repoRoot, ["rev-parse", "HEAD"]).then((value) => value.trim()),
+  ]);
+  return {
+    dirtyPaths,
+    headOid,
+    repoRoot,
+    wikiPathspec,
+  };
+}
+
+export function assertGitWikiClean(snapshot: GitWikiSnapshot | null): void {
+  if (!snapshot || snapshot.dirtyPaths.size === 0) return;
+
+  const dirtyPaths = [...snapshot.dirtyPaths].sort();
+  const displayedPaths = dirtyPaths.slice(0, 5).join(", ");
+  const remainder =
+    dirtyPaths.length > 5 ? `, and ${dirtyPaths.length - 5} more` : "";
+  throw new Error(
+    `OpenWiki wiki must be clean before ingestion: ${displayedPaths}${remainder}`,
+  );
+}
+
+export async function commitGitWikiUpdate({
+  connectorId,
+  pullRunId,
+  emit,
+  snapshot,
+  sourceInstanceId,
+  wikiMutations,
+}: {
+  connectorId: ConnectorId;
+  pullRunId: string | undefined;
+  emit: ((event: OpenWikiRunEvent) => void) | undefined;
+  snapshot: GitWikiSnapshot | null;
+  sourceInstanceId: string;
+  wikiMutations: OpenWikiMutation[];
+}): Promise<void> {
+  if (!snapshot) return;
+
+  const staged = await runGit(snapshot.repoRoot, [
+    "diff",
+    "--cached",
+    "--name-only",
+    "-z",
+    "--",
+    `:(literal)${snapshot.wikiPathspec}`,
+  ]);
+  if (staged) throw new Error("OpenWiki wiki index changed during ingestion");
+  const after = await listGitDirtyPaths(
+    snapshot.repoRoot,
+    snapshot.wikiPathspec,
+  );
+  const changedPaths = [...after].sort();
+  if (changedPaths.length === 0) return;
+
+  const recordedMutations = await validateRecordedWikiMutations(
+    snapshot,
+    changedPaths,
+    wikiMutations,
+  );
+  const trailers = [
+    `OpenWiki-Connector: ${connectorId}`,
+    `OpenWiki-Source-Instance: ${sourceInstanceId}`,
+  ];
+  if (pullRunId) {
+    trailers.push(`OpenWiki-Pull-Run: ${pullRunId}`);
+  }
+  await commitRecordedWikiMutations(
+    snapshot,
+    changedPaths,
+    recordedMutations,
+    sourceInstanceId,
+    trailers,
+  );
+  try {
+    await runGit(snapshot.repoRoot, [
+      "reset",
+      "--mixed",
+      "HEAD",
+      "--",
+      ...changedPaths.map((filePath) => `:(literal)${filePath}`),
+    ]);
+  } catch (error) {
+    throw new Error(
+      `OpenWiki committed ${sourceInstanceId} but failed to refresh the real Git index: ${getErrorMessage(error)}`,
+      { cause: error },
+    );
+  }
+  emitText(
+    emit,
+    `Committed ${changedPaths.length} OpenWiki file(s) for ${sourceInstanceId}.\n`,
+  );
+}
+
+async function validateRecordedWikiMutations(
+  snapshot: GitWikiSnapshot,
+  changedPaths: string[],
+  wikiMutations: OpenWikiMutation[],
+): Promise<Map<string, OpenWikiMutation>> {
+  const recorded = new Map<string, OpenWikiMutation>();
+  for (const mutation of wikiMutations) {
+    const digest = createHash("sha256").update(mutation.content).digest("hex");
+    if (digest !== mutation.sha256) {
+      throw new Error(
+        `OpenWiki recorded an invalid mutation: ${mutation.path}`,
+      );
+    }
+    recorded.set(gitPathForMutation(snapshot, mutation.path), mutation);
+  }
+
+  const unrecorded = changedPaths.filter((filePath) => !recorded.has(filePath));
+  if (unrecorded.length > 0) {
+    throw new Error(
+      `OpenWiki found unrecorded wiki changes: ${unrecorded.slice(0, 5).join(", ")}`,
+    );
+  }
+
+  for (const filePath of changedPaths) {
+    const mutation = recorded.get(filePath);
+    if (!mutation) throw new Error(`Missing OpenWiki mutation: ${filePath}`);
+    const file = path.join(snapshot.repoRoot, ...filePath.split("/"));
+    const wikiRoot = await realpath(
+      path.join(snapshot.repoRoot, snapshot.wikiPathspec),
+    );
+    const actual = await realpath(file);
+    if (
+      (await lstat(file)).isSymbolicLink() ||
+      !actual.startsWith(`${wikiRoot}${path.sep}`)
+    ) {
+      throw new Error(
+        `OpenWiki mutation resolves outside the wiki or is a symlink: ${filePath}`,
+      );
+    }
+    const current = await readFile(file, "utf8");
+    if (current !== mutation.content) {
+      throw new Error(
+        `OpenWiki wiki file changed after the agent wrote it: ${filePath}`,
+      );
+    }
+  }
+  return recorded;
+}
+
+function gitPathForMutation(
+  snapshot: GitWikiSnapshot,
+  mutationPath: string,
+): string {
+  if (
+    !mutationPath ||
+    path.posix.isAbsolute(mutationPath) ||
+    mutationPath.split("/").includes("..")
+  ) {
+    throw new Error(`Invalid OpenWiki mutation path: ${mutationPath}`);
+  }
+  const wikiPathspec = snapshot.wikiPathspec.split(path.sep).join("/");
+  return wikiPathspec === "."
+    ? mutationPath
+    : path.posix.join(wikiPathspec, mutationPath);
+}
+
+async function commitRecordedWikiMutations(
+  snapshot: GitWikiSnapshot,
+  changedPaths: string[],
+  recorded: Map<string, OpenWikiMutation>,
+  sourceInstanceId: string,
+  trailers: string[],
+): Promise<void> {
+  const { repoRoot } = snapshot;
+  const realIndex = path.resolve(
+    repoRoot,
+    (await runGit(repoRoot, ["rev-parse", "--git-path", "index"])).trim(),
+  );
+  const temporaryIndex = `${realIndex}.openwiki-${randomUUID()}`;
+  const env = { GIT_INDEX_FILE: temporaryIndex };
+  try {
+    await runGit(repoRoot, ["read-tree", snapshot.headOid], { env });
+    for (const filePath of changedPaths) {
+      const mutation = recorded.get(filePath);
+      if (!mutation) throw new Error(`Missing OpenWiki mutation: ${filePath}`);
+      const objectId = (
+        await runGit(repoRoot, ["hash-object", "-w", "--stdin"], {
+          input: mutation.content,
+        })
+      ).trim();
+      await runGit(
+        repoRoot,
+        ["update-index", "--add", "--cacheinfo", "100644", objectId, filePath],
+        { env },
+      );
+    }
+    const treeOid = (await runGit(repoRoot, ["write-tree"], { env })).trim();
+    await runGit(repoRoot, ["hook", "run", "--ignore-missing", "pre-commit"], {
+      env,
+    });
+    const validatedTreeOid = (
+      await runGit(repoRoot, ["write-tree"], { env })
+    ).trim();
+    if (validatedTreeOid !== treeOid) {
+      throw new Error("OpenWiki pre-commit hook modified the temporary index");
+    }
+    const commitMessage = [
+      `docs(openwiki): ingest ${sourceInstanceId}`,
+      "",
+      ...trailers,
+      "",
+    ].join("\n");
+    const commitOid = (
+      await runGit(
+        repoRoot,
+        [
+          "-c",
+          "commit.gpgsign=false",
+          "-c",
+          "user.name=OpenWiki",
+          "-c",
+          "user.email=openwiki@localhost",
+          "commit-tree",
+          treeOid,
+          "-p",
+          snapshot.headOid,
+        ],
+        { input: commitMessage },
+      )
+    ).trim();
+    try {
+      await runGit(repoRoot, [
+        "update-ref",
+        "HEAD",
+        commitOid,
+        snapshot.headOid,
+      ]);
+    } catch (error) {
+      const currentHead = (
+        await runGit(repoRoot, ["rev-parse", "HEAD"])
+      ).trim();
+      if (currentHead !== snapshot.headOid) {
+        throw new Error("Git HEAD changed during OpenWiki ingestion", {
+          cause: error,
+        });
+      }
+      throw error;
+    }
+  } finally {
+    await rm(temporaryIndex, { force: true });
+  }
+}
+
+async function listGitDirtyPaths(
+  repoRoot: string,
+  wikiPathspec: string,
+): Promise<Set<string>> {
+  const literalWikiPathspec = `:(literal)${wikiPathspec}`;
+  const outputs = await Promise.all([
+    runGit(repoRoot, ["diff", "--name-only", "-z", "--", literalWikiPathspec]),
+    runGit(repoRoot, [
+      "diff",
+      "--cached",
+      "--name-only",
+      "-z",
+      "--",
+      literalWikiPathspec,
+    ]),
+    runGit(repoRoot, [
+      "ls-files",
+      "--others",
+      "--exclude-standard",
+      "-z",
+      "--",
+      literalWikiPathspec,
+    ]),
+  ]);
+  return new Set(
+    outputs.flatMap((output) => output.split("\0").filter(Boolean)),
+  );
+}
+
+async function runGit(
+  cwd: string,
+  args: string[],
+  options: { env?: NodeJS.ProcessEnv; input?: string } = {},
+): Promise<string> {
+  const child = spawn("git", args, {
+    cwd,
+    env: {
+      ...process.env,
+      ...options.env,
+      GIT_TERMINAL_PROMPT: "0",
+      LC_ALL: "C",
+    },
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  const stdout: Buffer[] = [];
+  const stderr: Buffer[] = [];
+  child.stdout.on("data", (chunk: Buffer) => stdout.push(chunk));
+  child.stderr.on("data", (chunk: Buffer) => stderr.push(chunk));
+  child.stdin.end(options.input);
+  const exitCode = await new Promise<number>((resolve, reject) => {
+    child.once("error", reject);
+    child.once("close", (code) => resolve(code ?? 1));
+  });
+  const stdoutText = Buffer.concat(stdout).toString("utf8");
+  if (exitCode !== 0) {
+    const stderrText = Buffer.concat(stderr).toString("utf8");
+    throw Object.assign(
+      new Error(`git ${args[0]} failed: ${stderrText.trim()}`),
+      { code: exitCode, stderr: stderrText },
+    );
+  }
+  return stdoutText;
+}
+
+function isNotGitRepositoryError(error: unknown): boolean {
+  return (
+    error instanceof Error &&
+    "code" in error &&
+    error.code === 128 &&
+    error.message.includes("not a git repository")
+  );
+}
+
+function getErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function emitText(
+  emit: ((event: OpenWikiRunEvent) => void) | undefined,
+  text: string,
+): void {
+  emit?.({ type: "text", text });
+}
