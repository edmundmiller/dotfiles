new file mode 100644
index 0000000..0d6ad5c
--- /dev/null
+++ w/test/agent/built-path-guard.test.ts
@@ -0,0 +1,79 @@
+import { execFileSync } from "node:child_process";
+import { createRequire } from "node:module";
+import {
+  mkdir,
+  mkdtemp,
+  readFile,
+  rm,
+  symlink,
+  writeFile,
+} from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { describe, expect, test } from "vitest";
+
+// Exercise the built backend with the installed pnpm-patched dependency.
+describe("built filesystem path guard", () => {
+  test("patch script refuses the installed shared dependency", () => {
+    const require = createRequire(import.meta.url);
+    const packageDir = path.dirname(require.resolve("deepagents/package.json"));
+    expect(() =>
+      execFileSync(
+        process.execPath,
+        ["scripts/patch-deepagents-path-guard.mjs", packageDir],
+        { stdio: "pipe" },
+      ),
+    ).toThrow(/Refusing to patch a node_modules directory or shared store/);
+  });
+  test("accepts consecutive periods and rejects traversal and symlink escapes", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "openwiki-path-guard-"));
+    const wiki = path.join(root, "wiki");
+    const outside = path.join(root, "outside");
+    try {
+      await mkdir(wiki);
+      await mkdir(outside);
+      await writeFile(path.join(outside, "secret.md"), "outside");
+      await symlink(outside, path.join(wiki, "link"));
+      const builtFile = path.resolve(
+        process.env.OPENWIKI_TEST_DIST ?? "dist",
+        "agent/docs-only-backend.js",
+      );
+      const { OpenWikiLocalShellBackend } = (await import(
+        pathToFileURL(builtFile).href
+      )) as typeof import("../../src/agent/docs-only-backend.js");
+      const backend = new OpenWikiLocalShellBackend({
+        rootDir: wiki,
+        virtualMode: true,
+        outputMode: "local-wiki",
+      });
+      const written = await backend.write("/note..md", "safe");
+      expect(written.error).toBeUndefined();
+      expect(await readFile(path.join(wiki, "note..md"), "utf8")).toBe("safe");
+      expect((await backend.readRaw("/note..md")).data?.content).toBe("safe");
+      expect(
+        (await backend.write("/..note.md", "also safe")).error,
+      ).toBeUndefined();
+      expect((await backend.readRaw("/..note.md")).data?.content).toBe(
+        "also safe",
+      );
+      for (const escape of [
+        "/../outside/secret.md",
+        "/sub/../../outside/secret.md",
+        "../outside/secret.md",
+        "/link/secret.md",
+      ]) {
+        const rejected = await backend.readRaw(escape).then(
+          (result: { error?: string }) => Boolean(result.error),
+          () => true,
+        );
+        expect(rejected).toBe(true);
+      }
+      expect(await readFile(path.join(outside, "secret.md"), "utf8")).toBe(
+        "outside",
+      );
+    } finally {
+      await rm(root, { recursive: true, force: true });
+    }
+  });
+});
