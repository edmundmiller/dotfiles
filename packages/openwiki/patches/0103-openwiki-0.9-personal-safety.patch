diff --git c/scripts/patch-deepagents-path-guard.mjs w/scripts/patch-deepagents-path-guard.mjs
new file mode 100644
index 0000000..03cced6
--- /dev/null
+++ w/scripts/patch-deepagents-path-guard.mjs
@@ -0,0 +1,64 @@
+import {
+  chmod,
+  lstat,
+  readFile,
+  readdir,
+  realpath,
+  stat,
+  writeFile,
+} from "node:fs/promises";
+import path from "node:path";
+import process from "node:process";
+
+// Run only on an isolated copy (for example a pnpm patch workspace), never on
+// node_modules or its shared store. The checked-in pnpm patch applies this at install.
+const directory = process.argv[2];
+if (!directory || !path.isAbsolute(directory)) {
+  throw new Error(
+    "Pass the absolute path to an isolated DeepAgents package copy.",
+  );
+}
+if ((await realpath(directory)).split(path.sep).includes("node_modules")) {
+  throw new Error(
+    "Refusing to patch a node_modules directory or shared store.",
+  );
+}
+const files = await readdir(path.join(directory, "dist"));
+const before = 'vpath.includes("..")';
+const after = 'vpath.replaceAll("\\\\", "/").split("/").includes("..")';
+let matches = 0;
+for (const file of files.filter((name) => /\.(?:js|cjs)$/u.test(name))) {
+  const filePath = path.join(directory, "dist", file);
+  const original = await readFile(filePath, "utf8");
+  const count = original.split(before).length - 1;
+  if (count > 1)
+    throw new Error(`Unexpected DeepAgents path guard count in ${file}`);
+  if (count === 1) {
+    if (
+      (await lstat(filePath)).isSymbolicLink() ||
+      !(await realpath(filePath)).startsWith(
+        `${await realpath(directory)}${path.sep}`,
+      )
+    ) {
+      throw new Error(`Refusing to patch a linked DeepAgents file: ${file}`);
+    }
+    await chmod(filePath, (await stat(filePath)).mode | 0o200);
+    const containment = 'relative.startsWith("..")';
+    const realContainment = 'realRelative.startsWith("..")';
+    if (
+      original.split(containment).length !== 4 ||
+      original.split(realContainment).length !== 2
+    )
+      throw new Error(`Unexpected DeepAgents containment guards in ${file}`);
+    await writeFile(
+      filePath,
+      original
+        .replace(before, after)
+        .replaceAll(containment, 'relative.split(/[\\\\/]/)[0] === ".."')
+        .replace(realContainment, 'realRelative.split(/[\\\\/]/)[0] === ".."'),
+    );
+    matches += 1;
+  }
+}
+if (matches !== 2)
+  throw new Error(`Expected ESM and CJS DeepAgents guards, found ${matches}`);
