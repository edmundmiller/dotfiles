+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+
+const ingest = vi.hoisted(() => vi.fn());
+const runOpenWikiAgent = vi.hoisted(() => vi.fn());
+
+vi.mock("../src/connectors/registry.js", () => ({
+  CONNECTOR_IDS: ["google", "imessage"],
+  createConnectorRegistry: () => ({
+    google: {
+      backend: "direct-api",
+      description: "deterministic test connector",
+      displayName: "Deterministic test connector",
+      id: "google",
+      ingest,
+      requiredEnv: [],
+      supportsAgenticDiscovery: false,
+    },
+    imessage: {
+      backend: "local-cli",
+      description: "deterministic iMessage test connector",
+      displayName: "iMessage",
+      id: "imessage",
+      ingest,
+      requiredEnv: [],
+      supportsAgenticDiscovery: false,
+    },
+  }),
+  isConnectorId: (value: string) => value === "google" || value === "imessage",
+}));
+
+vi.mock("../src/agent/index.js", () => ({
+  createOpenWikiThreadId: () => "test-thread",
+  runOpenWikiAgent,
+}));
+
+const originalHome = process.env.HOME;
+let home: string;
+
+beforeEach(async () => {
+  home = await mkdtemp(path.join(os.tmpdir(), "openwiki-ingestion-test-"));
+  process.env.HOME = home;
+  await mkdir(path.join(home, ".openwiki"), { recursive: true });
+  await writeFile(
+    path.join(home, ".openwiki", "onboarding.json"),
+    `${JSON.stringify({
+      sourceInstances: [
+        {
+          connectedAt: "2026-07-15T12:00:00.000Z",
+          connectorId: "google",
+          id: "deterministic-1",
+        },
+      ],
+      sources: {},
+      version: 1,
+    })}\n`,
+  );
+  ingest.mockReset();
+  runOpenWikiAgent.mockReset();
+  vi.resetModules();
+});
+
+afterEach(async () => {
+  if (originalHome === undefined) delete process.env.HOME;
+  else process.env.HOME = originalHome;
+  await rm(home, { recursive: true, force: true });
+});
+
+describe("deterministic ingestion", () => {
+  test("a skipped pull with no raw files does not invoke synthesis", async () => {
+    ingest.mockResolvedValue({
+      connectorId: "google",
+      message: "No new deterministic records.",
+      rawFiles: [],
+      runId: "run-1",
+      statePath: "~/.openwiki/connectors/google/state.json",
+      status: "skipped",
+      warnings: [],
+    });
+    const { runOpenWikiIngestion } = await import("../src/ingestion.ts");
+
+    const result = await runOpenWikiIngestion(home, {
+      target: { kind: "source-instance", id: "deterministic-1" },
+    });
+
+    expect(result.results).toEqual([
+      {
+        connectorId: "google",
+        deterministicPull: expect.objectContaining({
+          rawFiles: [],
+          status: "skipped",
+        }),
+        displayName: "Deterministic test connector",
+        rawFiles: [],
+        sourceInstanceId: "deterministic-1",
+        status: "skipped",
+      },
+    ]);
+    expect(runOpenWikiAgent).not.toHaveBeenCalled();
+  });
+  test("a saved iMessage source remains ingestible after onboarding reload", async () => {
+    await writeFile(
+      path.join(home, ".openwiki", "onboarding.json"),
+      `${JSON.stringify({
+        sourceInstances: [
+          {
+            connectedAt: "2026-07-15T12:00:00.000Z",
+            connectorConfig: { chatIds: [123] },
+            connectorId: "imessage",
+            id: "imessage-1",
+          },
+        ],
+        sources: {},
+        version: 1,
+      })}\n`,
+    );
+    ingest.mockResolvedValue({
+      connectorId: "imessage",
+      message: "No new iMessage messages in the configured scope.",
+      rawFiles: [],
+      runId: "run-2",
+      statePath: "~/.openwiki/connectors/imessage/state.json",
+      status: "skipped",
+      warnings: [],
+    });
+    // HOME-derived module constants require a fresh module graph in this test.
+    vi.resetModules();
+    const { runOpenWikiIngestion } = await import("../src/ingestion.ts");
+
+    const result = await runOpenWikiIngestion(home, { target: "imessage" });
+
+    expect(result.results).toEqual([
+      expect.objectContaining({
+        connectorId: "imessage",
+        sourceInstanceId: "imessage-1",
+        status: "skipped",
+      }),
+    ]);
+    expect(ingest).toHaveBeenCalledWith(
+      expect.objectContaining({
+        connectorConfig: { chatIds: [123] },
+        instanceId: "imessage-1",
+      }),
+    );
+    expect(runOpenWikiAgent).not.toHaveBeenCalled();
+  });
+});
