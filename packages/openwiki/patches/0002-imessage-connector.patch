+
+function message(
+  id: number,
+  chatId: number,
+  createdAt: string,
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    attachments: [],
+    chat_id: chatId,
+    created_at: createdAt,
+    guid: `message-guid-${id}`,
+    id,
+    is_from_me: false,
+    sender: "alice@example.com",
+    text: `message ${id}`,
+    ...overrides,
+  };
