+    const manifestPath = result.rawFiles.find((file) =>
+      file.endsWith("manifest.json"),
+    );
+    const manifest = JSON.parse(await readFile(manifestPath!, "utf8"));
+    expect(
+      manifest.threads.find((thread: { id: number }) => thread.id === 7),
+    ).toMatchObject({
+      cursorBefore: "10",
+      cursorAfter: "10",
+      messageCount: 0,
+    });
+  });
+
+  test("malformed history fails without raw files or cursor advancement", async () => {
+    execFileAsync
+      .mockResolvedValueOnce({
+        stdout: ndjson([chat(7, ["alice@example.com"])]),
+        stderr: "",
+      })
+      .mockResolvedValueOnce({
+        stdout: ndjson([{ id: 10, chat_id: 7, guid: "missing-fields" }]),
+        stderr: "",
+      });
+    const connector = await loadConnector();
+
+    await expect(
+      connector.ingest({ connectorConfig: { chatIds: [7] } }),
+    ).resolves.toMatchObject({
+      message: "imsg history failed for chat 7.",
+      rawFiles: [],
+      status: "error",
+    });
+    await expect(connectorState()).rejects.toMatchObject({ code: "ENOENT" });
+  });
+
+  test("fails closed at the per-chat limit without writing or advancing state", async () => {
+    mockImsg([chat(7, ["alice@example.com"])], {
+      7: [
+        message(10, 7, "2026-07-15T10:00:00.000Z"),
+        message(11, 7, "2026-07-15T11:00:00.000Z"),
+      ],
+    });
+    const connector = await loadConnector();
+    const result = await connector.ingest({
+      connectorConfig: { chatIds: [7], maxMessagesPerChat: 2 },
+    });
+
+    expect(result).toMatchObject({
+      message:
+        "iMessage history reached maxMessagesPerChat=2 for chat 7; increase the limit or narrow the time window.",
+      rawFiles: [],
+      status: "error",
+    });
+    await expect(connectorState()).rejects.toMatchObject({ code: "ENOENT" });
+  });
+
+  test("maps missing imsg and Full Disk Access failures without leaking stderr", async () => {
+    const connector = await loadConnector();
+    const missing = Object.assign(new Error("spawn imsg ENOENT"), {
+      code: "ENOENT",
+    });
+    execFileAsync.mockRejectedValueOnce(missing);
+    await expect(
+      connector.ingest({ connectorConfig: { chatIds: [7] } }),
+    ).resolves.toMatchObject({
+      message: "imsg is unavailable; install it and ensure it is on PATH.",
+      status: "error",
+    });
+
+    execFileAsync.mockRejectedValueOnce(
+      Object.assign(new Error("private body"), {
+        stderr: "authorization denied: private database path",
+      }),
+    );
+    await expect(
+      connector.ingest({ connectorConfig: { chatIds: [7] } }),
+    ).resolves.toMatchObject({
+      message:
+        "imsg cannot read ~/Library/Messages/chat.db; grant Full Disk Access to the terminal or parent agent, then retry.",
+      status: "error",
+    });
+  });
+
+  test("maps silent launchd access failures to actionable guidance", async () => {
+    const connector = await loadConnector();
+    execFileAsync.mockRejectedValueOnce(
+      Object.assign(new Error("imsg exited with status 1"), {
+        code: 1,
+        stderr: "",
+      }),
+    );
+
+    await expect(
+      connector.ingest({ connectorConfig: { chatIds: [7] } }),
+    ).resolves.toMatchObject({
+      message:
+        "imsg chats failed without diagnostics; if running under launchd, grant Full Disk Access to the resolved dedicated launcher (run realpath on the first ProgramArguments executable), then retry.",
+      status: "error",
+    });
+  });
+
+  test("repairs the connector gitignore and ignores private raw data", async () => {
+    const connectorDir = path.join(home, ".openwiki/connectors/imessage");
+    await mkdir(connectorDir, { recursive: true });
+    await writeFile(path.join(connectorDir, ".gitignore"), "raw/\n");
+    const { ensureConnectorHome } = await import("../src/openwiki-home.ts");
+
+    await ensureConnectorHome("imessage");
+    const ignorePath = path.join(connectorDir, ".gitignore");
+    expect(await readFile(ignorePath, "utf8")).toBe("*\n!.gitignore\n");
+    expect((await stat(ignorePath)).mode & 0o777).toBe(0o600);
+
+    const rawPath = path.join(connectorDir, "raw", "run", "messages.json");
+    await mkdir(path.dirname(rawPath), { recursive: true });
+    await writeFile(rawPath, "{}\n");
+    expect(
+      execFileSync("git", ["check-ignore", "-q", rawPath], {
+        cwd: home,
+      }).toString(),
+    ).toBe("");
+  });
+});
