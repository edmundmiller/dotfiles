+#[async_trait]
+impl ModelClient for RotatingCredentialModelClient {
+    async fn complete(&self, request: ModelRequest) -> exoharness::Result<ModelResponse> {
+        self.requests
+            .lock()
+            .expect("requests should not be poisoned")
+            .push(request);
+        let rotated_key = self
+            .rotated_keys
+            .lock()
+            .expect("rotated keys should not be poisoned")
