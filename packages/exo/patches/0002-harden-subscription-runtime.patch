+            secret_id,
+            rotated_keys: Arc::new(Mutex::new(VecDeque::from(rotated_keys))),
+            responses: Arc::new(Mutex::new(VecDeque::from(responses))),
+            requests: Arc::new(Mutex::new(Vec::new())),
+        }
+    }
