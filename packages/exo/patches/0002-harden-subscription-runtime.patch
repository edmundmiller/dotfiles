+type RefreshLocks = Mutex<HashMap<SecretId, Arc<Mutex<()>>>>;
+static REFRESH_LOCKS: OnceLock<RefreshLocks> = OnceLock::new();
+
+pub(crate) async fn resolve_chatgpt_auth(
+    conversation: &dyn ConversationHandle,
+    secret_id: &SecretId,
+) -> Result<ChatGptModelAuth> {
+    resolve_chatgpt_auth_with(
+        conversation,
+        secret_id,
+        |refresh_token, account_id| async move {
+            let client = Client::builder().timeout(HTTP_TIMEOUT).build()?;
+            refresh_chatgpt_with(&client, ISSUER, &refresh_token, Some(&account_id)).await
+        },
+    )
+    .await
+}
+
+// All native requests and TS child runners resolve in this host process. Hold
+// one lock across read, token redemption, and persistence, not just the write.
+async fn resolve_chatgpt_auth_with<F, Fut>(
+    conversation: &dyn ConversationHandle,
+    secret_id: &SecretId,
+    refresh: F,
+) -> Result<ChatGptModelAuth>
+where
+    F: FnOnce(String, String) -> Fut,
+    Fut: Future<Output = Result<Secret>>,
+{
+    let lock = REFRESH_LOCKS
+        .get_or_init(RefreshLocks::default)
+        .lock()
+        .await
+        .entry(secret_id.clone())
+        .or_default()
+        .clone();
+    let _guard = lock.lock().await;
+    let Some(Secret::ChatGpt {
+        access_token,
+        refresh_token,
+        expires_at_ms,
+        account_id,
+    }) = conversation.get_secret(secret_id).await?
+    else {
+        anyhow::bail!("model secret is not a ChatGPT subscription secret");
+    };
+    if expires_at_ms > chrono::Utc::now().timestamp_millis() + 60_000 {
+        return Ok(ChatGptModelAuth {
+            access_token,
+            account_id,
+        });
+    }
+    let updated = refresh(refresh_token, account_id).await?;
+    let Secret::ChatGpt {
+        access_token,
+        account_id,
+        ..
+    } = &updated
+    else {
+        anyhow::bail!("ChatGPT refresh returned a non-subscription secret");
+    };
+    let auth = ChatGptModelAuth {
+        access_token: access_token.clone(),
+        account_id: account_id.clone(),
+    };
+    conversation.update_secret(secret_id, updated).await?;
+    Ok(auth)
 }
 
