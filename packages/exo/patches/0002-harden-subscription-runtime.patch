index 0000000..dccf12c
--- /dev/null
+++ b/exoharness/typescript/harness/runner.test.ts
@@ -0,0 +1,125 @@
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import readline from "node:readline";
+import { expect, it } from "vitest";
+
+it("streams correlated host chunks before request completion and propagates errors", async () => {
+  const directory = await mkdtemp(path.join(tmpdir(), "exo-chatgpt-runner-"));
+  const modulePath = path.join(directory, "harness.mjs");
+  await writeFile(
+    modulePath,
+    `export default {
+    async runTurn(context) {
+      for (const handle of [context.exoharness, context.exoharness.current.agent, context.exoharness.current.conversation]) {
+        if ('updateSecret' in handle) throw new Error('guest can update credentials');
+      }
+      await context.chatgptRequest('first', (data) => {
+        void context.stream.text(new TextDecoder().decode(data));
+      });
+      try {
+        await context.chatgptRequest('second', () => {});
+        throw new Error('host failure was ignored');
+      } catch (error) {
+        if (error.message !== 'host refresh failed') throw error;
+      }
+    }
+  };`,
+  );
+  const child = spawn(
+    process.execPath,
+    [
+      "--import",
+      "tsx",
+      path.resolve("exoharness/typescript/harness/runner.ts"),
+      modulePath,
+    ],
+    { stdio: ["pipe", "pipe", "pipe"], timeout: 5_000 },
+  );
+  const exited = once(child, "exit");
+  const lines = readline.createInterface({ input: child.stdout });
+  let stderr = "";
+  child.stderr.on("data", (data) => {
+    stderr += data;
+  });
+  const send = (message: unknown) =>
+    child.stdin.write(`${JSON.stringify(message)}\n`);
+  const conversation = { agent_id: "agent", record: { id: "conversation" } };
+  send({
+    kind: "init",
+    payload: {
+      agent: { id: "agent", slug: "agent", name: "Agent" },
+      conversation,
+      turn: { conversation, record: { id: "turn", session_id: "session" } },
+      agent_config: {
+        instructions: [],
+        harness: "typescript",
+        model: "chatgpt",
+        sandbox: {
+          provider: "local_process",
+          enable_networking: false,
+          scope: "conversation",
+        },
+      },
+      conversation_config: { mounts: [] },
+      request: { input: [] },
+      streaming: true,
+    },
+  });
+  let firstId: number | undefined;
+  let sawTextBeforeCompletion = false;
+  let done = false;
+  try {
+    for await (const line of lines) {
+      const message = JSON.parse(line);
+      if (
+        message.kind === "runtime_request" &&
+        message.request.body === "first"
+      ) {
+        firstId = message.id;
+        send({
+          kind: "chatgpt_chunk",
+          id: message.id,
+          data: Array.from(new TextEncoder().encode("live text")),
+        });
+        // Deliberately withhold completion until the guest forwards the chunk.
+      } else if (message.kind === "stream_event") {
+        expect(message.event).toEqual({
+          type: "text_delta",
+          text: "live text",
+        });
+        sawTextBeforeCompletion = true;
+        send({
+          kind: "runtime_response",
+          id: firstId,
+          ok: true,
+          payload: { type: "unit" },
+        });
+      } else if (
+        message.kind === "runtime_request" &&
+        message.request.body === "second"
+      ) {
+        expect(message.id).not.toBe(firstId);
+        send({
+          kind: "runtime_response",
+          id: message.id,
+          ok: false,
+          error: "host refresh failed",
+        });
+      } else if (message.kind === "done") {
+        done = true;
+        child.stdin.end(`${JSON.stringify({ kind: "shutdown" })}\n`);
+      } else {
+        throw new Error(`Unexpected runner message: ${line}`);
+      }
+    }
+    expect(await exited, stderr).toEqual([0, null]);
+    expect(done && sawTextBeforeCompletion).toBe(true);
+  } finally {
+    child.kill();
+    lines.close();
+    await rm(directory, { recursive: true, force: true });
+  }
+}, 10_000);
