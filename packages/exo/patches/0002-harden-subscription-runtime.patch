+        if let Some(value) = rotated_key {
+            self.exoharness
+                .update_secret(&self.secret_id, rotating_subscription(value))
+                .await?;
+        }
+        self.responses
+            .lock()
+            .expect("responses should not be poisoned")
+            .pop_front()
