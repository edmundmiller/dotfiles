+impl RouterModelClient {
+    async fn complete_chatgpt_stream(
+        &self,
+        request: ModelRequest,
+    ) -> Result<Box<dyn ModelResponseStream>> {
+        let auth = request
+            .chatgpt
+            .as_ref()
+            .ok_or_else(|| anyhow::anyhow!("missing ChatGPT credentials"))?;
+        let payload = build_codex_request(&request)?;
+        let response = reqwest::Client::new()
+            .post(crate::chatgpt::CODEX_ENDPOINT)
+            .bearer_auth(&auth.access_token)
+            .header("ChatGPT-Account-Id", &auth.account_id)
+            .header("originator", "exo")
+            .header("Accept", "text/event-stream")
+            .header("User-Agent", "exo")
+            .json(&payload)
+            .send()
+            .await?;
+        if !response.status().is_success() {
+            anyhow::bail!("ChatGPT Codex request failed ({})", response.status());
+        }
+        Ok(Box::new(ChatGptResponseStream {
+            raw: Box::pin(response.bytes_stream()),
+            buffer: Vec::new(),
+            response: None,
+        }))
+    }
+}
+
+fn build_codex_request(request: &ModelRequest) -> Result<CodexRequest> {
+    let mut universal = build_universal_request(request, true)?;
+    let mut instructions = Vec::new();
+    for message in &universal.messages {
+        if let Message::System { content } | Message::Developer { content } = message {
+            match content {
+                UserContent::String(text) => instructions.push(text.clone()),
+                UserContent::Array(parts) => {
+                    for part in parts {
+                        match part {
+                            UserContentPart::Text(text) => instructions.push(text.text.clone()),
+                            _ => anyhow::bail!("ChatGPT instructions must contain only text"),
+                        }
+                    }
+                }
+            }
+        }
+    }
+    universal
+        .messages
+        .retain(|message| !matches!(message, Message::System { .. } | Message::Developer { .. }));
+    let bytes = serialize_request(ProviderFormat::Responses, &universal)?;
+    let mut payload: CodexRequest = lingua_json::from_slice(&bytes)?;
+    payload.instructions = Some(instructions.join("\n\n"));
+    payload.include = Some(vec!["reasoning.encrypted_content".to_string()]);
+    payload.stream = true;
+    payload.store = false;
+    for tool in payload.tools.iter_mut().flatten() {
+        tool.strict = Some(false);
+    }
+    Ok(payload)
+}
