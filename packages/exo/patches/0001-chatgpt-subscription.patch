+type HttpByteStream = Pin<Box<dyn Stream<Item = reqwest::Result<Bytes>> + Send>>;
+
+struct ChatGptResponseStream {
+    raw: HttpByteStream,
+    buffer: Vec<u8>,
+    response: Option<UniversalResponse>,
+}
+
+#[derive(Deserialize)]
+struct CodexEventKind {
+    r#type: String,
+    response: Option<lingua_json::Value>,
+}
