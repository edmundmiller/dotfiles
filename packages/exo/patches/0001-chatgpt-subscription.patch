+#[async_trait]
+impl ModelResponseStream for ChatGptResponseStream {
+    async fn next_chunk(&mut self) -> Result<Option<UniversalStreamChunk>> {
+        loop {
+            if self.response.is_some() {
+                return Ok(None);
+            }
+            if let Some(data) = take_sse_data(&mut self.buffer) {
+                if data == b"[DONE]" {
+                    anyhow::bail!("ChatGPT stream ended without a completed response");
+                }
+                let event: CodexEventKind = lingua_json::from_slice(&data)?;
+                match event.r#type.as_str() {
+                    "error" | "response.failed" | "response.incomplete" => {
+                        anyhow::bail!("ChatGPT stream failed ({})", event.r#type);
+                    }
+                    "response.completed" => {
+                        let response = event.response.ok_or_else(|| {
+                            anyhow::anyhow!("ChatGPT completion omitted response")
+                        })?;
+                        // The final response retains encrypted reasoning and complete
+                        // tool arguments that the streaming deltas do not preserve.
+                        self.response = Some(lingua::response_to_universal(Bytes::from(
+                            lingua_json::to_vec(&response)?,
+                        ))?);
+                    }
+                    _ => {}
+                }
+                let parsed = lingua::parse_stream_event(
+                    Bytes::from(data),
+                    ProviderFormat::Responses,
+                    ProviderFormat::Responses,
+                )?;
+                if let Some(chunk) = parsed.universal {
+                    return Ok(Some(chunk));
+                }
+                continue;
+            }
+            let Some(bytes) = self.raw.next().await.transpose()? else {
+                anyhow::bail!("ChatGPT stream closed before response.completed");
+            };
+            self.buffer.extend_from_slice(&bytes);
+        }
+    }
+
+    async fn finish(self: Box<Self>) -> Result<ModelResponse> {
+        normalize_model_response(
+            self.response
+                .ok_or_else(|| anyhow::anyhow!("ChatGPT stream has not completed"))?,
+        )
+    }
+}
+
+fn take_sse_data(buffer: &mut Vec<u8>) -> Option<Vec<u8>> {
+    loop {
+        let (end, delimiter) = buffer
+            .windows(2)
+            .position(|w| w == b"\n\n")
+            .map(|end| (end, 2))
+            .into_iter()
+            .chain(
+                buffer
+                    .windows(4)
+                    .position(|w| w == b"\r\n\r\n")
+                    .map(|end| (end, 4)),
+            )
+            .min_by_key(|(end, _)| *end)?;
+        let event = buffer.drain(..end + delimiter).collect::<Vec<_>>();
+        let lines: Vec<&[u8]> = event
+            .split(|byte| *byte == b'\n')
+            .filter_map(|line| {
+                let line = line.strip_suffix(b"\r").unwrap_or(line);
+                line.strip_prefix(b"data:")
+                    .map(|data| data.strip_prefix(b" ").unwrap_or(data))
+            })
+            .collect();
+        if !lines.is_empty() {
+            return Some(lines.join(&b'\n'));
+        }
+    }
+}
