+      !payload.access_token.trim() ||
+      typeof payload.expires_in !== "number" ||
+      !Number.isFinite(payload.expires_in) ||
+      payload.expires_in <= 0 ||
+      (payload.refresh_token !== undefined &&
+        (typeof payload.refresh_token !== "string" ||
+          !payload.refresh_token.trim()))
+    ) {
+      throw new Error("ChatGPT token refresh returned an invalid response");
+    }
+    const updated = {
+      ...secret,
+      accessToken: payload.access_token,
+      refreshToken: payload.refresh_token ?? secret.refreshToken,
+      expiresAtMs: Date.now() + payload.expires_in * 1000,
+    };
+    await context.exoharness.current.conversation.updateSecret(
+      secretId,
+      updated,
+    );
+    return updated;
+  })();
+  chatgptRefreshes.set(secretId, refresh);
+  try {
+    return await refresh;
