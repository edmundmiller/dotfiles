index 0000000..b1ebe6e
--- /dev/null
+++ b/crates/executor/src/chatgpt.rs
@@ -0,0 +1,411 @@
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use base64::Engine;
+use exoharness::{Result, Secret};
+use reqwest::{Client, StatusCode};
+use serde::{Deserialize, Serialize};
+
+pub(crate) const CODEX_ENDPOINT: &str = "https://chatgpt.com/backend-api/codex/responses";
+const ISSUER: &str = "https://auth.openai.com";
+const CLIENT_ID: &str = "app_EMoamEEZ73f0CkXaXp7hrann";
+const DEVICE_REDIRECT_URI: &str = "https://auth.openai.com/deviceauth/callback";
+const DEVICE_AUTH_TIMEOUT: Duration = Duration::from_secs(15 * 60);
+const HTTP_TIMEOUT: Duration = Duration::from_secs(30);
+
+#[derive(Debug, Deserialize)]
+struct DeviceCodeResponse {
+    device_auth_id: String,
+    user_code: String,
+    interval: DeviceInterval,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(untagged)]
+enum DeviceInterval {
+    String(String),
+    Number(u64),
+}
+
+impl DeviceInterval {
+    fn seconds(&self) -> u64 {
+        match self {
+            Self::String(value) => value.trim().parse().unwrap_or(5),
+            Self::Number(value) => *value,
+        }
+        .max(1)
+    }
+}
+
+#[derive(Debug, Serialize)]
+struct DeviceCodeRequest<'a> {
+    client_id: &'a str,
+}
+
+#[derive(Debug, Serialize)]
+struct DevicePollRequest<'a> {
+    device_auth_id: &'a str,
+    user_code: &'a str,
+}
+
+#[derive(Debug, Deserialize)]
+struct DevicePollResponse {
+    authorization_code: String,
+    code_verifier: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct TokenResponse {
+    access_token: String,
+    refresh_token: Option<String>,
+    expires_in: Option<i64>,
+    id_token: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct JwtClaims {
+    chatgpt_account_id: Option<String>,
+    organizations: Option<Vec<OrganizationClaim>>,
+    #[serde(rename = "https://api.openai.com/auth")]
+    openai_auth: Option<OpenAiAuthClaims>,
+}
+
+#[derive(Debug, Deserialize)]
+struct OrganizationClaim {
+    id: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct OpenAiAuthClaims {
+    chatgpt_account_id: Option<String>,
+}
+
+pub async fn login_chatgpt_device(on_prompt: impl Fn(&str, &str)) -> Result<Secret> {
+    let client = Client::builder().timeout(HTTP_TIMEOUT).build()?;
+    tokio::time::timeout(
+        DEVICE_AUTH_TIMEOUT,
+        login_chatgpt_device_with(&client, ISSUER, on_prompt),
+    )
+    .await
+    .map_err(|_| anyhow::anyhow!("ChatGPT device authorization timed out"))?
+}
+
+async fn login_chatgpt_device_with(
+    client: &Client,
+    issuer: &str,
+    on_prompt: impl Fn(&str, &str),
+) -> Result<Secret> {
+    let response = client
+        .post(format!("{issuer}/api/accounts/deviceauth/usercode"))
+        .timeout(HTTP_TIMEOUT)
+        .json(&DeviceCodeRequest {
+            client_id: CLIENT_ID,
+        })
+        .send()
+        .await?;
+    let response = response.error_for_status()?;
+    let device: DeviceCodeResponse = response.json().await?;
+    require_nonempty(&device.device_auth_id, "device_auth_id")?;
+    require_nonempty(&device.user_code, "user_code")?;
+    let interval = device.interval.seconds();
+    on_prompt(&format!("{issuer}/codex/device"), &device.user_code);
+
+    let code = loop {
+        let response = client
+            .post(format!("{issuer}/api/accounts/deviceauth/token"))
+            .timeout(HTTP_TIMEOUT)
+            .json(&DevicePollRequest {
+                device_auth_id: &device.device_auth_id,
+                user_code: &device.user_code,
+            })
+            .send()
+            .await?;
+        if response.status().is_success() {
+            break response.json::<DevicePollResponse>().await?;
+        }
+        if !matches!(
+            response.status(),
+            StatusCode::FORBIDDEN | StatusCode::NOT_FOUND
+        ) {
+            anyhow::bail!(
+                "ChatGPT device authorization failed ({})",
+                response.status()
+            );
+        }
+        tokio::time::sleep(Duration::from_secs(interval + 3)).await;
+    };
+    require_nonempty(&code.authorization_code, "authorization_code")?;
+    require_nonempty(&code.code_verifier, "code_verifier")?;
+
+    let token = client
+        .post(format!("{issuer}/oauth/token"))
+        .timeout(HTTP_TIMEOUT)
+        .form(&[
+            ("grant_type", "authorization_code"),
+            ("code", code.authorization_code.as_str()),
+            ("redirect_uri", DEVICE_REDIRECT_URI),
+            ("client_id", CLIENT_ID),
+            ("code_verifier", code.code_verifier.as_str()),
+        ])
+        .send()
+        .await?
+        .error_for_status()?
+        .json::<TokenResponse>()
+        .await?;
+    secret_from_token(token, None, None)
+}
+
+pub(crate) async fn refresh_chatgpt(refresh_token: &str, account_id: &str) -> Result<Secret> {
+    let client = Client::builder().timeout(HTTP_TIMEOUT).build()?;
+    refresh_chatgpt_with(&client, ISSUER, refresh_token, Some(account_id)).await
+}
+
+async fn refresh_chatgpt_with(
+    client: &Client,
+    issuer: &str,
+    refresh_token: &str,
+    previous_account_id: Option<&str>,
+) -> Result<Secret> {
+    let token = client
+        .post(format!("{issuer}/oauth/token"))
+        .timeout(HTTP_TIMEOUT)
+        .form(&[
+            ("grant_type", "refresh_token"),
+            ("refresh_token", refresh_token),
+            ("client_id", CLIENT_ID),
+        ])
+        .send()
+        .await?
+        .error_for_status()?
+        .json::<TokenResponse>()
+        .await?;
+    secret_from_token(token, Some(refresh_token), previous_account_id)
+}
+
+fn secret_from_token(
+    token: TokenResponse,
+    previous_refresh_token: Option<&str>,
+    previous_account_id: Option<&str>,
+) -> Result<Secret> {
+    require_nonempty(&token.access_token, "access_token")?;
+    let refresh_token = token
+        .refresh_token
+        .as_deref()
+        .or(previous_refresh_token)
+        .ok_or_else(|| anyhow::anyhow!("ChatGPT token response omitted refresh_token"))?;
+    require_nonempty(refresh_token, "refresh_token")?;
+    let expires_in = token.expires_in.unwrap_or(3600);
+    if expires_in <= 0 {
+        anyhow::bail!("ChatGPT token response contained invalid expires_in");
+    }
+    let account_id = token
+        .id_token
+        .as_deref()
+        .and_then(account_id_from_jwt)
+        .or_else(|| account_id_from_jwt(&token.access_token))
+        .or_else(|| previous_account_id.map(str::to_owned))
+        .ok_or_else(|| anyhow::anyhow!("ChatGPT token did not contain an account id"))?;
+    require_nonempty(&account_id, "account_id")?;
+    let now = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as i64;
+    let expires_at_ms = expires_in
+        .checked_mul(1000)
+        .and_then(|duration| now.checked_add(duration))
+        .ok_or_else(|| anyhow::anyhow!("ChatGPT token response contained invalid expires_in"))?;
+    Ok(Secret::ChatGpt {
+        access_token: token.access_token,
+        refresh_token: refresh_token.to_owned(),
+        expires_at_ms,
+        account_id,
+    })
+}
+
+fn require_nonempty(value: &str, field: &str) -> Result<()> {
+    if value.trim().is_empty() {
+        anyhow::bail!("ChatGPT response contained empty {field}");
+    }
+    Ok(())
+}
+
+fn account_id_from_jwt(token: &str) -> Option<String> {
+    let payload = token.split('.').nth(1)?;
+    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(payload)
+        .ok()?;
+    let claims: JwtClaims = serde_json::from_slice(&bytes).ok()?;
+    claims
+        .chatgpt_account_id
+        .or_else(|| claims.openai_auth.and_then(|auth| auth.chatgpt_account_id))
+        .or_else(|| {
+            claims
+                .organizations
+                .and_then(|orgs| orgs.into_iter().next().map(|org| org.id))
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::VecDeque;
+    use std::sync::{Arc, Mutex};
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::TcpListener;
+
+    async fn mock_server(responses: Vec<(&str, String)>) -> (String, Arc<Mutex<Vec<String>>>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let requests = Arc::new(Mutex::new(Vec::new()));
+        let captured = Arc::clone(&requests);
+        let mut responses: VecDeque<_> = responses
+            .into_iter()
+            .map(|(status, body)| (status.to_owned(), body))
+            .collect();
+        tokio::spawn(async move {
+            while let Some((status, body)) = responses.pop_front() {
+                let (mut socket, _) = listener.accept().await.unwrap();
+                let mut request = Vec::new();
+                let mut buffer = [0; 1024];
+                loop {
+                    let count = socket.read(&mut buffer).await.unwrap();
+                    request.extend_from_slice(&buffer[..count]);
+                    let headers_end = request.windows(4).position(|w| w == b"\r\n\r\n");
+                    if let Some(end) = headers_end {
+                        let headers = String::from_utf8_lossy(&request[..end]);
+                        let length = headers
+                            .lines()
+                            .find_map(|line| {
+                                line.to_ascii_lowercase()
+                                    .strip_prefix("content-length: ")
+                                    .map(str::to_owned)
+                            })
+                            .and_then(|value| value.parse::<usize>().ok())
+                            .unwrap_or(0);
+                        if request.len() >= end + 4 + length {
+                            break;
+                        }
+                    }
+                }
+                captured
+                    .lock()
+                    .unwrap()
+                    .push(String::from_utf8(request).unwrap());
+                let reply = format!(
+                    "HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                    body.len()
+                );
+                socket.write_all(reply.as_bytes()).await.unwrap();
+            }
+        });
+        (format!("http://{address}"), requests)
+    }
+
+    #[test]
+    fn device_protocol_uses_exact_openai_fields() {
+        assert_eq!(
+            serde_json::to_string(&DeviceCodeRequest {
+                client_id: CLIENT_ID
+            })
+            .unwrap(),
+            format!(r#"{{"client_id":"{CLIENT_ID}"}}"#)
+        );
+        assert_eq!(
+            serde_json::to_string(&DevicePollRequest {
+                device_auth_id: "device",
+                user_code: "CODE",
+            })
+            .unwrap(),
+            r#"{"device_auth_id":"device","user_code":"CODE"}"#
+        );
+    }
+
+    #[test]
+    fn token_conversion_extracts_nested_account_and_expiry() {
+        let claims = base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .encode(r#"{"https://api.openai.com/auth":{"chatgpt_account_id":"acct"}}"#);
+        let secret = secret_from_token(
+            TokenResponse {
+                access_token: format!("header.{claims}.signature"),
+                refresh_token: Some("refresh".to_string()),
+                expires_in: Some(60),
+                id_token: None,
+            },
+            None,
+            None,
+        )
+        .unwrap();
+        assert!(matches!(secret, Secret::ChatGpt { account_id, .. } if account_id == "acct"));
+    }
+
+    #[tokio::test]
+    async fn login_runs_the_device_protocol_and_token_exchange() {
+        let claims = base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .encode(r#"{"chatgpt_account_id":"acct"}"#);
+        let (issuer, requests) = mock_server(vec![
+            (
+                "200 OK",
+                r#"{"device_auth_id":"dev","user_code":"CODE","interval":1}"#.to_owned(),
+            ),
+            (
+                "200 OK",
+                r#"{"authorization_code":"auth","code_verifier":"verify"}"#.to_owned(),
+            ),
+            (
+                "200 OK",
+                format!(
+                    r#"{{"access_token":"h.{claims}.s","refresh_token":"new","expires_in":60}}"#
+                ),
+            ),
+        ])
+        .await;
+        let prompt = Arc::new(Mutex::new(None));
+        let prompt_copy = Arc::clone(&prompt);
+        let secret = login_chatgpt_device_with(&Client::new(), &issuer, move |url, code| {
+            *prompt_copy.lock().unwrap() = Some((url.to_owned(), code.to_owned()));
+        })
+        .await
+        .unwrap();
+
+        assert_eq!(prompt.lock().unwrap().as_ref().unwrap().1, "CODE");
+        assert!(matches!(secret, Secret::ChatGpt { refresh_token, .. } if refresh_token == "new"));
+        let requests = requests.lock().unwrap();
+        assert!(requests[0].starts_with("POST /api/accounts/deviceauth/usercode "));
+        assert!(requests[1].contains(r#"{"device_auth_id":"dev","user_code":"CODE"}"#));
+        assert!(requests[2].contains("grant_type=authorization_code"));
+        assert!(requests[2].contains("code_verifier=verify"));
+    }
+
+    #[tokio::test]
+    async fn refresh_rotates_or_preserves_refresh_token() {
+        for (response, expected) in [
+            (
+                r#"{"access_token":"access","refresh_token":"rotated"}"#,
+                "rotated",
+            ),
+            (r#"{"access_token":"access"}"#, "original"),
+        ] {
+            let (issuer, _) = mock_server(vec![("200 OK", response.to_owned())]).await;
+            let secret = refresh_chatgpt_with(&Client::new(), &issuer, "original", Some("acct"))
+                .await
+                .unwrap();
+            assert!(
+                matches!(secret, Secret::ChatGpt { refresh_token, .. } if refresh_token == expected)
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn rejects_http_malformed_and_empty_token_responses() {
+        for (status, response) in [
+            ("400 Bad Request", r#"{"error":"invalid_grant"}"#),
+            ("200 OK", "not-json"),
+            ("200 OK", r#"{"access_token":" ","refresh_token":"new"}"#),
+            ("200 OK", r#"{"access_token":"access","refresh_token":" "}"#),
+            ("200 OK", r#"{"access_token":"access","expires_in":0}"#),
+        ] {
+            let (issuer, _) = mock_server(vec![(status, response.to_owned())]).await;
+            assert!(
+                refresh_chatgpt_with(&Client::new(), &issuer, "original", Some("acct"))
+                    .await
+                    .is_err()
+            );
+        }
+    }
+}
