+function decodeBase64(value) {
+  const decoded = globalThis.atob(String(value || "").trim());
+  return Uint8Array.from(decoded, (character) => character.charCodeAt(0));
+}
+
+async function readRestrictedJson(bin, kind, source) {
+  let token = "";
+  try {
+    const snapshot = await runShell(
+      binCommand(bin, `hermes-json snapshot ${source}`, kind),
+    );
+    if (!snapshot || snapshot.code) return "";
+
+    const metadata = JSON.parse(String(snapshot.stdout || "").trim());
+    const bytes = Number(metadata && metadata.bytes);
+    token = String((metadata && metadata.token) || "");
+    if (
+      !/^[0-9a-f]{32}$/.test(token) ||
+      !Number.isSafeInteger(bytes) ||
+      bytes < 1 ||
+      bytes > MAX_REMOTE_SNAPSHOT_BYTES
+    ) {
+      return "";
+    }
+
+    const payload = new Uint8Array(bytes);
+    for (let offset = 0; offset < bytes; offset += REMOTE_CHUNK_BYTES) {
+      const result = await runShell(
+        binCommand(bin, `hermes-json chunk ${token} ${offset}`, kind),
+      );
+      if (!result || result.code) return "";
+      const chunk = decodeBase64(result.stdout);
+      const expected = Math.min(REMOTE_CHUNK_BYTES, bytes - offset);
+      if (chunk.length !== expected) return "";
+      payload.set(chunk, offset);
+    }
+
+    return new TextDecoder("utf-8", { fatal: true }).decode(payload);
+  } catch {
+    return "";
+  } finally {
+    if (token) {
+      try {
+        await runShell(binCommand(bin, `hermes-json delete ${token}`, kind));
+      } catch {
+        /* stale snapshots are pruned by the restricted CLI */
+      }
+    }
+  }
+}
