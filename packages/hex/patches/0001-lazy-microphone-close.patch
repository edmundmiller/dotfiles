diff --git i/src/microphone_idle.rs w/src/microphone_idle.rs
new file mode 100644
index 0000000..d71eb3b
--- /dev/null
+++ w/src/microphone_idle.rs
@@ -0,0 +1,49 @@
+use std::time::{Duration, Instant};
+
+/// Keeps an already-open microphone warm for thirty seconds between captures.
+#[derive(Default)]
+pub struct MicrophoneIdleGrace {
+    idle_since: Option<Instant>,
+}
+
+impl MicrophoneIdleGrace {
+    /// Starts the idle countdown on first observation; audio arriving does not reset it.
+    pub fn expired(&mut self, now: Instant) -> bool {
+        let since = self.idle_since.get_or_insert(now);
+        now.saturating_duration_since(*since) >= Duration::from_secs(30)
+    }
+
+    /// A new capture, closed input, or policy change ends the previous idle period.
+    pub fn reset(&mut self) {
+        self.idle_since = None;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn microphone_closes_at_thirty_seconds_not_on_repeated_idle_observations() {
+        let mut grace = MicrophoneIdleGrace::default();
+        let now = Instant::now();
+        assert!(!grace.expired(now));
+        assert!(!grace.expired(now + Duration::from_secs(12)));
+        assert!(!grace.expired(now + Duration::from_millis(29_999)));
+        assert!(grace.expired(now + Duration::from_secs(30)));
+        assert!(grace.expired(now + Duration::from_secs(45)));
+    }
+
+    #[test]
+    fn another_capture_gets_a_full_idle_grace_after_it_finishes() {
+        let mut grace = MicrophoneIdleGrace::default();
+        let now = Instant::now();
+        assert!(!grace.expired(now));
+        assert!(!grace.expired(now + Duration::from_secs(25)));
+        grace.reset();
+        // The second capture ends forty seconds after the first one.
+        assert!(!grace.expired(now + Duration::from_secs(40)));
+        assert!(!grace.expired(now + Duration::from_millis(69_999)));
+        assert!(grace.expired(now + Duration::from_secs(70)));
+    }
+}
