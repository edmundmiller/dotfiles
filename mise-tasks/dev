#!/usr/bin/env bash
#MISE description="Enter the Nix dev shell; use dev full for deployment tools"
#MISE raw_args=true
#MISE raw=true
set -euo pipefail

case "${1:-default}" in
-h | --help)
  printf 'Usage: mise run dev [default|full] [command args...]\n'
  exit 0
  ;;
default | full) shell="${1:-default}" ;;
*)
  printf 'Expected default or full, got: %s\n' "$1" >&2
  exit 2
  ;;
esac
if (($#)); then shift; fi

# Restore the caller's Nix config before starting the shell or command.
export DOTFILES_DEV_NIX_CONFIG="${NIX_CONFIG:-}"
if github_token="$(gh auth token --hostname github.com 2>/dev/null)" && [[ -n "$github_token" ]]; then
  export NIX_CONFIG="${NIX_CONFIG:-}"$'\n'"extra-access-tokens = github.com=$github_token"
fi
if (($# == 0)); then set -- "${SHELL:-bash}"; fi
# Clear credentials before Nix runs shellHook, then restore the caller's config.
# shellcheck disable=SC2016 # Expansion belongs to the child shell.
exec nix develop "${MISE_PROJECT_ROOT}#${shell}" --no-update-lock-file --unset NIX_CONFIG --command bash -c '
  export NIX_CONFIG="$DOTFILES_DEV_NIX_CONFIG"
  unset DOTFILES_DEV_NIX_CONFIG
  exec "$@"
' bash "$@"
