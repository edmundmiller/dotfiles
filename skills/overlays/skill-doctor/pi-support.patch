+class PiSessionTests(unittest.TestCase):
+    def test_discovers_recent_pi_sessions(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            session_dir = Path(tmp) / "sessions"
+            recent = session_dir / "--repo--" / "recent.jsonl"
+            old = session_dir / "--repo--" / "old.jsonl"
+            write_jsonl(recent, [{"type": "session", "id": "recent"}])
+            write_jsonl(old, [{"type": "session", "id": "old"}])
+            old_time = (datetime.now(timezone.utc) - timedelta(days=10)).timestamp()
+            os.utime(old, (old_time, old_time))
+
+            found = find_pi_session_files(
+                session_dir,
+                datetime.now(timezone.utc) - timedelta(days=1),
+            )
+
+            self.assertEqual([path for _, path in found], [recent])
+
