+def pi_active_branch(objects):
+    """Return the current Pi branch by walking parentId from the last entry."""
+    entries = [obj for obj in objects if obj.get("id")]
+    if not entries:
+        return []
+    by_id = {entry["id"]: entry for entry in entries}
+    branch = []
+    current = entries[-1]
+    seen = set()
+    while current and current["id"] not in seen:
+        seen.add(current["id"])
+        branch.append(current)
+        current = by_id.get(current.get("parentId"))
+    branch.reverse()
+    return branch
+
+
+def pi_skill_invocation(text, skill_names):
+    """Extract a skill command envelope without copying its instructions."""
+    match = re.match(r'^\s*<skill\s+name=["\']([^"\']+)["\'][^>]*>', text)
+    if not match or match.group(1) not in skill_names:
+        return None, text
+    closing = text.find("</skill>", match.end())
+    remainder = text[closing + len("</skill>"):] if closing >= 0 else ""
+    remainder = re.sub(r"^\s*User:\s*", "", remainder).strip()
+    return match.group(1), remainder
+
+
+def parse_pi_session(path: Path, skill_names, include_subagents: bool):
+    """Normalize one persistent Pi JSONL session to the shared transcript shape."""
+    del include_subagents  # Pi does not mark forked sessions as subagents reliably.
+    try:
+        raw = path.read_text(errors="replace")
+    except OSError:
+        return None
+    if len(raw) > MAX_FILE_BYTES:
+        raw = raw[:MAX_FILE_BYTES]
+
+    objects = []
+    for line in raw.splitlines():
+        try:
+            obj = json.loads(line)
+        except (json.JSONDecodeError, ValueError):
+            continue
+        if isinstance(obj, dict):
+            objects.append(obj)
+
+    header = next((obj for obj in objects if obj.get("type") == "session"), {})
+    branch = pi_active_branch(objects)
+    stats = {
+        "user_turns": 0,
+        "assistant_turns": 0,
+        "tool_calls": 0,
+        "repeated_tool_calls": 0,
+        "error_outputs": 0,
+    }
+    entries = []
+    seen_calls = {}
+    call_args_text = []
+    used_tool_names = set()
+    skills_used = set()
+    first_ts = last_ts = None
+
+    for obj in branch:
+        ts = obj.get("timestamp")
+        if ts:
+            first_ts = first_ts or ts
+            last_ts = ts
+        if obj.get("type") != "message":
+            continue
+        message = obj.get("message")
+        if not isinstance(message, dict):
+            continue
+        role = message.get("role")
+        content = message.get("content")
+
+        if role == "user":
+            text = extract_text(content)
+            if not text or looks_injected(text):
+                continue
+            skill_name, user_text = pi_skill_invocation(text, skill_names)
+            if skill_name:
+                skills_used.add(skill_name)
+                entries.append(("skill", json.dumps({"name": skill_name})))
+                stats["user_turns"] += 1
+                if user_text:
+                    entries.append(("user", truncate(user_text, MAX_MSG_CHARS)))
+            else:
+                stats["user_turns"] += 1
+                entries.append(("user", truncate(text, MAX_MSG_CHARS)))
+
+        elif role == "assistant":
+            stats["assistant_turns"] += 1
+            blocks = content if isinstance(content, list) else []
+            for block in blocks:
+                if not isinstance(block, dict):
+                    continue
+                block_type = block.get("type")
+                if block_type == "text":
+                    text = block.get("text")
+                    if isinstance(text, str) and text:
+                        entries.append(("assistant", truncate(text, MAX_MSG_CHARS)))
+                elif block_type == "toolCall":
+                    stats["tool_calls"] += 1
+                    name = str(block.get("name") or "unknown")
+                    args = block.get("arguments") or {}
+                    args_text = args if isinstance(args, str) else json.dumps(args, ensure_ascii=False)
+                    key = hashlib.sha1((name + args_text).encode()).hexdigest()
+                    seen_calls[key] = seen_calls.get(key, 0) + 1
+                    if seen_calls[key] > 1:
+                        stats["repeated_tool_calls"] += 1
+                    call_args_text.append(args_text)
+                    used_tool_names.add(name)
+                    entries.append((f"tool:{name}", truncate(args_text, MAX_TOOL_CHARS)))
+
+        elif role == "toolResult":
+            result = extract_text(content)
+            low = result[:2000].lower()
+            if message.get("isError") or "error" in low or "failed" in low or "traceback" in low:
+                stats["error_outputs"] += 1
+            entries.append(("output", truncate(result, MAX_TOOL_CHARS)))
+
+    args_blob = "\n".join(call_args_text)
+    skills_used.update(
+        name for name in skill_names
+        if f"skills/{name}/" in args_blob or f"{name}/SKILL.md" in args_blob
+    )
+    meta = {
+        "id": header.get("id") or path.stem,
+        "cwd": header.get("cwd"),
+        "started_at": header.get("timestamp") or first_ts,
+        "originator": "pi",
+        "thread_source": None,
+        "session_version": header.get("version"),
+    }
+    stats["first_ts"] = first_ts
+    stats["last_ts"] = last_ts
+    stats["has_code_edits"] = (
+        bool(used_tool_names & PI_CODE_EDIT_TOOLS)
+        or any(hint in args_blob for hint in CODE_EDIT_HINTS)
+    )
+    return meta, stats, entries, sorted(skills_used)
+
+
