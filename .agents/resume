#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# shellcheck disable=SC1091
if ! source "$repo_root/.agents/nix-env.sh"; then
  echo "Nix is missing; rerun .agents/setup" >&2
  exit 1
fi

if systemctl cat nix-daemon.service >/dev/null 2>&1 && ! systemctl is-active --quiet nix-daemon.service; then
  sudo systemctl start nix-daemon.service
fi

agent_env="$HOME/.local/state/dotfiles-orb-tools"
for command in agent-run hey jj mise prek; do
  if [[ ! -x "$agent_env/bin/$command" ]]; then
    echo "Orb command $command is missing; rerun .agents/setup" >&2
    exit 1
  fi
done

# Shared snapshots discard profile entries written by setup. Install this on
# activation/wake, without resolving private inputs until a login needs them.
orb_env="$HOME/.config/amp/dotfiles-orb-env.sh"
mkdir -p "$(dirname "$orb_env")"
cat > "$orb_env" <<EOF
if [[ "\${AMP_ORB:-}" == "1" && "\${PWD:-}" == "$repo_root" && -z "\${DOTFILES_AGENT_ENV_ACTIVE:-}" ]]; then
  source "$repo_root/.agents/nix-env.sh" || return
  nix_config="\${NIX_CONFIG:-}"
  if command -v gh >/dev/null 2>&1 && github_token="\$(gh auth token 2>/dev/null)" && [[ -n "\$github_token" ]]; then
    nix_config="\${nix_config:+\$nix_config
}access-tokens = github.com=\$github_token"
  fi
  if agent_shell="\$(NIX_CONFIG=\$nix_config "\$nix_bin" --accept-flake-config print-dev-env --no-write-lock-file '$repo_root#agent')"; then
    eval "\$agent_shell"
    export DOTFILES_AGENT_ENV_ACTIVE=1
  fi
  unset github_token nix_config agent_shell
  export PATH="\$(dirname "\$nix_bin"):\$PATH"
fi
EOF

profile_marker="# dotfiles orb agent shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# dotfiles orb agent shell
source "$HOME/.config/amp/dotfiles-orb-env.sh"
EOF
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$nix_bin" "$HOME/.local/bin/nix"
for command in agent-run hey jj mise prek; do
  ln -sfn "$agent_env/bin/$command" "$HOME/.local/bin/$command"
done

PATH="$HOME/.local/bin:$PATH"
# Trust only this checkout, including after a snapshot updates its config.
mise trust "$repo_root/mise.toml"

for command in agent-run nix hey jj mise prek; do
  command -v "$command" >/dev/null
done

echo "Orb prerequisites and agent commands are ready."
