#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# shellcheck disable=SC1091
if ! source "$repo_root/.agents/nix-env.sh"; then
  echo "Nix is missing; rerun .agents/setup" >&2
  exit 1
fi

if systemctl cat nix-daemon.service >/dev/null 2>&1 && ! systemctl is-active --quiet nix-daemon.service; then
  sudo systemctl start nix-daemon.service
fi

nix_config="${NIX_CONFIG:-}"
if command -v gh >/dev/null 2>&1 && github_token="$(gh auth token 2>/dev/null)" && [[ -n "$github_token" ]]; then
  nix_config="${nix_config:+$nix_config
}access-tokens = github.com=$github_token"
fi

agent_env="$(
  NIX_CONFIG="$nix_config" "$nix_bin" --accept-flake-config build \
    --no-link --no-write-lock-file --print-out-paths "$repo_root#agent-env"
)"
unset github_token nix_config

mkdir -p "$HOME/.local/bin"
ln -sfn "$nix_bin" "$HOME/.local/bin/nix"
for command in agent-run hey jj mise prek; do
  ln -sfn "$agent_env/bin/$command" "$HOME/.local/bin/$command"
done

PATH="$HOME/.local/bin:$PATH"
# Trust only this checkout, including after a snapshot updates its config.
mise trust "$repo_root/mise.toml"

for command in agent-run nix hey jj mise prek; do
  command -v "$command" >/dev/null
done

echo "Orb prerequisites and agent commands are ready."
