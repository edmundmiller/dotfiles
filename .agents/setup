#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n==> %s\n' "$1"
}

repo_root="$(git rev-parse --show-toplevel)"
nix_profile="/nix/var/nix/profiles/default"
nix_env="$nix_profile/etc/profile.d/nix-daemon.sh"

step "Install Nix when missing"
if [[ ! -x "$nix_profile/bin/nix" ]]; then
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
fi

# The installer cannot update this running process.
# shellcheck disable=SC1090
source "$nix_env"

step "Configure Nix for the orb"
nix_custom_conf="/etc/nix/nix.custom.conf"
nix_config_changed=0
# Full flake evaluation can exhaust a small orb when Nix uses every core.
for setting in \
  "trusted-users = root $(id -un)" \
  "extra-substituters = https://cache.numtide.com" \
  "extra-trusted-substituters = https://cache.numtide.com" \
  "extra-trusted-public-keys = niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g=" \
  "eval-cores = 1" \
  "max-jobs = 1" \
  "cores = 1"; do
  if ! sudo grep -Fqx "$setting" "$nix_custom_conf" 2>/dev/null; then
    printf '%s\n' "$setting" | sudo tee -a "$nix_custom_conf" >/dev/null
    nix_config_changed=1
  fi
done
if ((nix_config_changed)); then
  sudo systemctl restart nix-daemon.service
fi

step "Allow sparse virtual memory reservations"
# Oxlint JS plugins reserve one sparse 4 GiB arena per worker. Orbs do not
# commit that memory, but Linux's default heuristic rejects the reservation.
if [[ "$(sysctl -n vm.overcommit_memory)" != "1" ]]; then
  sudo sysctl -w vm.overcommit_memory=1 >/dev/null
fi

step "Provide swap for full Nix evaluation"
# The evaluator retains the full flake graph, even with one evaluation thread.
swapfile="/swapfile"
if ! /usr/sbin/swapon --show=NAME --noheadings | grep -Fxq "$swapfile"; then
  if [[ ! -f "$swapfile" ]]; then
    sudo fallocate -l 4G "$swapfile"
    sudo chmod 600 "$swapfile"
  fi
  sudo /usr/sbin/mkswap "$swapfile" >/dev/null
  sudo /usr/sbin/swapon "$swapfile"
fi

step "Warm the headless agent development shell"
nix --accept-flake-config develop --no-write-lock-file "$repo_root#agent" --command true

step "Make the agent shell available to orb login shells"
orb_env="$HOME/.config/amp/dotfiles-orb-env.sh"
mkdir -p "$(dirname "$orb_env")"
cat > "$orb_env" <<EOF
if [[ "\${AMP_ORB:-}" == "1" && "\${PWD:-}" == "$repo_root" && -z "\${DOTFILES_AGENT_ENV_ACTIVE:-}" ]]; then
  source "$nix_env"
  export DOTFILES_AGENT_ENV_ACTIVE=1
  eval "\$("$nix_profile/bin/nix" --accept-flake-config print-dev-env --no-write-lock-file '$repo_root#agent')"
  export PATH="$nix_profile/bin:\$PATH"
fi
EOF

profile_marker="# dotfiles orb agent shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# dotfiles orb agent shell
source "$HOME/.config/amp/dotfiles-orb-env.sh"
EOF
fi

printf '\nOrb setup complete.\n'
