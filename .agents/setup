#!/usr/bin/env bash
set -euo pipefail

step() {
  if [[ -n "${step_started:-}" ]]; then
    printf '    Completed in %ss\n' "$((SECONDS - step_started))"
  fi
  printf '\n==> %s\n' "$1"
  step_started=$SECONDS
}

repo_root="$(git rev-parse --show-toplevel)"

step "Install Nix when missing"
# shellcheck disable=SC1091
if ! source "$repo_root/.agents/nix-env.sh"; then
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
  # The installer cannot update this running process.
  # shellcheck disable=SC1091
  source "$repo_root/.agents/nix-env.sh"
fi

step "Expose Nix to non-login agent commands"
mkdir -p "$HOME/.local/bin"
ln -sfn "$nix_bin" "$HOME/.local/bin/nix"

step "Configure Nix for the orb"
nix_custom_conf="/etc/nix/nix.conf"
if grep -Eq '^[[:space:]]*!?include[[:space:]]+(/etc/nix/)?nix\.custom\.conf([[:space:]]|$)' "$nix_custom_conf"; then
  nix_custom_conf="/etc/nix/nix.custom.conf"
fi
nix_config_changed=0
# Full flake evaluation can exhaust a small orb when Nix uses every core.
for setting in \
  "trusted-users = root $(id -un)" \
  "extra-substituters = https://cache.numtide.com" \
  "extra-trusted-substituters = https://cache.numtide.com" \
  "extra-trusted-public-keys = niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g=" \
  "eval-cores = 1" \
  "max-jobs = 1" \
  "cores = 1"; do
  # Parallel evaluation is a Determinate Nix setting, not an upstream one.
  if [[ "$setting" == "eval-cores = 1" ]] && ! "$nix_bin" config show eval-cores >/dev/null 2>&1; then
    continue
  fi
  if ! sudo grep -Fqx "$setting" "$nix_custom_conf" 2>/dev/null; then
    printf '%s\n' "$setting" | sudo tee -a "$nix_custom_conf" >/dev/null
    nix_config_changed=1
  fi
done
if ((nix_config_changed)) && systemctl cat nix-daemon.service >/dev/null 2>&1; then
  sudo systemctl restart nix-daemon.service
fi

step "Allow sparse virtual memory reservations"
# Oxlint JS plugins reserve one sparse 4 GiB arena per worker. Orbs do not
# commit that memory, but Linux's default heuristic rejects the reservation.
if [[ "$(/usr/sbin/sysctl -n vm.overcommit_memory)" != "1" ]]; then
  # Custom providers may prohibit changing host kernel settings.
  if ! sudo sysctl -w vm.overcommit_memory=1 >/dev/null; then
    echo "Warning: cannot set vm.overcommit_memory=1; continuing without memory overcommit tuning. Oxlint JS plugins may fail to reserve memory." >&2
  fi
fi

step "Provide swap for full Nix evaluation"
# The evaluator retains the full flake graph, even with one evaluation thread.
swapfile="/swapfile"
# Swap is host-wide; rootless containers cannot activate it, even with sudo.
if systemd-detect-virt --container --quiet; then
  echo "Warning: skipping swap provisioning in a container; swap is host-managed. Full Nix evaluation may exceed available memory." >&2
elif ! /usr/sbin/swapon --show=NAME --noheadings | grep -Fxq "$swapfile"; then
  if [[ ! -f "$swapfile" ]]; then
    sudo fallocate -l 4G "$swapfile"
    sudo chmod 600 "$swapfile"
  fi
  sudo /usr/sbin/mkswap "$swapfile" >/dev/null
  sudo /usr/sbin/swapon "$swapfile"
fi

step "Prepare public Orb commands for the snapshot"
# Keep a GC root across snapshot reuse. Nix checks the pinned recipes on every
# setup, reusing realized outputs rather than a custom success/fingerprint cache.
mkdir -p "$HOME/.local/state"
"$nix_bin" build --impure --file "$repo_root/.agents/orb-tools.nix" \
  --out-link "$HOME/.local/state/dotfiles-orb-tools"

printf '    Completed in %ss\n\nOrb setup complete.\n' "$((SECONDS - step_started))"
