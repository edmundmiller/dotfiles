#!/usr/bin/env bash
set -euo pipefail

token_file="${GITHUB_NIX_TOKEN_FILE:-/var/lib/opnix/secrets/githubNixToken}"
deploy_source_head=""
deploy_source_base=""
deploy_expected_main=""
deploy_published=""
preserve_ha=0
deploy_source_owner="${SUDO_USER:-${USER:-unknown}}"
deploy_allow_stale="${NIXOS_DEPLOY_ALLOW_STALE:-0}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --nuc-deploy-expected-main=*)
      deploy_expected_main="${1#*=}"
      if [[ ! "$deploy_expected_main" =~ ^[0-9a-f]{40}$ ]]; then
        echo "nix-private-github: expected main must be an exact commit SHA" >&2
        exit 64
      fi
      shift
      ;;
    --nuc-deploy-published=*)
      deploy_published="${1#*=}"
      if [[ ! "$deploy_published" =~ ^[0-9a-f]{40}$ ]]; then
        echo "nix-private-github: published revision must be an exact commit SHA" >&2
        exit 64
      fi
      shift
      ;;
    --nuc-deploy-preserve-home-assistant)
      preserve_ha=1
      shift
      ;;
    --nuc-deploy-source-head=*)
      deploy_source_head="${1#*=}"
      shift
      ;;
    --nuc-deploy-source-base=*)
      deploy_source_base="${1#*=}"
      shift
      ;;
    --nuc-deploy-source-owner=*)
      deploy_source_owner="${1#*=}"
      shift
      ;;
    --nuc-deploy-allow-stale)
      deploy_allow_stale=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "nix-private-github: missing command" >&2
  exit 2
fi

if [[ ! -s "$token_file" ]]; then
  echo "GitHub token file is missing or empty: $token_file" >&2
  exit 1
fi

token="$(<"$token_file")"
export NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}
}access-tokens = github.com=$token"

command_name="$(basename "$1")"
deploy_mutation=0
remote_flake=0
dotfiles_remote_flake=0
if [[ "$command_name" == "nixos-rebuild" ]]; then
  for arg in "${@:2}"; do
    case "$arg" in
      switch|test|dry-activate|boot)
        deploy_mutation=1
        ;;
      github:*|gitlab:*|https://*|http://*|--flake=github:*|--flake=gitlab:*|--flake=https://*|--flake=http://*)
        remote_flake=1
        ;;
      --rollback)
        remote_flake=1
        ;;
    esac
    case "$arg" in
      github:edmundmiller/dotfiles#*|--flake=github:edmundmiller/dotfiles#*)
        dotfiles_remote_flake=1
        ;;
    esac
  done
fi

if [[ -n "$deploy_expected_main" && -n "$deploy_published" ]]; then
  echo "nix-private-github: choose exactly one approved revision guard" >&2
  exit 64
fi
deploy_approved="${deploy_expected_main:-$deploy_published}"

# These options bind the fetched source as well as live main. A matching approval
# must not accidentally accompany another flake, a local tree, or rollback.
if [[ -n "$deploy_approved" ]]; then
  deploy_flakes=()
  previous=""
  for arg in "${@:2}"; do
    if [[ "$previous" == "--flake" ]]; then
      deploy_flakes+=("$arg")
    elif [[ "$arg" == --flake=* ]]; then
      deploy_flakes+=("${arg#--flake=}")
    fi
    if [[ "$arg" == "--rollback" ]]; then
      echo "nix-private-github: approved revision cannot be used for rollback" >&2
      exit 64
    fi
    previous="$arg"
  done
  if [[ "$deploy_mutation" != 1 || ${#deploy_flakes[@]} != 1 || "${deploy_flakes[0]:-}" != "github:edmundmiller/dotfiles/${deploy_approved}#nuc" ]]; then
    echo "nix-private-github: approved revision requires the exact pinned NUC flake" >&2
    exit 64
  fi
fi

if [[ "$preserve_ha" == 1 && ( -z "$deploy_expected_main" || "$deploy_mutation" != 1 || " $* " != *" switch "* ) ]]; then
  echo "nix-private-github: HA preservation requires an exact-main switch" >&2
  exit 64
fi

if [[ "$deploy_mutation" -eq 0 ]]; then
  exec "$@"
fi

lock_file="${NIXOS_DEPLOY_LOCK_FILE:-/run/lock/nixos-deploy.lock}"
owner_file="${NIXOS_DEPLOY_OWNER_FILE:-${lock_file}.owner}"
mkdir -p "$(dirname "$lock_file")"
exec {deploy_lock_fd}>"$lock_file"
if ! flock -n "$deploy_lock_fd"; then
  echo "nix-private-github: NUC deployment lock is held: $lock_file" >&2
  if [[ -r "$owner_file" ]]; then
    sed 's/^/  /' "$owner_file" >&2
  fi
  exit 75
fi

# shellcheck disable=SC2329 # Invoked by EXIT trap.
cleanup_deploy_lock() {
  rm -f "$owner_file"
}
write_deploy_owner() {
  {
    printf 'owner=%s\n' "$deploy_source_owner"
    printf 'pid=%s\n' "$$"
    printf 'started=%s\n' "$(date --iso-8601=seconds)"
    printf 'cwd=%s\n' "$PWD"
    printf 'source_head=%s\n' "${deploy_source_head:-unknown}"
    printf 'source_base=%s\n' "${deploy_source_base:-unknown}"
  } >"$owner_file"
}
deploy_child_pid=""
# shellcheck disable=SC2329 # Invoked by signal traps.
forward_deploy_signal() {
  local signal="$1"
  local exit_code="$2"
  trap - HUP INT TERM
  if [[ -n "$deploy_child_pid" ]] && kill -0 "$deploy_child_pid" 2>/dev/null; then
    kill -s "$signal" "$deploy_child_pid" 2>/dev/null || true
    wait "$deploy_child_pid" 2>/dev/null || true
  fi
  exit "$exit_code"
}
trap cleanup_deploy_lock EXIT
trap 'forward_deploy_signal HUP 129' HUP
trap 'forward_deploy_signal INT 130' INT
trap 'forward_deploy_signal TERM 143' TERM
write_deploy_owner

if [[ -z "$deploy_source_head" || -z "$deploy_source_base" ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    deploy_source_head="$(git rev-parse HEAD)"
    deploy_source_base="$(git merge-base HEAD origin/main)"
  elif [[ "$remote_flake" -eq 0 ]]; then
    echo "nix-private-github: local NUC deployment lacks source metadata; refusing activation" >&2
    exit 65
  fi
fi

deploy_git="${NIXOS_DEPLOY_GIT:-git}"
if [[ "$dotfiles_remote_flake" -eq 1 || -n "$deploy_approved" ]]; then
  remote_main=""
else
  remote_main="${NIXOS_DEPLOY_REMOTE_MAIN:-}"
fi
if [[ "$remote_flake" -eq 0 || "$dotfiles_remote_flake" -eq 1 || -n "$deploy_approved" ]]; then
  if [[ -z "$remote_main" ]]; then
    if ! remote_main_output="$(
      "$deploy_git" ls-remote \
        https://github.com/edmundmiller/dotfiles.git \
        refs/heads/main
    )"; then
      echo "nix-private-github: could not resolve current dotfiles origin/main" >&2
      exit 69
    fi
    read -r remote_main _ <<<"$remote_main_output"
  fi
  if [[ -z "$remote_main" ]]; then
    echo "nix-private-github: could not resolve current dotfiles origin/main" >&2
    exit 69
  fi
fi

# CI-approved deployments must still be current when they acquire the host
# lock. Neither a stale override nor a cached main value can bypass this gate.
if [[ -n "$deploy_expected_main" && "$remote_main" != "$deploy_expected_main" ]]; then
  echo "nix-private-github: approved commit is no longer dotfiles origin/main; rerun CI and deployment" >&2
  exit 65
fi

# Continuous rollout may activate a green commit that main has since passed.
# Check both publication and the actual active generation under the switch lock:
# an operator may have advanced the host since the workflow selected its target.
if [[ -n "$deploy_published" ]]; then
  if [[ ! "$remote_main" =~ ^[0-9a-f]{40}$ ]]; then
    echo "nix-private-github: current dotfiles origin/main is not a commit SHA" >&2
    exit 65
  fi
  active_revision="$(nixos-version --configuration-revision)"
  if [[ ! "$active_revision" =~ ^dotfiles=([0-9a-f]{40})\;agents-workspace=[0-9a-f]{40}$ ]]; then
    echo "nix-private-github: cannot identify active dotfiles revision; refusing automatic activation" >&2
    exit 65
  fi
  active_sha="${BASH_REMATCH[1]}"
  ancestry_dir="$(mktemp -d)"
  if ! {
    "$deploy_git" -C "$ancestry_dir" init --quiet --bare &&
      "$deploy_git" -C "$ancestry_dir" fetch --quiet --no-tags --filter=tree:0 \
        https://github.com/edmundmiller/dotfiles.git "$remote_main" &&
      { [[ "$deploy_published" == "$remote_main" ]] ||
        "$deploy_git" -C "$ancestry_dir" merge-base --is-ancestor "$deploy_published" "$remote_main"; } &&
      "$deploy_git" -C "$ancestry_dir" merge-base --is-ancestor "$active_sha" "$deploy_published"
  }; then
    rm -rf "$ancestry_dir"
    echo "nix-private-github: target must be published on main and descend from the active generation" >&2
    exit 65
  fi
  rm -rf "$ancestry_dir"
fi

if [[ "$dotfiles_remote_flake" -eq 1 ]]; then
  if [[ ! "$remote_main" =~ ^[0-9a-f]{40}$ ]]; then
    echo "nix-private-github: current dotfiles origin/main is not a commit SHA" >&2
    exit 65
  fi

  rewritten_command=()
  for arg in "$@"; do
    case "$arg" in
      github:edmundmiller/dotfiles#*)
        flake_output="${arg#github:edmundmiller/dotfiles#}"
        if [[ -z "$flake_output" ]]; then
          echo "nix-private-github: dotfiles flake output is missing" >&2
          exit 64
        fi
        rewritten_command+=("github:edmundmiller/dotfiles/${remote_main}#${flake_output}")
        ;;
      --flake=github:edmundmiller/dotfiles#*)
        flake_output="${arg#--flake=github:edmundmiller/dotfiles#}"
        if [[ -z "$flake_output" ]]; then
          echo "nix-private-github: dotfiles flake output is missing" >&2
          exit 64
        fi
        rewritten_command+=("--flake=github:edmundmiller/dotfiles/${remote_main}#${flake_output}")
        ;;
      *)
        rewritten_command+=("$arg")
        ;;
    esac
  done
  set -- "${rewritten_command[@]}"
fi

if [[ "$remote_flake" -eq 0 ]]; then
  if [[ "$deploy_source_base" != "$remote_main" && "$deploy_source_head" != "$remote_main" ]]; then
    if [[ "$deploy_allow_stale" != "1" ]]; then
      echo "nix-private-github: stale NUC deployment snapshot refused" >&2
      echo "  source head: $deploy_source_head" >&2
      echo "  source base: $deploy_source_base" >&2
      echo "  origin/main: $remote_main" >&2
      exit 65
    fi
    echo "nix-private-github: WARNING: reviewed stale override accepted" >&2
  fi
fi

write_deploy_owner

if [[ "$preserve_ha" == 1 ]]; then
  # Build and compare the entire selected generation under the existing host
  # deployment lock. Never disable restarts to hide an incompatible closure.
  old_system="$(readlink -f /run/current-system)"
  printf 'configurationRevisionBefore=%s\n' "$(nixos-version --configuration-revision)"
  printf 'activeSystemBefore=%s\n' "$old_system"
  systemctl is-active --quiet home-assistant.service
  test "$(systemctl show home-assistant.service -p NeedDaemonReload --value)" = no
  ha_before="$(systemctl show home-assistant.service -p MainPID -p ActiveEnterTimestampMonotonic)"
  target="$(nix build --no-link --print-out-paths --accept-flake-config --max-jobs 1 \
    "github:edmundmiller/dotfiles/${deploy_expected_main}#nixosConfigurations.nuc.config.system.build.toplevel")"
  test -f "$old_system/etc/systemd/system/home-assistant.service"
  for service in home-assistant.service gatus.service gatus-email.service gatus-notion.service; do
    for directory in "$service" "$service.d" "multi-user.target.wants/$service"; do
      old="$old_system/etc/systemd/system/$directory"
      new="$target/etc/systemd/system/$directory"
      if [[ -e "$old" || -e "$new" ]] && ! diff -qr "$old" "$new" >/dev/null 2>&1; then
        echo "nix-private-github: protected unit $service would change; refusing activation" >&2
        exit 65
      fi
    done
    for prefix in /run/systemd/system /run/systemd/system.control /etc/systemd/system.control; do
      if [[ -e "$prefix/$service" || -e "$prefix/$service.d" ]]; then
        echo "nix-private-github: protected unit $service has a runtime override; refusing activation" >&2
        exit 65
      fi
    done
  done
  if ! plan="$("$target/bin/switch-to-configuration" dry-activate 2>&1)" ||
    grep -Eq '(home-assistant|postgresql[^ ]*|dbus|bluetooth|networking|systemd-udevd|systemd-networkd|NetworkManager|systemd-resolved)\.service' <<<"$plan"; then
    echo "nix-private-github: activation plan may interrupt HA or its dependencies; refusing activation" >&2
    exit 65
  fi
  test "$(readlink -f /run/current-system)" = "$old_system"
  test "$(systemctl show home-assistant.service -p MainPID -p ActiveEnterTimestampMonotonic)" = "$ha_before"
  main_now="$("$deploy_git" ls-remote https://github.com/edmundmiller/dotfiles.git refs/heads/main)"
  read -r main_sha _ <<<"$main_now"
  test "$main_sha" = "$deploy_expected_main"
  printf 'ha_preservation_guard=passed target=%s\n' "$target"
fi

"$@" &
deploy_child_pid=$!
set +e
wait "$deploy_child_pid"
status=$?
set -e
deploy_child_pid=""
if [[ "$preserve_ha" == 1 ]]; then
  if ! systemctl is-active --quiet home-assistant.service ||
    [[ "$(systemctl show home-assistant.service -p MainPID -p ActiveEnterTimestampMonotonic)" != "$ha_before" ]]; then
    echo "nix-private-github: HA continuity verification failed; preserve the observation gap" >&2
    exit 65
  fi
  echo "ha_continuity=verified_same_pid_and_start"
fi
exit "$status"
