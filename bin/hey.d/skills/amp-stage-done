#!/usr/bin/env bash
#MISE description="Stage and verify done in a local Amp skills clone; never publish"
#MISE raw_args=true
#MISE raw=true
set -euo pipefail
if [[ $# != 1 ]] ||
  ! target=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) ||
  [[ -n "$(git -C "$1" rev-parse --show-prefix)" ]]; then
  echo "Usage: mise run skills:amp-stage-done <local-skills-repository>" >&2
  exit 2
fi
status=$(git -C "$target" status --porcelain --ignored --untracked-files=all -- done)
if [[ -n "$status" ]]; then
  echo "Refusing to overwrite local done edits in the target repository" >&2
  exit 1
fi
root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
stage=$(mktemp -d "$target/.done-stage.XXXXXXXX")
cleanup() {
  local result=$?
  if [[ -e "$stage/previous" || -L "$stage/previous" ]]; then
    if [[ ! -e "$target/done" && ! -L "$target/done" ]]; then
      if ! mv -- "$stage/previous" "$target/done"; then
        echo "Restore failed; original done retained at $stage/previous" >&2
        return 1
      fi
    elif ((result != 0)); then
      echo "Staging interrupted; original done retained at $stage/previous" >&2
      return "$result"
    fi
  fi
  rm -rf -- "$stage"
  return "$result"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cp -R "$root/skills/catalog/done" "$stage/done"
python3 "$root/scripts/check_done_bundle.py" "$stage/done"
status=$(git -C "$target" status --porcelain --ignored --untracked-files=all -- done)
if [[ -n "$status" ]]; then
  echo "Refusing to overwrite local done edits in the target repository" >&2
  exit 1
fi
if [[ -e "$target/done" || -L "$target/done" ]]; then
  mv -- "$target/done" "$stage/previous"
fi
mv -- "$stage/done" "$target/done"
