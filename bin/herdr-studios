#!/usr/bin/env bash
# herdr-studios: save SSH-enabled Seqera Studios as Herdr machines.
#
#   herdr-studios list [--all-users] [--include-stopped]
#   herdr-studios sync [--all-users] [--dry-run]
#
# sync writes one ssh Host alias per studio (seqera-studio-a<sessionId>) to
# ~/.ssh/seqera-studios.conf, adds running studios to Herdr, enables saved ones
# that are running again, disables stopped ones, and removes deleted ones.
# Only Herdr machines whose target starts with seqera-studio- are touched.

set -euo pipefail

api="${TOWER_API_ENDPOINT:-https://api.cloud.seqera.io}"
ssh_conf="${HERDR_STUDIOS_SSH_CONFIG:-$HOME/.ssh/seqera-studios.conf}"
op_ref='op://Employee/5m7bgfkukzaekmzo5ew2nwmeuq/credential'
alias_prefix=seqera-studio-

usage() {
  sed -n '2,10s/^# \{0,1\}//p' "$0" >&2
}

cmd=${1:-}
[[ -n $cmd ]] && shift || true
all_users=false include_stopped=false dry_run=false
for arg in "$@"; do
  case $arg in
    --all-users) all_users=true ;;
    --include-stopped) include_stopped=true ;;
    --dry-run) dry_run=true ;;
    -h | --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done

token="${TOWER_ACCESS_TOKEN:-${SEQERA_ACCESS_TOKEN:-}}"
[[ -n $token ]] || token=$(op read "$op_ref")

get() {
  curl -fsS -H "Authorization: Bearer $token" -H 'Accept: application/json' "$api$1"
}

# Emit one JSON object per SSH-enabled studio visible to the user, across all
# workspaces, tagged with workspace and owner info.
fetch_studios() {
  local me ws_json
  me=$(get /user-info | jq -r .user.id)
  ws_json=$(get "/user/$me/workspaces")
  jq -r '.orgsAndWorkspaces[] | select(.workspaceId != null) | .workspaceId' <<<"$ws_json" |
    while read -r ws; do
      local offset=0 page
      while :; do
        page=$(get "/studios?workspaceId=$ws&max=100&offset=$offset") || break
        jq -c --argjson me "$me" --argjson ws "$ws_json" '
          .studios[]?
          | select(.configuration.sshEnabled == true and .sshDetails != null)
          | . as $s
          | ($ws.orgsAndWorkspaces[] | select(.workspaceId == $s.workspaceId)) as $w
          | {
              alias: ("'"$alias_prefix"'a" + .sessionId),
              name, sessionId, status: .statusInfo.status,
              owner: .user.userName, mine: (.user.id == $me),
              workspace: ($w.orgName + "/" + $w.workspaceName),
              host: .sshDetails.host, port: .sshDetails.port, user: .sshDetails.user
            }' <<<"$page"
        (($(jq '.studios | length' <<<"$page") < 100)) && break
        offset=$((offset + 100))
      done
    done
}

studios=$(fetch_studios | jq -s --argjson all "$all_users" '
  map(select($all or .mine)) | sort_by(.workspace, .name)')

case $cmd in
  list)
    jq -r --argjson stopped "$include_stopped" '
      .[] | select($stopped or .status == "running")
      | [.alias, .status, .workspace, .owner, .name] | @tsv' <<<"$studios" |
      column -t -s $'\t'
    ;;

  sync)
    tmp=$(mktemp)
    {
      echo "# Generated by herdr-studios sync; do not edit."
      jq -r '.[] | "
# \(.name) (\(.workspace), owner \(.owner))
Host \(.alias)
    HostName \(.host)
    Port \(.port)
    User \(.user)
    ServerAliveInterval 30
    ServerAliveCountMax 3"' <<<"$studios"
    } >"$tmp"

    if $dry_run; then
      cat "$tmp"
      rm -f "$tmp"
    else
      mkdir -p "$(dirname "$ssh_conf")"
      mv "$tmp" "$ssh_conf"
      chmod 600 "$ssh_conf"
      # Include must precede the first Host block to apply globally.
      main="$HOME/.ssh/config"
      include="Include $ssh_conf"
      if ! grep -qxF "$include" "$main" 2>/dev/null; then
        awk -v inc="$include" '!done && /^Host / { print inc "\n"; done=1 } { print } END { if (!done) print inc }' \
          "$main" >"$main.tmp" && mv "$main.tmp" "$main" && chmod 600 "$main"
        echo "added '$include' to $main"
      fi
    fi

    run() {
      echo "+ $*"
      $dry_run && return
      "$@" || { echo "  failed: $*" >&2; return 1; }
    }

    # `machine add` only installs the remote server after an interactive
    # approval, so put the matching release binary where it looks first.
    version=$(herdr --version | awk '{print $2}')
    install_remote() {
      ssh -o BatchMode=yes "$1" "set -e
        [ \"\$(~/.local/bin/herdr --version 2>/dev/null)\" = 'herdr $version' ] && exit
        mkdir -p ~/.local/bin
        curl -fsSL -o ~/.local/bin/herdr.tmp \
          https://github.com/herdrdev/herdr/releases/download/v$version/herdr-linux-\$(uname -m)
        chmod +x ~/.local/bin/herdr.tmp
        mv ~/.local/bin/herdr.tmp ~/.local/bin/herdr"
    }

    # Remote discovery over the Connect proxy intermittently exits 255.
    add_machine() {
      local try
      for try in 1 2 3; do
        herdr machine add --label "$1" "$2" && return
        echo "  retrying ($try/3)" >&2
      done
      return 1
    }

    saved=$(herdr machine list --json)
    # Current studios: add, enable or disable.
    jq -c '.[]' <<<"$studios" | while read -r s; do
      alias=$(jq -r .alias <<<"$s")
      status=$(jq -r .status <<<"$s")
      label=$(jq -r .name <<<"$s")
      profile=$(jq -c --arg t "$alias" '[.[] | select(.target == $t)][0] // empty' <<<"$saved")
      if [[ -z $profile ]]; then
        if [[ $status == running ]]; then
          run install_remote "$alias" && run add_machine "$label" "$alias" || true
        fi
        continue
      fi
      id=$(jq -r .id <<<"$profile")
      enabled=$(jq -r '.enabled' <<<"$profile")
      if [[ $status == running && $enabled == false ]]; then
        run herdr machine enable "$id" || true
      elif [[ $status != running && $enabled == true ]]; then
        run herdr machine disable "$id" || true
      fi
    done

    # Saved studio machines whose studio no longer exists (or is filtered out).
    jq -r --argjson cur "$(jq '[.[].alias]' <<<"$studios")" --arg p "$alias_prefix" '
      .[] | .target as $t
      | select(($t | startswith($p)) and ($cur | index($t) | not))
      | .id' <<<"$saved" |
      while read -r id; do run herdr machine remove "$id" || true; done
    ;;

  *)
    usage
    exit 1
    ;;
esac
