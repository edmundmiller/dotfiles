#!/usr/bin/env bash
# herdr-studios: save SSH-enabled Seqera Studios as Herdr machines.
#
#   herdr-studios list [--all-users] [--include-stopped]
#   herdr-studios sync [--all-users] [--dry-run]
#
# sync writes one ssh Host alias per studio (seqera-studio-a<sessionId>) to
# ~/.ssh/seqera-studios.conf and adds running studios to Herdr.
# Saved machines are preserved, including stopped or filtered studios.

set -euo pipefail

api="${TOWER_API_ENDPOINT:-https://api.cloud.seqera.io}"
ssh_conf="${HERDR_STUDIOS_SSH_CONFIG:-$HOME/.ssh/seqera-studios.conf}"
op_ref='op://Employee/5m7bgfkukzaekmzo5ew2nwmeuq/credential'
alias_prefix=seqera-studio-

usage() {
  sed -n '2,10s/^# \{0,1\}//p' "$0" >&2
}

cmd=${1:-}
[[ -n $cmd ]] && shift || true
all_users=false include_stopped=false dry_run=false
for arg in "$@"; do
  case $arg in
    --all-users) all_users=true ;;
    --include-stopped) include_stopped=true ;;
    --dry-run) dry_run=true ;;
    -h | --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done

token="${TOWER_ACCESS_TOKEN:-${SEQERA_ACCESS_TOKEN:-}}"
[[ -n $token ]] || token=$(op read "$op_ref")

get() {
  # Pass the credential on stdin, not in process arguments or command logs.
  curl -fsS -H @- -H 'Accept: application/json' "$api$1" <<<"Authorization: Bearer $token"
}

# Emit one JSON object per SSH-enabled studio visible to the user, across all
# workspaces, tagged with workspace and owner info.
fetch_studios() {
  local me ws_json
  me=$(get /user-info | jq -er .user.id) || return
  ws_json=$(get "/user/$me/workspaces") || return
  jq -r '.orgsAndWorkspaces[] | select(.workspaceId != null) | .workspaceId' <<<"$ws_json" |
    while read -r ws; do
      local offset=0 page
      while :; do
        page=$(get "/studios?workspaceId=$ws&max=100&offset=$offset") || return
        jq -c --argjson me "$me" --argjson ws "$ws_json" '
          .studios[]?
          | select(.configuration.sshEnabled == true and .sshDetails != null)
          | . as $s
          | ($ws.orgsAndWorkspaces[] | select(.workspaceId == $s.workspaceId)) as $w
          | {
              alias: ("'"$alias_prefix"'a" + .sessionId),
              name, sessionId, status: .statusInfo.status,
              owner: .user.userName, mine: (.user.id == $me),
              workspace: ($w.orgName + "/" + $w.workspaceName),
              host: .sshDetails.host, port: .sshDetails.port, user: .sshDetails.user
            }' <<<"$page"
        (($(jq '.studios | length' <<<"$page") < 100)) && break
        offset=$((offset + 100))
      done
    done
}

studios=$(fetch_studios | jq -s --argjson all "$all_users" '
  map(select($all or .mine)) | sort_by(.workspace, .name)')

case $cmd in
  list)
    jq -r --argjson stopped "$include_stopped" '
      .[] | select($stopped or .status == "running")
      | [.alias, .status, .workspace, .owner, .name] | @tsv' <<<"$studios" |
      column -t -s $'\t'
    ;;

  sync)
    tmp=$(mktemp)
    {
      echo "# Generated by herdr-studios sync; do not edit."
      jq -r '.[] | "
# \(.name) (\(.workspace), owner \(.owner))
Host \(.alias)
    HostName \(.host)
    Port \(.port)
    User \(.user)
    ServerAliveInterval 30
    ServerAliveCountMax 3"' <<<"$studios"
    } >"$tmp"

    if [[ -f $ssh_conf ]]; then
      # Retain aliases outside this sync's visibility/ownership. Replace only
      # the exact single-alias blocks generated for currently visible studios.
      aliases=$(jq -r '[.[].alias] | join(" ")' <<<"$studios")
      preserved=$(mktemp)
      awk -v aliases="$aliases" '
        BEGIN { n=split(aliases, a, " "); for (i=1; i<=n; i++) managed[a[i]]=1 }
        tolower($1) == "host" || tolower($1) == "match" {
          skip=(tolower($1) == "host" && NF == 2 && $2 in managed)
        }
        !skip { print }
      ' "$ssh_conf" >"$preserved"
      printf '\n' >>"$preserved"
      cat "$tmp" >>"$preserved"
      mv "$preserved" "$tmp"
    fi

    if $dry_run; then
      cat "$tmp"
      rm -f "$tmp"
    else
      mkdir -p "$(dirname "$ssh_conf")"
      mv "$tmp" "$ssh_conf"
      chmod 600 "$ssh_conf"
      # Include must precede the first Host block to apply globally.
      main="$HOME/.ssh/config"
      include="Include $ssh_conf"
      if ! grep -qxF "$include" "$main" 2>/dev/null; then
        touch "$main"
        awk -v inc="$include" '!done && /^Host / { print inc "\n"; done=1 } { print } END { if (!done) print inc }' \
          "$main" >"$main.tmp" && mv "$main.tmp" "$main" && chmod 600 "$main"
        echo "added '$include' to $main"
      fi
    fi

    run() {
      echo "+ $*"
      $dry_run && return
      "$@" || { echo "  failed: $*" >&2; return 1; }
    }

    saved=$(hc machine ls --json)
    if ! jq -e '
      type == "object" and (.machines | type == "array") and
      all(.machines[]; (.name | type == "string") and (.target | type == "string"))
    ' <<<"$saved" >/dev/null; then
      echo 'herdr-studios: invalid hc machine ls response' >&2
      exit 1
    fi
    jq -c '.[]' <<<"$studios" | while read -r s; do
      alias=$(jq -r .alias <<<"$s")
      status=$(jq -r .status <<<"$s")
      if [[ $status != running ]]; then
        echo "skipped $alias ($status); saved machines preserved"
        continue
      fi
      # Never replace a registered profile, including a name collision.
      if jq -e --arg a "$alias" 'any(.machines[]; .name == $a or .target == $a)' <<<"$saved" >/dev/null; then
        echo "preserved $alias (already registered)"
      else
        run hc machine add --install --name "$alias" "$alias"
      fi
    done
    jq -r --argjson cur "$(jq '[.[].alias]' <<<"$studios")" --arg p "$alias_prefix" '
      .machines[] | .target as $t
      | select((($t | startswith($p)) or (.name | startswith($p))) and ($cur | index($t) | not))
      | "skipped \(.name) (deleted, filtered, or not visible); saved machine preserved"
    ' <<<"$saved"
    ;;

  *)
    usage
    exit 1
    ;;
esac
