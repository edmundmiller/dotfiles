#!/usr/bin/env bash

invalid=0
for path in "$@"; do
  if [[ ! "$path" =~ ^(packages|overlays)/[^/]+/patches/[^/]+\.patch$ ]] &&
    [[ ! "$path" =~ ^skills/overlays/[^/]+/[^/]+\.patch$ ]]; then
    echo "Patch must live at packages/<name>/patches/*.patch, overlays/<name>/patches/*.patch, or skills/overlays/<name>/*.patch: $path" >&2
    invalid=1
  fi
done
exit "$invalid"
