#!/usr/bin/env bash
set -euo pipefail

if (($#)); then
  commits="$(git rev-list "$@")"
elif [[ -n "${PRE_COMMIT_TO_REF:-}" ]]; then
  zero_ref="0000000000000000000000000000000000000000"
  if [[ "${PRE_COMMIT_TO_REF}" == "${zero_ref}" ]]; then
    exit 0
  elif [[ -n "${PRE_COMMIT_FROM_REF:-}" && "${PRE_COMMIT_FROM_REF}" != "${zero_ref}" ]]; then
    commits="$(git rev-list "${PRE_COMMIT_FROM_REF}..${PRE_COMMIT_TO_REF}")"
  else
    commits="$(git rev-list "${PRE_COMMIT_TO_REF}" --not --remotes)"
  fi
else
  commits="$(git rev-list HEAD --not --remotes)"
fi

while IFS= read -r commit; do
  [[ -n "${commit}" ]] || continue
  identity="$(git show -s --format='%an <%ae>%n%cn <%ce>' "${commit}")"
  if grep -Eiq '(^|[<[:space:]])test user([>[:space:]]|$)|<test(@|\+)[^>]*>|<test@example\.com>' <<<"${identity}"; then
    printf 'check-commit-identity: refusing commit %s with forbidden identity:\n%s\n' \
      "${commit}" "${identity}" >&2
    exit 1
  fi
done <<<"${commits}"
