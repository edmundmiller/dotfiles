#!/usr/bin/env bash
# scratchpad: open a persistent Neovim note
# Usage: scratchpad [file]

set -euo pipefail

vault_dir="${OBSIDIAN_VAULT_DIR:-$HOME/obsidian-vault}"
note="${1:-$vault_dir/00_Inbox/scratchpad.md}"

mkdir -p "$(dirname "$note")"

if [ ! -f "$note" ]; then
  printf '# Scratchpad\n\n' > "$note"
fi

exec nvim "$note"
