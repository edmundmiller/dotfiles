#!/bin/bash
set -euo pipefail

vault_dir="${OBSIDIAN_VAULT_DIR:-$HOME/obsidian-vault}"
daily_dir="$vault_dir/00_Inbox/Daily"
note_date="$(date +%Y-%m-%d)"
note_path="$daily_dir/$note_date.md"

mkdir -p "$daily_dir"

# Create with template if it doesn't exist yet
if [ ! -f "$note_path" ]; then
  cat > "$note_path" <<EOF
# ${note_date}

## Tasks

## Notes

EOF
fi

exec nvim "$note_path"
