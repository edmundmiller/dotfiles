#!/usr/bin/env bash
set -euo pipefail

# Run this checkout's package without changing the caller's task directory.
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Keep Nix's signal changes in a child, outside the eventual task process.
output=$(nix build --no-link --print-out-paths --no-write-lock-file "$root#hey")
exec "$output/bin/hey" "$@"
